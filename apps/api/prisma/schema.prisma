model GatewayUsageEvidenceContractRolloutControl {
  id            Int      @id
  mode          String
  revision      Int
  changeTicket  String   @map("change_ticket")
  approverOne   String   @map("approver_one")
  approverTwo   String   @map("approver_two")
  changedAt     DateTime @map("changed_at")

  @@map("gateway_usage_evidence_contract_rollout_control")
}

model GatewayProducerBuildAuthorizationEvent {
  id                    String   @id
  producerBuildSha      String   @map("producer_build_sha")
  revision              Int
  decision              String
  effectiveAt           DateTime @map("effective_at")
  changeTicket          String   @map("change_ticket")
  approverOne           String   @map("approver_one")
  approverTwo           String   @map("approver_two")
  previousAuthorityHash String?  @map("previous_authority_hash")
  authorityHash         String   @unique @map("authority_hash")
