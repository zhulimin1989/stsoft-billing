  outputTokens      Int?         @map("output_tokens")
  totalTokens       Int?         @map("total_tokens")
  requestId         String?      @map("request_id")
  quotaAfter        Int          @default(0) @map("quota_after") // 操作后套餐积分
  bonusAfter        Int          @default(0) @map("bonus_after") // 操作后加油包积分
  balanceVersion    BigInt?      @map("balance_version") // quota/bonus 权威余额版本；历史及 GRANT 池流水可为空
  idempotencyKey    String?      @unique @map("idempotency_key") // Phase 3.2 Unit C — 语义幂等键 (invoiceId+subscriptionId 组合等)
  // v2 P1 / PR5 (additive, all nullable / default-friendly):
  // GRANT 类流水可携带过期时间 + 关联 CreditGrantRule。CONSUME / EXPIRE 类流水
  // 通过新增的 EXPIRE 枚举(下方 CreditTxType)表达冲销。`isExpired` 仅用于
  // 标记 GRANT 行已被过期 sweep 处理，避免重复反向。本 PR 不修改 CreditService
  // 现有扣减路径，详见 PR5 description "DEFERRED" 段落。
  expiresAt         DateTime?    @map("expires_at")
  grantRuleId       String?      @map("grant_rule_id")
  isExpired         Boolean      @default(false) @map("is_expired")
  createdAt         DateTime     @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  tenant  Tenant?  @relation(fields: [tenantId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@index([productId])
  @@index([subscriptionId])
  @@index([type])
  @@index([createdAt])
  @@index([createdAt, id], map: "credit_transactions_created_at_id_idx")
  @@index([userId, createdAt, id], map: "credit_transactions_user_created_id_idx")
  @@index([tenantId, createdAt, id], map: "credit_transactions_tenant_created_id_idx")
  // Raw migration 20260813000101 owns a partial request_id index
  // (`WHERE request_id IS NOT NULL`). Prisma cannot model its predicate; keep
  // it migration-governed instead of declaring a misleading full index here.
  @@index([productId, createdAt])
  @@index([userId, expiresAt, isExpired])
  @@index([grantRuleId])
  // P2-A3 §8.1 用量阈值查询 hot path：UsageThresholdService 高 QPS 按
  // (userId, createdAt >= startOfDay/oneHourAgo) 聚合，复合索引避免全表扫描。
  @@index([userId, createdAt])
  // quota-v2 §4.2 滚动窗口聚合 hot path：windowUsage 按 (subscriptionId, type='CONSUME', createdAt>=since)
  // 做 SUM(creditsAmount)/COUNT(*)，复合索引避免逐请求全表扫描。
  @@index([subscriptionId, type, createdAt])
  @@map("credit_transactions")
}

// quota/bonus 的权威余额状态。subscriptionId 同时可能指向传统订阅周期或
// CodingPlanEntitlement，因此这里刻意不建立到某一种订阅表的外键。
model CreditBalanceState {
  subscriptionId String   @id @map("subscription_id")
  userId         String   @map("user_id") // 作用域 owner；消费 actor 记录在 CreditTransaction.userId
  quota          Int      @default(0)
  bonus          Int      @default(0)
  version        BigInt   @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  outboxEvents CreditBalanceOutbox[]
  gatewayUsageSettlementAnchors GatewayUsageSettlementAnchor[]

  @@index([userId])
  @@map("credit_balance_states")
}

enum CreditBalanceOutboxStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  MANUAL_REVIEW
}

// 与 CreditBalanceState/CreditTransaction 同事务提交。Redis 更新失败或进程在
// commit 后退出时，由 worker 重放；版本化 CAS 保证乱序重放不会覆盖新余额。
model CreditBalanceOutbox {
  id             String                    @id @default(uuid())
  subscriptionId String                    @map("subscription_id")
  version        BigInt
  quota          Int
  bonus          Int
  status         CreditBalanceOutboxStatus @default(PENDING)
  attempts       Int                       @default(0)
  maxAttempts    Int                       @default(12) @map("max_attempts") // 告警阈值；普通传输故障仍持续重试
  nextRunAt      DateTime                  @default(now()) @map("next_run_at")
  lockedAt       DateTime?                 @map("locked_at")
  lockedBy       String?                   @map("locked_by")
  lastError      String?                   @map("last_error")
  processedAt    DateTime?                 @map("processed_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  balanceState CreditBalanceState @relation(fields: [subscriptionId], references: [subscriptionId], onDelete: Restrict)

  @@unique([subscriptionId, version])
  @@index([status, nextRunAt])
  @@index([status, lockedAt])
  @@map("credit_balance_outbox")
}

enum CreditTxType {
  QUOTA_GRANT // 套餐月度发放
  QUOTA_RESET // 月度重置（清零）
  BONUS_PURCHASE // 加油包购买
  CONSUME // 消耗
  REFUND // 退款回退
  GRANT // v2 P1 / PR5 — 定时奖励发放(可带过期)
  EXPIRE // v2 P1 / PR5 — 过期反向冲销
}

model BalanceTransaction {
  id               String          @id @default(uuid())
  operationKey     String?         @unique @map("operation_key")
  userId           String          @map("user_id")
  tenantId         String          @map("tenant_id")
  billingAccountId String?         @map("billing_account_id")
  type             TransactionType
  amountUsd        Decimal         @map("amount_usd") @db.Decimal(20, 12)
  balanceAfterUsd  Decimal         @map("balance_after_usd") @db.Decimal(20, 12)
  description      String          @default("")
  orderId          String?         @map("order_id")
  productId        String?         @map("product_id")
  tokenUsageId     String?         @unique @map("token_usage_id")
  ledgerSequence   BigInt?         @map("ledger_sequence")
  createdAt        DateTime        @default(now()) @map("created_at")

  user                   User                           @relation(fields: [userId], references: [id])
  tenant                 Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  billingAccount         BillingAccount?                @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  product                Product?                       @relation(fields: [productId], references: [id], onDelete: SetNull)
  tokenUsage             TokenUsage?                    @relation(fields: [tokenUsageId], references: [id], onDelete: SetNull)
  consumptionAllocations BalanceConsumptionAllocation[]
  creditSettlements      EnterpriseCreditSettlement[]
  grantExpiryAudit       BalanceGrantExpiry?
  grantRefundAudit       BalanceGrantRefund?
  ledgerRepairs          BalanceLedgerTransactionRepair[]
  outgoingLedgerTransferRepair BalanceLedgerAccountTransferRepair? @relation("BalanceLedgerTransferOutTransaction")
  incomingLedgerTransferRepair BalanceLedgerAccountTransferRepair? @relation("BalanceLedgerTransferInTransaction")
  transferGrantFundingRepair    BalanceLedgerAccountTransferGrant? @relation("BalanceLedgerTransferGrantFunding")
  ledgerGrantCreationRepair     BalanceLedgerGrantCreationRepair?
  personalDebtAllocationRepair  BalanceLedgerPersonalDebtAllocationRepair?
  voucherFundingRepair          BalanceLedgerVoucherFundingRepair?
  legacyExpiryRepair            BalanceLedgerLegacyExpiryRepair?
  ledgerAdminFundingRepair      BalanceLedgerAdminFundingRepair?
  attribution                   BalanceTransactionAttribution?

  @@index([userId])
  @@index([tenantId])
  @@index([billingAccountId])
  @@index([billingAccountId, createdAt])
  @@index([billingAccountId, type, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([productId])
  @@index([type])
  @@index([createdAt, id], map: "balance_transactions_created_at_id_idx")
  @@index([userId, createdAt, id], map: "balance_transactions_user_created_id_idx")
  @@index([billingAccountId, createdAt, id], map: "balance_transactions_account_created_id_idx")
  @@index([tenantId, createdAt, id], map: "balance_transactions_tenant_created_id_idx")
  @@unique([billingAccountId, ledgerSequence], map: "balance_transactions_account_ledger_sequence_key")
  @@map("balance_transactions")
}

enum TransactionType {
  RECHARGE
  CONSUME
  ADJUST
  REFUND
}

enum BalanceTransactionAttributionSource {
  ADMIN_BALANCE_ADJUSTMENT
}

model BalanceTransactionAttribution {
  transactionId  String                              @id @map("transaction_id")
  balanceGrantId String?                             @unique(map: "balance_transaction_attributions_grant_key") @map("balance_grant_id")
  billingMode    ProductBillingMode                  @map("billing_mode")
  source         BalanceTransactionAttributionSource
  createdAt      DateTime                            @default(now()) @map("created_at")

  transaction  BalanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_transaction_attributions_transaction_fkey")
  balanceGrant BalanceGrant?      @relation(fields: [balanceGrantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_transaction_attributions_grant_fkey")

  @@index([billingMode, source, transactionId], map: "balance_transaction_attributions_mode_source_transaction_idx")
  @@map("balance_transaction_attributions")
}

model BalanceGrant {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  tenantId           String    @map("tenant_id")
  billingAccountId   String?   @map("billing_account_id")
  orderId            String?   @unique @map("order_id")
  productId          String?   @map("product_id")
  source             String    @default("RECHARGE")
  paidAmountUsd      Decimal   @map("paid_amount_usd") @db.Decimal(20, 12)
  bonusAmountUsd     Decimal   @default(0) @map("bonus_amount_usd") @db.Decimal(20, 12)
  grantedAmountUsd   Decimal   @map("granted_amount_usd") @db.Decimal(20, 12)
  remainingAmountUsd Decimal   @map("remaining_amount_usd") @db.Decimal(20, 12)
  // Expand/contract rollout: nullable until every old writer is retired and the
  // component audit/backfill has completed. New code always writes both fields.
  remainingPaidAmountUsd  Decimal?  @map("remaining_paid_amount_usd") @db.Decimal(20, 12)
  remainingBonusAmountUsd Decimal?  @map("remaining_bonus_amount_usd") @db.Decimal(20, 12)
  discountRate       Decimal   @default(1) @map("discount_rate") @db.Decimal(20, 12)
  validFrom          DateTime  @default(now()) @map("valid_from")
  expiresAt          DateTime? @map("expires_at")
  isExpired          Boolean   @default(false) @map("is_expired")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user           User                           @relation(fields: [userId], references: [id])
  tenant         Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  billingAccount BillingAccount?                @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  order          Order?                         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  product        Product?                       @relation(fields: [productId], references: [id], onDelete: SetNull)
  allocations    BalanceConsumptionAllocation[]
  debtSettlements   EnterpriseCreditSettlement[]
  expiryAudit       BalanceGrantExpiry?
  targetRefunds     BalanceGrantRefund[]           @relation("BalanceGrantRefundTarget")
  refundAllocations BalanceGrantRefundAllocation[]
  ledgerTransferRepair BalanceLedgerAccountTransferGrant?
  ledgerComponentRepairs BalanceLedgerGrantComponentRepair[]
  voucherFundingRepair  BalanceLedgerVoucherFundingRepair?
  legacyExpiryRepair    BalanceLedgerLegacyExpiryRepair?
  gatewayFundingHolds    GatewayUsageFundingReservationGrant[]
  attribution            BalanceTransactionAttribution?

  @@index([userId])
  @@index([tenantId])
  @@index([billingAccountId])
  @@index([billingAccountId, productId])
  @@index([billingAccountId, expiresAt])
  @@index([tenantId, productId])
  @@index([tenantId, expiresAt])
  @@index([productId])
  @@index([expiresAt])
  @@index([createdAt, id], map: "balance_grants_created_at_id_idx")
  @@index([userId, createdAt, id], map: "balance_grants_user_created_id_idx")
  @@index([billingAccountId, createdAt, id], map: "balance_grants_account_created_id_idx")
  @@index([tenantId, createdAt, id], map: "balance_grants_tenant_created_id_idx")
  @@map("balance_grants")
}

// 批次过期的不可变审计。nominal 是批次名义归零额，walletDebit 是真实钱包扣减，
// unbacked 是历史批次/钱包漂移的冲销额；只有 walletDebit 写 BalanceTransaction。
model BalanceGrantExpiry {
  id                     String   @id @default(uuid())
  balanceGrantId         String   @unique @map("balance_grant_id")
  billingAccountId       String   @map("billing_account_id")
  balanceTransactionId   String?  @unique @map("balance_transaction_id")
  nominalAmountUsd       Decimal  @map("nominal_amount_usd") @db.Decimal(20, 12)
  nominalPaidUsd         Decimal  @map("nominal_paid_usd") @db.Decimal(20, 12)
  nominalBonusUsd        Decimal  @map("nominal_bonus_usd") @db.Decimal(20, 12)
  walletDebitUsd         Decimal  @map("wallet_debit_usd") @db.Decimal(20, 12)
  walletDebitPaidUsd     Decimal  @map("wallet_debit_paid_usd") @db.Decimal(20, 12)
  walletDebitBonusUsd    Decimal  @map("wallet_debit_bonus_usd") @db.Decimal(20, 12)
  unbackedAmountUsd      Decimal  @map("unbacked_amount_usd") @db.Decimal(20, 12)
  unbackedPaidUsd        Decimal  @map("unbacked_paid_usd") @db.Decimal(20, 12)
  unbackedBonusUsd       Decimal  @map("unbacked_bonus_usd") @db.Decimal(20, 12)
  walletBalanceBeforeUsd Decimal  @map("wallet_balance_before_usd") @db.Decimal(20, 12)
  walletBalanceAfterUsd  Decimal  @map("wallet_balance_after_usd") @db.Decimal(20, 12)
  createdAt              DateTime @default(now()) @map("created_at")

  balanceGrant       BalanceGrant        @relation(fields: [balanceGrantId], references: [id], onDelete: Restrict)
  billingAccount     BillingAccount      @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  balanceTransaction BalanceTransaction? @relation(fields: [balanceTransactionId], references: [id], onDelete: Restrict)
  legacyRepair       BalanceLedgerLegacyExpiryRepair?

  @@index([billingAccountId, createdAt], map: "balance_grant_expiries_account_created_idx")
  @@map("balance_grant_expiries")
}

// 充值退款的不可变事实。退款先核销目标批次尚未使用的同类 component；
// 已消费部分形成一笔新的余额欠款，再由其他有效批次净额承接，剩余部分保持
// open debt。这样不改写历史 settlement，同时始终维持 wallet = grants - debt。
model BalanceGrantRefund {
  id                           String   @id @default(uuid())
  billingAccountId             String   @map("billing_account_id")
  balanceGrantId               String   @map("balance_grant_id")
  refundTransactionId          String   @unique @map("refund_transaction_id")
  debtAllocationId             String?  @unique @map("debt_allocation_id")
  operationKey                 String   @unique @map("operation_key")
  component                    String
  requestedAmountUsd           Decimal  @map("requested_amount_usd") @db.Decimal(20, 12)
  targetGrantReductionUsd      Decimal  @map("target_grant_reduction_usd") @db.Decimal(20, 12)
  debtOpenedUsd                Decimal  @map("debt_opened_usd") @db.Decimal(20, 12)
  debtNettedUsd                Decimal  @map("debt_netted_usd") @db.Decimal(20, 12)
  openDebtUsd                  Decimal  @map("open_debt_usd") @db.Decimal(20, 12)
  recognizedRevenueReversalUsd Decimal  @map("recognized_revenue_reversal_usd") @db.Decimal(20, 12)
  bonusConsumedReversalUsd     Decimal  @map("bonus_consumed_reversal_usd") @db.Decimal(20, 12)
  occurredAt                   DateTime @map("occurred_at")
  createdAt                    DateTime @default(now()) @map("created_at")

  billingAccount    BillingAccount                 @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  balanceGrant      BalanceGrant                   @relation("BalanceGrantRefundTarget", fields: [balanceGrantId], references: [id], onDelete: Restrict)
  refundTransaction BalanceTransaction             @relation(fields: [refundTransactionId], references: [id], onDelete: Restrict)
  debtAllocation    BalanceConsumptionAllocation?  @relation(fields: [debtAllocationId], references: [id], onDelete: Restrict)
  allocations       BalanceGrantRefundAllocation[]

  @@index([billingAccountId, occurredAt], map: "balance_grant_refunds_account_occurred_idx")
  @@index([balanceGrantId], map: "balance_grant_refunds_grant_idx")
  @@map("balance_grant_refunds")
}

model BalanceGrantRefundAllocation {
  id                String  @id @default(uuid())
  refundId          String  @map("refund_id")
  balanceGrantId    String  @map("balance_grant_id")
  sequence          Int
  role              String
  amountUsd         Decimal @map("amount_usd") @db.Decimal(20, 12)
  paidReductionUsd  Decimal @map("paid_reduction_usd") @db.Decimal(20, 12)
  bonusReductionUsd Decimal @map("bonus_reduction_usd") @db.Decimal(20, 12)

  refund       BalanceGrantRefund @relation(fields: [refundId], references: [id], onDelete: Restrict)
  balanceGrant BalanceGrant       @relation(fields: [balanceGrantId], references: [id], onDelete: Restrict)

  @@unique([refundId, balanceGrantId, role], map: "balance_grant_refund_allocations_refund_grant_role_key")
  @@unique([refundId, sequence], map: "balance_grant_refund_allocations_refund_sequence_key")
  @@index([balanceGrantId], map: "balance_grant_refund_allocations_grant_idx")
  @@map("balance_grant_refund_allocations")
}

model BalanceConsumptionAllocation {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  tenantId             String   @map("tenant_id")
  billingAccountId     String?  @map("billing_account_id")
  productId            String?  @map("product_id")
  balanceTransactionId String   @map("balance_transaction_id")
  tokenUsageId         String?  @map("token_usage_id")
  balanceGrantId       String?  @map("balance_grant_id")
  source               String   @default("BALANCE_GRANT")
  amountUsd            Decimal  @map("amount_usd") @db.Decimal(20, 12)
  recognizedRevenueUsd Decimal  @map("recognized_revenue_usd") @db.Decimal(20, 12)
  bonusConsumedUsd     Decimal  @map("bonus_consumed_usd") @db.Decimal(20, 12)
  discountRate         Decimal  @map("discount_rate") @db.Decimal(20, 12)
  // Per-consumption funding classification. Historical rows remain incomplete;
  // online writes freeze whether this charge used approved enterprise credit
  // or created immediate, unapproved debt.
  approvedCreditUsd             Decimal   @default(0) @map("approved_credit_usd") @db.Decimal(20, 12)
  unapprovedDebtUsd             Decimal   @default(0) @map("unapproved_debt_usd") @db.Decimal(20, 12)
  fundingClassificationComplete Boolean   @default(false) @map("funding_classification_complete")
  // 欠款核销累计（source=ENTERPRISE_CREDIT / NEGATIVE_BALANCE）：settledUsd 追平 amountUsd 时写 settledAt。
  settledUsd           Decimal   @default(0) @map("settled_usd") @db.Decimal(20, 12)
  settledAt            DateTime? @map("settled_at")
  // Frozen enterprise-credit policy for delayed settlement and overdue checks.
  // Historical rows remain incomplete and continue through the legacy path.
  creditPolicyAt                DateTime? @map("credit_policy_at")
  creditTermsDays               Int?      @map("credit_terms_days")
  creditDueAt                   DateTime? @map("credit_due_at")
  creditPolicySnapshotComplete  Boolean   @default(false) @map("credit_policy_snapshot_complete")
  // BEFORE INSERT 触发器无条件覆盖调用方输入并由数据库序列分配。所有在线
  // INSERT 都发生在钱包行锁之后，因此该值表达真实账本顺序，而不是
  // PostgreSQL transaction-start now()。
  // 历史行保持 NULL，由受审计的 reconciliation 以账户内负数序号回填。
  ledgerSequence       BigInt?   @default(dbgenerated("nextval('balance_consumption_allocation_ledger_seq'::regclass)")) @map("ledger_sequence")
  createdAt            DateTime @default(now()) @map("created_at")

  user               User               @relation(fields: [userId], references: [id])
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  billingAccount     BillingAccount?    @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  product            Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  balanceTransaction BalanceTransaction           @relation(fields: [balanceTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenUsage         TokenUsage?        @relation(fields: [tokenUsageId], references: [id], onDelete: SetNull)
  balanceGrant       BalanceGrant?      @relation(fields: [balanceGrantId], references: [id], onDelete: Restrict)
  settlements        EnterpriseCreditSettlement[]
  refundDebtAudit    BalanceGrantRefund?
  ledgerRepairs      BalanceLedgerAllocationRepair[]
  grantRetirementRepairs BalanceLedgerGrantRetirementRepair[]
  personalDebtRepairSource BalanceLedgerPersonalDebtAllocationRepair?

  @@unique([billingAccountId, ledgerSequence], map: "balance_consumption_allocations_account_ledger_sequence_key")
  @@index([userId])
  @@index([tenantId])
  @@index([billingAccountId])
  @@index([billingAccountId, createdAt])
  @@index([billingAccountId, source, createdAt], map: "balance_consumption_allocations_account_source_created_idx")
  @@index([billingAccountId, source, settledAt, creditPolicySnapshotComplete, creditDueAt], map: "balance_consumption_allocations_credit_due_idx")
  @@index([tenantId, createdAt])
  @@index([productId])
  @@index([balanceTransactionId])
  @@index([tokenUsageId])
  @@index([balanceGrantId])
  @@index([source])
  @@index([createdAt, id], map: "balance_consumption_allocations_created_at_id_idx")
  @@index([userId, createdAt, id], map: "balance_allocations_user_created_id_idx")
  @@index([billingAccountId, createdAt, id], map: "balance_allocations_account_created_id_idx")
  @@index([tenantId, createdAt, id], map: "balance_allocations_tenant_created_id_idx")
  @@map("balance_consumption_allocations")
}

// 余额欠款核销明细（沿用历史表名）：一笔注资按 FIFO 冲抵未核销的
// ENTERPRISE_CREDIT / NEGATIVE_BALANCE 消费分摊。
// amountUsd = paidUsd + bonusUsd；确认收入只计实付部分，赠送部分计 bonusConsumedUsd。
// balanceGrantId 记录本次注资对应且被填坑金额压缩可用余额的充值/赠送批次。
model EnterpriseCreditSettlement {
  id                     String   @id @default(uuid())
  billingAccountId       String   @map("billing_account_id")
  allocationId           String   @map("allocation_id")
  repaymentTransactionId String?  @map("repayment_transaction_id")
  balanceGrantId         String?  @map("balance_grant_id")
  debtSource             String   @default("ENTERPRISE_CREDIT") @map("debt_source")
  repairRunId            String?  @map("repair_run_id")
  operationKey           String?  @unique @map("operation_key")
  trigger                String   @default("FUNDING")
  amountUsd              Decimal  @map("amount_usd") @db.Decimal(20, 12)
  paidUsd                Decimal  @default(0) @map("paid_usd") @db.Decimal(20, 12)
  bonusUsd               Decimal  @default(0) @map("bonus_usd") @db.Decimal(20, 12)
  // 财务归期使用 occurredAt；createdAt 保留真实写入/回填时间。
  occurredAt             DateTime @default(now()) @map("occurred_at")
  createdAt              DateTime @default(now()) @map("created_at")

  billingAccount       BillingAccount               @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  allocation           BalanceConsumptionAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  repaymentTransaction BalanceTransaction?          @relation(fields: [repaymentTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  balanceGrant         BalanceGrant?                @relation(fields: [balanceGrantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  repairRun            BalanceLedgerRepairRun?      @relation(fields: [repairRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([billingAccountId, createdAt], map: "enterprise_credit_settlements_account_created_idx")
  @@index([allocationId], map: "enterprise_credit_settlements_allocation_idx")
  @@index([repaymentTransactionId], map: "enterprise_credit_settlements_repayment_tx_idx")
  @@index([balanceGrantId], map: "enterprise_credit_settlements_balance_grant_idx")
  @@index([repairRunId], map: "enterprise_credit_settlements_repair_run_idx")
  @@index([billingAccountId, debtSource, createdAt], map: "enterprise_credit_settlements_account_source_created_idx")
  @@index([occurredAt, id], map: "enterprise_credit_settlements_occurred_id_idx")
  @@map("enterprise_credit_settlements")
}

/// 待核销欠款队列:已入账(钱包已加钱)但尚未核销到具体 allocation 行的金额。
/// 唯一目的是解开「核销行数被充值金额绑死」——欠款按每次 API 调用逐行分摊,
/// 大额充值要核销的行数正比于金额,而逐行核销有 ≈1ms/行 的物理成本
/// (3 个 BEFORE FOR EACH ROW 守卫 + settled_at 在 2 个索引里导致无法 HOT update)。
/// 国内 prod 实测(2026-09-20):某企业账户 293,309 行未结、欠 26,176.89,
/// 全额核销需 ≈302 秒,而交互事务预算只有 60 秒 ⇒ 大额充值 100% 超时回滚、永远充不进去。
///
/// 不变量:Σ(未结欠款) - Σ(pending.remaining) = max(0, -wallet)
/// 亦即 pending 恰好记录「钱已到账、债还没销」的差额。
///
/// 与 gateway_usage_unreserved_queue 不同,这张表由**应用在同一事务内**维护,
/// 不是 DB 触发器:pending 的产生取决于应用侧的事务预算水位判断,触发器看不到这个上下文。
/// 两个写入点都必须与 allocation 的变更同事务,不变量才是原子的:
///   - 充值:wallet += amount,同步核销至预算水位,剩余额度写入本表
///   - worker:核销 allocation 行,同步递减 remaining,归零即删行
/// 守恒由 assertReconciledBalanceLedgerSnapshot 的三项式在每次资金操作前后校验;
/// 未加账户级 DB 守恒触发器是故意的 —— 那需要聚合该账户全部 allocation,
/// 在一次核销 20 万行的事务里会把成本重新放大回 O(N)。
///
/// 小额充值在预算内同步核销完毕,不会产生本表记录 ⇒ 既有路径行为逐字节不变。
model BalanceDebtSettlementPending {
  id                     String   @id @default(uuid())
  billingAccountId       String   @map("billing_account_id")
  allocationSource       String   @map("allocation_source")
  /// worker 复用原充值 transaction 写 settlement 行。守恒触发器
  /// assert_balance_debt_allocation_settlement_conservation 对 trigger='FUNDING' 要求:
  /// repayment_transaction_id 非空、其 type ∈ (RECHARGE, ADJUST) 且 amount_usd > 0,
  /// 且 settlement.occurred_at 必须严格等于该 transaction 的 created_at ——
  /// 所以 occurredAt 在此固化,worker 不得改用自己的时钟。
  repaymentTransactionId String   @map("repayment_transaction_id")
  balanceGrantId         String?  @map("balance_grant_id")
  remainingPaidUsd       Decimal  @map("remaining_paid_usd") @db.Decimal(20, 12)
  remainingBonusUsd      Decimal  @map("remaining_bonus_usd") @db.Decimal(20, 12)
  occurredAt             DateTime @map("occurred_at")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([billingAccountId, allocationSource], map: "balance_debt_settlement_pending_account_source_idx")
  @@index([createdAt, id], map: "balance_debt_settlement_pending_fifo_idx")
  @@map("balance_debt_settlement_pending")
}


// 历史账本回放审计。dry-run 计划写 JSONL；真正 apply 时每个账户在独立事务内
// 记录前置 hash、修复前后快照和结果，支持幂等重跑与人工复核。
model BalanceLedgerRepairRun {
  id          String    @id @default(uuid())
  status      String    @default("RUNNING")
  planHash    String    @map("plan_hash")
  initiatedBy String?   @map("initiated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  accounts    BalanceLedgerRepairAccount[]
  settlements EnterpriseCreditSettlement[]
  allocationRepairs BalanceLedgerAllocationRepair[]
  transactionRepairs BalanceLedgerTransactionRepair[]
  grantComponentRepairs BalanceLedgerGrantComponentRepair[]
  grantRetirementRepairs BalanceLedgerGrantRetirementRepair[]
  personalDebtAllocationRepairs BalanceLedgerPersonalDebtAllocationRepair[]
  voucherFundingRepairs BalanceLedgerVoucherFundingRepair[]
  accountTransferRepairs BalanceLedgerAccountTransferRepair[]
  grantCreationRepairs BalanceLedgerGrantCreationRepair[]
  legacyExpiryRepairs BalanceLedgerLegacyExpiryRepair[]
  invoiceStabilityRepairs BalanceLedgerInvoiceStabilityRepair[]
  adminFundingRepairs BalanceLedgerAdminFundingRepair[]

  @@map("balance_ledger_repair_runs")
}

model BalanceLedgerRepairAccount {
  id               String   @id @default(uuid())
  runId            String   @map("run_id")
  billingAccountId String   @map("billing_account_id")
  status           String
  preconditionHash String   @map("precondition_hash")
  replayHash       String?  @map("replay_hash")
  beforeSnapshot   Json     @map("before_snapshot")
  afterSnapshot    Json?    @map("after_snapshot")
  error            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  run            BalanceLedgerRepairRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  billingAccount BillingAccount         @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  allocationRepairs BalanceLedgerAllocationRepair[]
  transactionRepairs BalanceLedgerTransactionRepair[]
  grantComponentRepairs BalanceLedgerGrantComponentRepair[]
  grantRetirementRepairs BalanceLedgerGrantRetirementRepair[]
  personalDebtAllocationRepairs BalanceLedgerPersonalDebtAllocationRepair[]
  voucherFundingRepairs BalanceLedgerVoucherFundingRepair[]
  outgoingTransferRepairs BalanceLedgerAccountTransferRepair[] @relation("BalanceLedgerTransferSourceRepairAccount")
  incomingTransferRepairs BalanceLedgerAccountTransferRepair[] @relation("BalanceLedgerTransferTargetRepairAccount")
  grantCreationRepairs BalanceLedgerGrantCreationRepair[]
  legacyExpiryRepairs BalanceLedgerLegacyExpiryRepair[]
  invoiceStabilityRepairs BalanceLedgerInvoiceStabilityRepair[]
  adminFundingRepairs BalanceLedgerAdminFundingRepair[]

  @@unique([runId, billingAccountId], map: "balance_ledger_repair_accounts_run_account_key")
  @@index([billingAccountId, createdAt], map: "balance_ledger_repair_accounts_account_created_idx")
  @@map("balance_ledger_repair_accounts")
}

// 逐行记录 reconciliation 对历史消费分摊的完整 before/after。数据库触发器
// 要求该审计先于受保护 UPDATE 存在，并与 OLD/NEW 的 to_jsonb 快照完全相等。
model BalanceLedgerAllocationRepair {
  id               String   @id @default(uuid())
  operationKey     String   @unique @map("operation_key")
  runId            String   @map("run_id")
  repairAccountId  String   @map("repair_account_id")
  billingAccountId String   @map("billing_account_id")
  allocationId     String   @map("allocation_id")
  beforeSnapshot   Json     @map("before_snapshot")
  afterSnapshot    Json     @map("after_snapshot")
  createdAt        DateTime @default(now()) @map("created_at")

  run            BalanceLedgerRepairRun     @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  repairAccount  BalanceLedgerRepairAccount @relation(fields: [repairAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  billingAccount BillingAccount             @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  allocation     BalanceConsumptionAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([runId, allocationId], map: "balance_ledger_allocation_repairs_run_allocation_key")
  @@index([billingAccountId, createdAt], map: "balance_ledger_allocation_repairs_account_created_idx")
  @@map("balance_ledger_allocation_repairs")
}

// pre-V2 MIGRATION_OPENING 是旧消费 writer 在余额不足时创建的伪充值批次。
// 只有完整证明该批次恰好对应消费的负余额部分后，repair 才能把分摊改为
// NEGATIVE_BALANCE 并退休该伪批次。grantId 故意不建 FK：审计必须在删除前
// 落库，并永久保存数据库原始行快照。
model BalanceLedgerGrantRetirementRepair {
  id               String   @id @default(uuid())
  operationKey     String   @unique @map("operation_key")
  runId            String   @map("run_id")
  repairAccountId  String   @map("repair_account_id")
  billingAccountId String   @map("billing_account_id")
  grantId          String   @map("grant_id")
  allocationId     String   @map("allocation_id")
  beforeSnapshot   Json     @map("before_snapshot")
  createdAt        DateTime @default(now()) @map("created_at")

  run            BalanceLedgerRepairRun       @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_grant_retirements_run_fkey")
  repairAccount  BalanceLedgerRepairAccount   @relation(fields: [repairAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_grant_retirements_repair_account_fkey")
  billingAccount BillingAccount               @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_grant_retirements_billing_account_fkey")
  allocation     BalanceConsumptionAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_grant_retirements_allocation_fkey")

  @@unique([runId, grantId], map: "balance_ledger_grant_retirements_run_grant_key")
  @@unique([runId, allocationId], map: "balance_ledger_grant_retirements_run_allocation_key")
  @@index([billingAccountId, createdAt], map: "balance_ledger_grant_retirements_account_created_idx")
  @@map("balance_ledger_grant_retirement_repairs")
}

// 旧个人负余额 writer 曾把整笔跨零/全欠款消费错误归到一个 BALANCE_GRANT
// allocation。repair 必须先保存数据库原始 source before/after，并在 SPLIT
// 情况下保存确定性新 debt 行的完整快照。createdDebtAllocationId 故意不建 FK：
// proof 必须先于受保护 INSERT 落库，deferred terminal trigger 保证终态成对。
model BalanceLedgerPersonalDebtAllocationRepair {
  id                      String   @id @default(uuid())
  operationKey            String   @unique(map: "bl_personal_debt_operation_key") @map("operation_key")
  proofVersion            Int      @default(1) @map("proof_version")
  repairKind              String   @map("repair_kind")
  runId                   String   @map("run_id")
  repairAccountId         String   @map("repair_account_id")
  billingAccountId        String   @map("billing_account_id")
  transactionId           String   @unique(map: "balance_ledger_personal_debt_repairs_transaction_id_key") @map("transaction_id")
  sourceAllocationId      String   @unique(map: "bl_personal_debt_source_allocation_key") @map("source_allocation_id")
  createdDebtAllocationId String?  @unique(map: "bl_personal_debt_created_allocation_key") @map("created_debt_allocation_id")
  sourceBeforeSnapshot    Json     @map("source_before_snapshot")
  sourceAfterSnapshot     Json     @map("source_after_snapshot")
  createdDebtSnapshot     Json?    @map("created_debt_snapshot")
  createdAt               DateTime @default(now()) @map("created_at")

  run              BalanceLedgerRepairRun        @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_personal_debt_repairs_run_fkey")
  repairAccount    BalanceLedgerRepairAccount    @relation(fields: [repairAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_personal_debt_repairs_repair_account_fkey")
  billingAccount   BillingAccount                @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_personal_debt_repairs_billing_account_fkey")
  transaction      BalanceTransaction            @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_personal_debt_repairs_transaction_fkey")
  sourceAllocation BalanceConsumptionAllocation  @relation(fields: [sourceAllocationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_personal_debt_repairs_source_allocation_fkey")

  @@unique([runId, billingAccountId, sourceAllocationId], map: "balance_ledger_personal_debt_repairs_run_source_key")
  @@index([billingAccountId, createdAt], map: "balance_ledger_personal_debt_repairs_account_created_idx")
  @@map("balance_ledger_personal_debt_allocation_repairs")
}

// 无 idempotency receipt 的旧 voucher 只在精确旧 writer 指纹或可证明的
// debt-absorption 指纹成立时被证明。holeFill 只表示充值中填补既有欠款的部分，
// 剩余金额仍可形成真实批次并被后续消费；该 proof 不补造 receipt，也不直接
// 修改 transaction/grant，walletBefore/holeFill 仅把资金用途固定到钱包路径。
model BalanceLedgerVoucherFundingRepair {
  id                   String   @id @default(uuid())
  operationKey         String   @unique @map("operation_key")
  proofVersion         Int      @default(1) @map("proof_version")
  repairKind           String   @map("repair_kind")
  runId                String   @map("run_id")
  repairAccountId      String   @map("repair_account_id")
  billingAccountId     String   @map("billing_account_id")
  transactionId        String   @unique @map("transaction_id")
  grantId              String   @unique @map("grant_id")
  transactionSnapshot  Json     @map("transaction_snapshot")
  grantSnapshot        Json     @map("grant_snapshot")
  walletBeforeUsd      Decimal  @map("wallet_before_usd") @db.Decimal(20, 12)
  holeFillUsd          Decimal  @map("hole_fill_usd") @db.Decimal(20, 12)
  financeApprovalRef   String   @map("finance_approval_ref")
  technicalApprovalRef String   @map("technical_approval_ref")
  createdAt            DateTime @default(now()) @map("created_at")

  run            BalanceLedgerRepairRun     @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_voucher_funding_repairs_run_fkey")
  repairAccount  BalanceLedgerRepairAccount @relation(fields: [repairAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_voucher_funding_repairs_repair_account_fkey")
  billingAccount BillingAccount             @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_voucher_funding_repairs_billing_account_fkey")
  transaction    BalanceTransaction         @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_voucher_funding_repairs_transaction_fkey")
  grant          BalanceGrant               @relation(fields: [grantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_voucher_funding_repairs_grant_fkey")

  @@unique([runId, billingAccountId, transactionId], map: "balance_ledger_voucher_funding_repairs_run_tx_key")
  @@index([billingAccountId, createdAt], map: "balance_ledger_voucher_funding_repairs_account_created_idx")
  @@map("balance_ledger_voucher_funding_repairs")
}

// 历史 BalanceTransaction 的账户内顺序只能由已证明的钱包连续路径回填。
// 每次 NULL -> 负序修复都保存数据库原始行的完整 before/after 快照。
model BalanceLedgerTransactionRepair {
  id               String   @id @default(uuid())
  operationKey     String   @unique @map("operation_key")
  runId            String   @map("run_id")
  repairAccountId  String   @map("repair_account_id")
  billingAccountId String   @map("billing_account_id")
  transactionId    String   @map("transaction_id")
  beforeSnapshot   Json     @map("before_snapshot")
  afterSnapshot    Json     @map("after_snapshot")
  createdAt        DateTime @default(now()) @map("created_at")

  run             BalanceLedgerRepairRun     @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  repairAccount   BalanceLedgerRepairAccount @relation(fields: [repairAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  billingAccount  BillingAccount             @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transaction     BalanceTransaction         @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([runId, transactionId], map: "balance_ledger_transaction_repairs_run_transaction_key")
  @@index([billingAccountId, createdAt], map: "balance_ledger_transaction_repairs_account_created_idx")
  @@map("balance_ledger_transaction_repairs")
}

// enterprise-absorb pair repair may backfill only the two nullable remaining
// component columns on a legacy grant. Exact database-native before/after row
// images make that NULL -> replayed paid/bonus transition independently auditable.
model BalanceLedgerGrantComponentRepair {
  id               String   @id @default(uuid())
  operationKey     String   @unique @map("operation_key")
  runId            String   @map("run_id")
  repairAccountId  String   @map("repair_account_id")
  billingAccountId String   @map("billing_account_id")
  grantId          String   @map("grant_id")
  beforeSnapshot   Json     @map("before_snapshot")
  afterSnapshot    Json     @map("after_snapshot")
  createdAt        DateTime @default(now()) @map("created_at")

  run            BalanceLedgerRepairRun     @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_grant_component_repairs_run_fkey")
  repairAccount  BalanceLedgerRepairAccount @relation(fields: [repairAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_grant_component_repairs_repair_fkey")
  billingAccount BillingAccount             @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_grant_component_repairs_account_fkey")
  grant          BalanceGrant               @relation(fields: [grantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_grant_component_repairs_grant_fkey")

  @@unique([runId, grantId], map: "balance_ledger_grant_component_repairs_run_grant_key")
  @@index([billingAccountId, createdAt], map: "balance_ledger_grant_component_repairs_account_created_idx")
  @@map("balance_ledger_grant_component_repairs")
}

// 已下线的 enterprise-absorb writer 曾在一个 PostgreSQL 事务中把个人钱包
// 余额和仍有效充值批次移入企业账户。该表只记录 reconciliation 对这一对
// ADJUST 流水的不可变证明，不提供任何在线账户合并能力。
model BalanceLedgerAccountTransferRepair {
  id                     String   @id @default(uuid())
  operationKey           String   @unique @map("operation_key")
  proofVersion           Int      @default(1) @map("proof_version")
  runId                  String   @map("run_id")
  sourceRepairAccountId  String   @map("source_repair_account_id")
  targetRepairAccountId  String   @map("target_repair_account_id")
  sourceBillingAccountId String   @map("source_billing_account_id")
  targetBillingAccountId String   @map("target_billing_account_id")
  outTransactionId       String   @unique @map("out_transaction_id")
  inTransactionId        String   @unique @map("in_transaction_id")
  amountUsd              Decimal  @map("amount_usd") @db.Decimal(20, 12)
  originalXmin           BigInt   @map("original_xmin")
  outTransactionSnapshot Json     @map("out_transaction_snapshot")
  inTransactionSnapshot  Json     @map("in_transaction_snapshot")
  createdAt              DateTime @default(now()) @map("created_at")

  run                  BalanceLedgerRepairRun     @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_transfer_repairs_run_fkey")
  sourceRepairAccount  BalanceLedgerRepairAccount @relation("BalanceLedgerTransferSourceRepairAccount", fields: [sourceRepairAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_transfer_repairs_source_repair_fkey")
  targetRepairAccount  BalanceLedgerRepairAccount @relation("BalanceLedgerTransferTargetRepairAccount", fields: [targetRepairAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_transfer_repairs_target_repair_fkey")
  sourceBillingAccount BillingAccount             @relation("BalanceLedgerTransferSourceAccount", fields: [sourceBillingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_transfer_repairs_source_account_fkey")
  targetBillingAccount BillingAccount             @relation("BalanceLedgerTransferTargetAccount", fields: [targetBillingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_transfer_repairs_target_account_fkey")
  outTransaction       BalanceTransaction         @relation("BalanceLedgerTransferOutTransaction", fields: [outTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_transfer_repairs_out_tx_fkey")
  inTransaction        BalanceTransaction         @relation("BalanceLedgerTransferInTransaction", fields: [inTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_transfer_repairs_in_tx_fkey")
  grants               BalanceLedgerAccountTransferGrant[]

  @@unique([runId, sourceBillingAccountId, targetBillingAccountId], map: "balance_ledger_transfer_repairs_run_pair_key")
  @@index([sourceBillingAccountId, createdAt], map: "balance_ledger_transfer_repairs_source_created_idx")
  @@index([targetBillingAccountId, createdAt], map: "balance_ledger_transfer_repairs_target_created_idx")
  @@map("balance_ledger_account_transfer_repairs")
}

// enterprise-absorb 转移的每个充值批次都保存 funding、批次、两侧消费集合与
// 关联发票事实的完整快照。消费集合 hash 是签名 plan 的轻量承诺；JSON 快照
// 是数据库触发器可逐行核验的永久证据。
model BalanceLedgerAccountTransferGrant {
  id                         String   @id @default(uuid())
  operationKey               String   @unique @map("operation_key")
  transferRepairId           String   @map("transfer_repair_id")
  grantId                    String   @unique @map("grant_id")
  sourceFundingTransactionId String   @unique(map: "balance_ledger_account_transf_source_funding_transaction_id_key") @map("source_funding_transaction_id")
  transferredAmountUsd       Decimal  @map("transferred_amount_usd") @db.Decimal(20, 12)
  transferredPaidUsd         Decimal  @map("transferred_paid_usd") @db.Decimal(20, 12)
  transferredBonusUsd        Decimal  @map("transferred_bonus_usd") @db.Decimal(20, 12)
  sourceConsumedAmountUsd    Decimal  @map("source_consumed_amount_usd") @db.Decimal(20, 12)
  sourceConsumedPaidUsd      Decimal  @map("source_consumed_paid_usd") @db.Decimal(20, 12)
  sourceConsumedBonusUsd     Decimal  @map("source_consumed_bonus_usd") @db.Decimal(20, 12)
  targetConsumedAmountUsd    Decimal  @map("target_consumed_amount_usd") @db.Decimal(20, 12)
  targetConsumedPaidUsd      Decimal  @map("target_consumed_paid_usd") @db.Decimal(20, 12)
  targetConsumedBonusUsd     Decimal  @map("target_consumed_bonus_usd") @db.Decimal(20, 12)
  sourceAllocationCount      BigInt   @map("source_allocation_count")
  targetAllocationCount      BigInt   @map("target_allocation_count")
  sourceAllocationsSha256    String   @map("source_allocations_sha256")
  targetAllocationsSha256    String   @map("target_allocations_sha256")
  grantSnapshot              Json     @map("grant_snapshot")
  fundingTransactionSnapshot Json     @map("funding_transaction_snapshot")
  sourceAllocationsSnapshot  Json     @map("source_allocations_snapshot")
  targetAllocationsSnapshot  Json     @map("target_allocations_snapshot")
  invoiceEvidenceSha256      String   @map("invoice_evidence_sha256")
  invoiceEvidenceSnapshot    Json     @map("invoice_evidence_snapshot")
  createdAt                  DateTime @default(now()) @map("created_at")

  transferRepair           BalanceLedgerAccountTransferRepair @relation(fields: [transferRepairId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_transfer_grants_transfer_fkey")
  grant                    BalanceGrant                       @relation(fields: [grantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_transfer_grants_grant_fkey")
  sourceFundingTransaction BalanceTransaction                @relation("BalanceLedgerTransferGrantFunding", fields: [sourceFundingTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_transfer_grants_funding_fkey")

  @@index([transferRepairId], map: "balance_ledger_transfer_grants_transfer_idx")
  @@map("balance_ledger_account_transfer_grants")
}

// 旧企业管理员充值曾只写 ADJUST 和钱包，没有创建批次。reconciliation 只能
// 在精确 COMMITTED idempotency 证据存在时补建 paid-only 批次；这不是普通
// RECHARGE，也不会改写历史交易类型。balanceGrantId 刻意不建 FK，使 proof
// 能先于受保护的 grant INSERT 落库；事务内 deferred validator 保证两者成对。
model BalanceLedgerGrantCreationRepair {
  id                   String   @id @default(uuid())
  operationKey         String   @unique @map("operation_key")
  repairKind           String   @map("repair_kind")
  runId                String   @map("run_id")
  repairAccountId      String   @map("repair_account_id")
  billingAccountId     String   @map("billing_account_id")
  balanceTransactionId String   @unique(map: "balance_ledger_grant_creation_repair_balance_transaction_id_key") @map("balance_transaction_id")
  balanceGrantId       String   @unique @map("balance_grant_id")
  idempotencyKey       String   @map("idempotency_key")
  idempotencyScope     String   @map("idempotency_scope")
  idempotencySnapshot  Json     @map("idempotency_snapshot")
  transactionSnapshot  Json     @map("transaction_snapshot")
  grantSnapshot        Json     @map("grant_snapshot")
  createdAt            DateTime @default(now()) @map("created_at")

  run                BalanceLedgerRepairRun     @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_grant_creation_repairs_run_fkey")
  repairAccount      BalanceLedgerRepairAccount @relation(fields: [repairAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_grant_creation_repairs_account_run_fkey")
  billingAccount     BillingAccount             @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_grant_creation_repairs_account_fkey")
  balanceTransaction BalanceTransaction         @relation(fields: [balanceTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_grant_creation_repairs_transaction_fkey")

  @@unique([runId, billingAccountId, balanceTransactionId], map: "balance_ledger_grant_creation_repairs_run_tx_key")
  @@index([billingAccountId, createdAt], map: "balance_ledger_grant_creation_repairs_account_created_idx")
  @@map("balance_ledger_grant_creation_repairs")
}

model BalanceLedgerLegacyExpiryRepair {
  id                     String   @id @default(uuid())
  operationKey           String   @unique @map("operation_key")
  proofVersion           Int      @default(1) @map("proof_version")
  repairKind             String   @map("repair_kind")
  runId                  String   @map("run_id")
  repairAccountId        String   @map("repair_account_id")
  billingAccountId       String   @map("billing_account_id")
