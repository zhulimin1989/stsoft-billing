  @@index([tenantId, createdAt], map: "token_usage_tenant_id_created_at_idx")
  @@index([productId])
  @@index([codingPlanEntitlementId])
  @@index([providerEntitlementId])
  @@index([providerLineId])
  @@index([providerLineCode])
  @@index([providerCode])
  @@index([providerCostPolicyId], map: "token_usage_provider_cost_policy_idx")
