model Plan {
  id          String  @id @default(uuid())
  productId   String? @map("product_id")
  name        String
  description String  @default("")

  // 套餐类型与计费
  planType       String @default("individual") @map("plan_type") // individual / team / enterprise
  monthlyPrice   Int    @default(0) @map("monthly_price") // RMB 分
  quarterlyPrice Int    @default(0) @map("quarterly_price") // RMB 分（季付折算月价）
  yearlyPrice    Int    @default(0) @map("yearly_price") // RMB 分（年付折算月价）
  billingPeriod  String @default("monthly") @map("billing_period") // monthly / yearly / quarterly

  // 用量配额
  monthlyCredits    Int     @default(0) @map("monthly_credits") // 月度积分配额
  creditsRollover   Boolean @default(false) @map("credits_rollover") // 积分是否结转
  rolloverMaxMonths Int     @default(0) @map("rollover_max_months") // 最多结转几个月（0=不限）

  // 速率限制
  rateLimitRpm     Int @default(60) @map("rate_limit_rpm") // 每分钟请求数
  rateLimitTpm     Int @default(100000) @map("rate_limit_tpm") // 每分钟 token 数
  maxContextWindow Int @default(200000) @map("max_context_window") // 最大上下文 token

  // 超额策略
  overageEnabled  Boolean @default(false) @map("overage_enabled") // 超额后按量续费
  usageMultiplier Float   @default(1.0) @map("usage_multiplier") // 用量倍率（如 5x Pro）

  // 模型访问已迁移至 ModelAccess 表

  // 团队
  memberLimit  Int @default(1) @map("member_limit")
  minimumSeats Int @default(1) @map("minimum_seats")

  // 限量售卖：最大可售份数（仅自营 platform_model_package 执行；null=不限量）
  maxSellableQuantity Int? @map("max_sellable_quantity")

  // 安全与合规
  dataTraining   String  @default("opt_out") @map("data_training") // opt_in / opt_out / never
  supportTier    String  @default("community") @map("support_tier") // community / standard / priority / dedicated
  ssoEnabled     Boolean @default(false) @map("sso_enabled")
  priorityAccess Boolean @default(false) @map("priority_access")

  // 展示
  badge        String? // "最受欢迎" / "最佳性价比"
  trialDays    Int     @default(0) @map("trial_days") // 免费试用天数
  validityDays Int     @default(30) @map("validity_days")
  features     String  @default("[]") // JSON 功能列表
  isActive     Boolean @default(true) @map("is_active")
  isLegacy     Boolean @default(false) @map("is_legacy") // 已下架但老用户保留
  salesLimit   Int     @default(0) @map("sales_limit") // 转售套餐上架数量，0=不限量
  sortOrder    Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product                  Product?                   @relation(fields: [productId], references: [id])
  orders                   Order[]
  modelAccess              ModelAccess[]
  modelRoutePolicies       ModelRoutePolicy[]
  subscriptions            UserSubscription[]
  subscriptionPeriods      SubscriptionPeriod[]
  subscriptionEntitlements SubscriptionEntitlement[]
  prices                   PlanPrice[]
  campaigns                Campaign[]
  bundleItems              BundleSkuItem[]
  quotaRules               PlanQuotaRule[]
  orderItems               OrderItem[]
  tenantEntitlements       TenantProductEntitlement[]
  codingPlanResaleRoutes   CodingPlanResaleRoute[]
  gatewayUsageSettlementAnchors GatewayUsageSettlementAnchor[]

  @@index([productId])
  @@index([planType])
  @@map("plans")
}

