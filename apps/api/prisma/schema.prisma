  expiryAuditSnapshot    Json     @map("expiry_audit_snapshot")
  financeApprovalRef     String   @map("finance_approval_ref")
  technicalApprovalRef   String   @map("technical_approval_ref")
  createdAt              DateTime @default(now()) @map("created_at")

  run                BalanceLedgerRepairRun     @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bl_legacy_expiry_repairs_run_fkey")
  repairAccount      BalanceLedgerRepairAccount @relation(fields: [repairAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bl_legacy_expiry_repairs_repair_fkey")
  billingAccount     BillingAccount             @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bl_legacy_expiry_repairs_account_fkey")
  balanceGrant       BalanceGrant               @relation(fields: [balanceGrantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bl_legacy_expiry_repairs_grant_fkey")
  balanceTransaction BalanceTransaction         @relation(fields: [balanceTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bl_legacy_expiry_repairs_tx_fkey")
