  userId            String       @map("user_id")
  type              CreditTxType
  creditsAmount     Int          @map("credits_amount") // 正数=充入，负数=消耗
  source            String       @default("") // "plan:xxx" / "booster:xxx" / "chat:model"
  subscriptionId    String?      @map("subscription_id")
  tenantId          String?      @map("tenant_id")
