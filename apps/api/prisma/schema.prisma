// 自营连续订阅合约（连续包月/季/年自动续费）。仅自营 platform_model_package。
model CodingPlanAutoRenewal {
  id                 String                       @id @default(uuid())
  userId             String                       @map("user_id")
  tenantId           String                       @map("tenant_id")
  productId          String                       @map("product_id")
  planId             String                       @map("plan_id")
  billingPeriod      String                       @default("monthly") @map("billing_period") // monthly/quarterly/yearly
  channel            PayChannel
  status             CodingPlanAutoRenewalStatus  @default(SIGNING)
  // 签约号
  contractNo         String                       @unique @map("contract_no") // 商户本地唯一签约号（幂等锚）
  externalAgreementNo String?                     @unique @map("external_agreement_no") // 第三方签约号（支付宝agreement_no/微信contract_id/Stripe subscription_id）
  // 价格（续期不锁价，扣费当日按标准价；首期锁存审计）
  firstMonthAmountCents  Int                       @map("first_month_amount_cents") // 首期第一个月实付（可活动价）
  firstPeriodAmountCents Int                       @map("first_period_amount_cents") // 首期扣款额（首月价+首期内其余月标准价）
  listAmountCents        Int?                      @map("list_amount_cents")
  discountAmountCents    Int?                      @map("discount_amount_cents")
  promotionId            String?                   @map("promotion_id")
  currency               String
  // 续期调度
  nextChargeAt        DateTime?                    @map("next_charge_at") // 本期到期前的扣款日
  currentEntitlementId String?                     @map("current_entitlement_id") // 当前生效的 CodingPlanEntitlement
  failedCount         Int                          @default(0) @map("failed_count")
  // 取消/续期/切换互斥
  cancelRequestedAt   DateTime?                    @map("cancel_requested_at")
  cancelEffectiveAt   DateTime?                    @map("cancel_effective_at")
  renewalDisabledAt   DateTime?                    @map("renewal_disabled_at")
  renewalBlockedReason String?                     @map("renewal_blocked_reason") // 如 SWITCHING
  switchingOutToContractId String?                 @map("switching_out_to_contract_id")
  sourceContractId    String?                      @map("source_contract_id") // 升档/切周期来源合约
  sourceEntitlementId String?                      @map("source_entitlement_id") // 来源 entitlement（抵扣锚定）
  // 渠道解约补偿
  agreementTerminateStatus String?                 @map("agreement_terminate_status")
  terminateRetryAt    DateTime?                    @map("terminate_retry_at")
  terminateLastError  String?                      @map("terminate_last_error")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  charges CodingPlanRenewalCharge[]

  @@index([userId])
  @@index([tenantId, productId])
  @@index([status])
  @@index([nextChargeAt])
  @@index([sourceContractId])
  @@map("coding_plan_auto_renewals")
}

