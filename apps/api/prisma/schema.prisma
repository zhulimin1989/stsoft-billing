model Channel {
  id                        String    @id @default(uuid())
  name                      String
  provider                  String
  providerAccountIdentityId String?   @map("provider_account_identity_id")
  baseUrl                   String    @map("base_url")
  apiKeyEncrypted           String    @map("api_key")
  models                    String    @default("[]")
  // Per-model 配置 JSON，形如 { "claude-opus-4-7": { thinkingMode, thinkingBudget, ... } }。
  // 与 models（白名单数组）并存：models 决定该 channel 开通哪些模型，modelConfigs
  // 是稀疏映射，给特定模型加 per-model override（thinking budget / reasoning effort /
  // upstream id 等）。产品配置同步出口会把两者合并成下游期望的 dict 形式。
  modelConfigs              String?   @map("model_configs")
  sdkType                   String    @default("openai_completions") @map("sdk_type")
  providerProfile           String?   @map("provider_profile")
  clientCompatibility       String?   @map("client_compatibility")
  servedInboundProtocols    String?   @map("served_inbound_protocols")
  protocolPaths             Json?     @map("protocol_paths")
  tokenCountStrategy        String?   @map("token_count_strategy")
  ownedBy                   String?   @map("owned_by")
  dedicatedClientProtocol   String?   @map("dedicated_client_protocol")
  dedicatedProtocolStrategy String?   @map("dedicated_protocol_strategy")
  priority                  Int       @default(5)
  weight                    Int       @default(1)
  status                    String    @default("active")
  maxRpm                    Int?      @map("max_rpm")
  maxTpm                    Int?      @map("max_tpm")
  successRate               Float     @default(1.0) @map("success_rate")
  totalReqs                 Int       @default(0) @map("total_requests")
  totalErrs                 Int       @default(0) @map("total_errors")
  avgLatencyMs              Float?    @map("avg_latency_ms")
  remark                    String?
  isActive                  Boolean   @default(true) @map("is_active")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  deletedAt                 DateTime? @map("deleted_at")

  productChannels         ProductChannel[]
  providerAccountIdentity ProviderAccountIdentity? @relation(fields: [providerAccountIdentityId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([providerAccountIdentityId])
  @@map("channels")
}

/// Stable upstream-provider account identity. This deliberately does not store
/// credentials: key rotation changes the credential while preserving this ref.
model ProviderAccountIdentity {
  id           String   @id @default(uuid())
  ref          String   @unique @map("provider_account_ref")
  providerCode String   @map("provider_code")
  displayName  String   @map("display_name")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  channels                       Channel[]
  codingPlanProviderLines         CodingPlanProviderLine[]
  codingPlanProviderEntitlements CodingPlanProviderEntitlement[]

  @@index([providerCode, status])
  @@map("provider_account_identities")
}

model ProductChannel {
  id             String    @id @default(uuid())
  productId      String    @map("product_id")
  channelId      String    @map("channel_id")
  providerLineId String?   @map("provider_line_id")
  displayName    String?   @map("display_name")
  status         String    @default("active")
  isDefault      Boolean   @default(false) @map("is_default")
  allowedModels  Json?     @map("allowed_models")
  deniedModels   Json?     @map("denied_models")
  priority       Int       @default(5)
  weight         Int       @default(1)
  maxRpm         Int?      @map("max_rpm")
  maxTpm         Int?      @map("max_tpm")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  channel      Channel                     @relation(fields: [channelId], references: [id], onDelete: Restrict)
  providerLine CodingPlanProviderLine?     @relation(fields: [providerLineId], references: [id], onDelete: SetNull)
  groupMembers ProductChannelGroupMember[]

  @@index([productId, channelId])
  @@index([productId, status])
  @@index([channelId])
  @@index([providerLineId])
  @@map("product_channels")
}

model ProductChannelGroup {
