model InvoiceApplicationItem {
  id             String                 @id @default(uuid())
  applicationId  String                 @map("application_id")
  orderId        String                 @map("order_id")
  principalCents Int                    @map("principal_cents")
  description    InvoiceLineDescription
  productName    String?                @map("product_name")
  serviceStart   DateTime?              @map("service_start")
  serviceEnd     DateTime?              @map("service_end")
  poNumber       String?                @map("po_number")
  invoiceNumber  String?                @unique @map("invoice_number")
  issuingEntity  String?                @map("issuing_entity")
  issueDate      DateTime?              @map("issue_date")
  issuedAt       DateTime?              @map("issued_at")
  pdfUrl         String?                @map("pdf_url")
  ofdUrl         String?                @map("ofd_url")
  psaFormNo      String?                @map("psa_form_no")
  createdAt      DateTime               @default(now()) @map("created_at")

  application InvoiceApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([applicationId, orderId])
