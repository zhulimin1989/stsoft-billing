model GatewayBillingEvent {
  // legacyOriginalEvidenceMissingAt 是 lineage 墓碑，**不是** exposure 历史回补。
  //
  // 存在理由：provisional exposure 的 cutover 必须用「首收 evidence 的 observedAt」做判据，
  // 但历史父事件里有大量没有 original evidence 的行（迁移时实测 21,593 / 24,009，
  // 其中 1,509 仍为 RETRYABLE_FAILED，且这些行全部 evidence_hash IS NULL）。
  // 若不冻结，这些行被重新收件时会用**本轮**的 observedAt 冒充首次观察时间，
  // 从而被误判为「T 之后首收」而错误计入敞口。
  //
  // 一旦非空即不可修改或清空（由**独立**触发器函数
  // enforce_gateway_billing_event_legacy_tombstone_write_once 保证 ——
  // 既有的 enforce_gateway_billing_event_immutable_receipt 一个字都没动）。
  legacyOriginalEvidenceMissingAt DateTime? @map("legacy_original_evidence_missing_at") @db.Timestamp(3)

  provisionalExposure GatewayUsageProvisionalExposure?
  id                    String    @id @default(uuid())
  requestId             String    @unique @map("request_id")
  eventId               String?   @map("event_id")
  status                String    @default("RECEIVED")
  reason                String?
  apiKeyId              String?   @map("api_key_id")
  tenantId              String?   @map("tenant_id")
  billingAccountId      String?   @map("billing_account_id")
  userId                String?   @map("user_id")
  productId             String?   @map("product_id")
  productSlug           String?   @map("product_slug")
  modelName             String?   @map("model_name")
  inputTokens           Int       @default(0) @map("input_tokens")
  outputTokens          Int       @default(0) @map("output_tokens")
  cachedInputTokens     Int       @default(0) @map("cached_input_tokens")
  cacheWriteInputTokens Int       @default(0) @map("cache_write_input_tokens")
  totalTokens           Int       @default(0) @map("total_tokens")
  tokenSource           String?   @map("token_source")
  upstreamRequestId     String?   @map("upstream_request_id")
  evidenceHash          String?   @map("evidence_hash")
  evidenceVerdict       String    @default("UNKNOWN") @map("evidence_verdict")
  reconciliationStatus  String    @default("OPEN") @map("reconciliation_status")
  fundingOutcome        String?   @map("funding_outcome")
  revision              Int       @default(0)
  pendingExposureUsd    Decimal   @default(0) @map("pending_exposure_usd") @db.Decimal(20, 12)
  pendingHoldUsd        Decimal   @default(0) @map("pending_hold_usd") @db.Decimal(20, 12)
  subjectSnapshot       Json?     @map("subject_snapshot")
  pricingSnapshot       Json?     @map("pricing_snapshot")
  source                String?
  idempotencyKey        String?   @map("idempotency_key")
  billingUnit           String?   @map("billing_unit")
  rawEvent              Json      @map("raw_event")
  billingResult         Json?     @map("billing_result")
  errorMessage          String?   @map("error_message")
  occurredAt            DateTime? @map("occurred_at")
  receivedAt            DateTime  @default(now()) @map("received_at")
  processedAt           DateTime? @map("processed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tokenUsage TokenUsage?
  usageEvidences              GatewayUsageEvidence[]
  reconciliationActions       GatewayUsageReconciliationAction[]
  settlementReceipts          GatewayUsageSettlementReceipt[]
  platformLossEntries         GatewayUsagePlatformLoss[]
  usageLossRecognitionClaims  UsageLossRecognitionClaim[]
  historicalPlatformLossLines HistoricalPlatformLossLine[]
  currencyLabelRepairEligibleEvents BillingAccountCurrencyLabelRepairEligibleEvent[]
  settlementAnchor            GatewayUsageSettlementAnchor?
  fundingReservation          GatewayUsageFundingReservation?
  accessRestrictions          BillingAccessRestriction[]

  @@index([status, createdAt])
  @@index([billingAccountId, status, reconciliationStatus, createdAt], map: "gateway_billing_events_account_reconciliation_created_idx")
  @@index([evidenceVerdict, reconciliationStatus, createdAt], map: "gateway_billing_events_evidence_reconciliation_created_idx")
  @@index([fundingOutcome, createdAt], map: "gateway_billing_events_funding_created_idx")
  @@index([apiKeyId, createdAt])
  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([productId, createdAt])
  @@index([modelName, createdAt])
  @@index([occurredAt])
  @@index([status, occurredAt])
  @@map("gateway_billing_events")
}

// First-receipt funding fact for BALANCE Gateway usage. Financial slices and
// the occurrence-time credit policy are immutable; only the explicit workflow
// status may advance. This reservation protects admission capacity while
// evidence is pending and prevents delayed settlement from reclassifying a
// request using a later wallet balance or credit policy.
model GatewayUsageFundingReservation {
  id                          String    @id @default(uuid())
  gatewayBillingEventId       String    @unique @map("gateway_billing_event_id")
  requestId                   String    @unique @map("request_id")
  billingAccountId            String    @map("billing_account_id")
  tenantId                    String    @map("tenant_id")
  userId                      String    @map("user_id")
  apiKeyId                    String    @map("api_key_id")
  billingUnit                 String    @default("BALANCE") @map("billing_unit")
  // Frozen from BillingAccount.currency at first receipt. Existing rows stay
  // NULL rather than guessing a historical currency during migration.
  billingCurrency             String    @map("billing_currency")
  // V1 deliberately freezes only reconciled, non-expiring grants. Expiring
  // grants can become supplemental cash only if still valid at settlement.
  collectedFundingProtocol    String    @map("collected_funding_protocol")
  occurredAt                  DateTime  @map("occurred_at")
  firstReceivedAt             DateTime  @map("first_received_at")
  // Copied from the immutable BALANCE first-receipt anchor. This is the
  // account funding queue order; it is not allocated by the reservation
  // transaction, so a faster later Kafka partition cannot overtake it.
  reservationSequence         BigInt    @unique @map("reservation_sequence")
  reservedAmountUsd           Decimal   @map("reserved_amount_usd") @db.Decimal(20, 12)
  collectedUsd                Decimal   @map("collected_usd") @db.Decimal(20, 12)
  approvedCreditUsd           Decimal   @map("approved_credit_usd") @db.Decimal(20, 12)
  unapprovedDebtUsd           Decimal   @map("unapproved_debt_usd") @db.Decimal(20, 12)
  creditPolicyAt              DateTime  @map("credit_policy_at")
  // Earliest possible occurrence after applying the signed Gateway clock-skew
  // bound. creditPolicyAt is the matching latest possible occurrence. Positive
  // enterprise credit is valid only when one immutable policy applies to this
  // entire interval.
  creditPolicyWindowStart     DateTime  @map("credit_policy_window_start")
  // Exact append-only policy event used to reconstruct the frozen tuple. It is
  // NULL for personal accounts and for enterprise NO_CONFIG when no policy has
  // ever existed. Historical NO_CONFIG before the first policy instead points
  // at revision 1, whose complete immutable old-null tuple proves that state.
  creditPolicyEventId         String?   @map("credit_policy_event_id")
  creditPolicyRevision        Int?      @map("credit_policy_revision")
  creditPolicySource          String    @map("credit_policy_source")
  creditPolicyReconstructible Boolean   @map("credit_policy_reconstructible")
  // Raw limit from the append-only policy event. creditLimitUsd below is the
  // effective ACTIVE limit after applying status/effective/expiry to the full
  // occurrence window.
  creditConfiguredLimitUsd    Decimal   @map("credit_configured_limit_usd") @db.Decimal(20, 12)
  creditLimitUsd              Decimal   @map("credit_limit_usd") @db.Decimal(20, 12)
  creditTermsDays             Int?      @map("credit_terms_days")
  approvedCreditDueAt         DateTime? @map("approved_credit_due_at")
  creditStatus                String?   @map("credit_status")
  creditEffectiveAt           DateTime? @map("credit_effective_at")
  creditExpiresAt             DateTime? @map("credit_expires_at")
  anchorHash                  String    @map("anchor_hash")
  reservationHash             String    @unique @map("reservation_hash")
  canonicalPayload            Json      @map("canonical_payload")
  status                      String    @default("ACTIVE")
  reviewReason                String?   @map("review_reason")
  authoritativeAmountUsd      Decimal?  @map("authoritative_amount_usd") @db.Decimal(20, 12)
  consumedAt                  DateTime? @map("consumed_at")
  releasedAt                  DateTime? @map("released_at")
  releaseReason               String?   @map("release_reason")
  createdAt                   DateTime  @default(now()) @map("created_at")

  gatewayBillingEvent GatewayBillingEvent @relation(fields: [gatewayBillingEventId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_funding_reservations_event_fkey")
  billingAccount      BillingAccount      @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_funding_reservations_account_fkey")
  creditPolicyEvent   BillingAccountCreditEvent? @relation(fields: [creditPolicyEventId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_funding_reservations_credit_policy_event_fkey")
  grantHolds          GatewayUsageFundingReservationGrant[]

  @@unique([id, gatewayBillingEventId], map: "gateway_usage_funding_reservations_id_event_key")
  @@index([billingAccountId, status, reservationSequence], map: "gateway_usage_funding_reservations_account_status_sequence_idx")
  @@index([billingAccountId, occurredAt, firstReceivedAt], map: "gateway_usage_funding_reservations_account_occurrence_idx")
  @@map("gateway_usage_funding_reservations")
}

// Immutable, grant-specific backing for the collected slice frozen at first
// receipt. Holding exact grant IDs prevents an earlier request's later
// supplemental settlement from consuming the only historical grant that can
// still back a later request in the same account queue.
model GatewayUsageFundingReservationGrant {
  id                    String   @id @default(uuid())
  fundingReservationId  String   @map("funding_reservation_id")
  gatewayBillingEventId String   @map("gateway_billing_event_id")
  balanceGrantId        String   @map("balance_grant_id")
  amountUsd             Decimal  @map("amount_usd") @db.Decimal(20, 12)
  allocationOrder       Int      @map("allocation_order")
  createdAt             DateTime @default(now()) @map("created_at")

  fundingReservation GatewayUsageFundingReservation @relation(fields: [fundingReservationId, gatewayBillingEventId], references: [id, gatewayBillingEventId], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_funding_reservation_grants_reservation_fkey")
  balanceGrant       BalanceGrant                    @relation(fields: [balanceGrantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_funding_reservation_grants_grant_fkey")

  @@unique([fundingReservationId, balanceGrantId], map: "gateway_usage_funding_reservation_grants_reservation_grant_key")
  @@unique([fundingReservationId, allocationOrder], map: "gateway_usage_funding_reservation_grants_reservation_order_key")
  @@index([balanceGrantId], map: "gateway_usage_funding_reservation_grants_grant_idx")
  @@index([gatewayBillingEventId], map: "gateway_usage_funding_reservation_grants_event_idx")
  @@map("gateway_usage_funding_reservation_grants")
}

// Immutable occurrence-time identity and entitlement anchor. It is created
// together with the first Gateway event receipt and is never reconstructed
// from mutable API-key, tenant, product or subscription bindings on replay.
/// 稀疏队列:参与 V1 资金预留、且尚无 reservation 的 anchor。
/// 唯一目的是让「该账户是否存在更早且未预留的 anchor」这个 FIFO 队头判定可索引 ——
/// 取代对 gateway_usage_settlement_anchors 的全历史反连接扫描
/// (那个反连接结果恒空、LIMIT 1 无法提前终止 ⇒ 恒定全扫,生产 p50 2,119ms)。
///
/// 不变量:queue 中存在 event ⟺ 该 anchor 入队条件成立 且 尚无 reservation。
/// 由 DB 触发器维护(anchors AFTER INSERT 入队 / reservations AFTER INSERT 出队),
/// 见 migration 20260910000100。**不要用应用代码直接写这张表** ——
/// 应用侧只读它(blocker 查询),写入一律由触发器负责,否则不变量失去 DB 层保证。
///
/// 为什么不是给 anchors 加一列:anchors 是 DB 强制 append-only(见其 append_only 触发器),
/// 任何 UPDATE 抛 55000,且该异常会回滚整个 reservation 事务、卡死资金预留。
/// ⚠️ 应用侧**只读**。写入一律由 migration 20260910000100 的两个触发器负责。
/// migration 20260910000300 另加了写入侧保护:INSERT 必须与 anchor 的
/// event/account/sequence 三列一致,UPDATE 一律拒绝(55000) —— 因为 queue.sequence
/// 若被改大,真正更早的 blocker 会被过滤掉、FIFO 被越过(资金错序)。
model GatewayUsageUnreservedQueue {
  gatewayBillingEventId String   @id @map("gateway_billing_event_id")
  billingAccountId      String   @map("billing_account_id")
  firstReceiptSequence  BigInt   @map("first_receipt_sequence")
  enqueuedAt            DateTime @default(now()) @map("enqueued_at")

  @@index([billingAccountId, firstReceiptSequence], map: "gateway_usage_unreserved_queue_account_sequence_idx")
  @@map("gateway_usage_unreserved_queue")
}

/// 队列版 FIFO 队头查询的授权闸门。存在一行即表示回填已完成且不变量断言通过。
/// 由 migration 20260910000300 在断言全部通过后写入 —— **不受应用配置影响**;
/// 未就绪时 billing 必须走旧的 NOT EXISTS(reservation) 查询(见
/// findGatewayFundingBlockerByAnchorScan),否则会在「触发器已生效、回填未完成」的窗口里
/// 把后到的 receipt 放行到更早 receipt 之前。应用侧只读。
model GatewayUsageUnreservedQueueReadiness {
  id                 Boolean  @id @default(true)
  grantedAt          DateTime @default(now()) @map("granted_at")
  grantedByMigration String   @map("granted_by_migration")

  @@map("gateway_usage_unreserved_queue_readiness")
}

model GatewayUsageSettlementAnchor {
  id                      String   @id @default(uuid())
  gatewayBillingEventId   String   @unique @map("gateway_billing_event_id")
  requestId               String   @unique @map("request_id")
  apiKeyId                String   @map("api_key_id")
  userId                  String   @map("user_id")
  tenantId                String   @map("tenant_id")
  billingAccountId        String   @map("billing_account_id")
  productId               String   @map("product_id")
  productSlug             String   @map("product_slug")
  billingUnit             String   @map("billing_unit")
  // Single-request accounting currency frozen from BillingAccount.currency.
  // Historical anchors remain nullable/unknown; new receipts always set it.
  billingCurrency         String?  @map("billing_currency")
  codingPlanEntitlementId String?  @map("coding_plan_entitlement_id")
  subscriptionId          String?  @map("subscription_id")
  planId                  String?  @map("plan_id")
  occurredAt              DateTime @map("occurred_at")
  // Billing DB clock captured inside the first receipt transaction. This is
  // intentionally distinct from Gateway time and from created_at defaults.
  firstReceivedAt         DateTime @map("first_received_at")
  // Allocated only for new BALANCE receipts, under the per-billing-account
  // first-receipt advisory lock. Existing anchors remain NULL/manual-review;
  // CREDITS anchors deliberately remain outside this queue.
  firstReceiptSequence    BigInt?  @unique @map("first_receipt_sequence")
  fundingReservationProtocol String? @map("funding_reservation_protocol")
  pricingHash             String   @map("pricing_hash")
  customerQuoteSnapshot   Json     @map("customer_quote_snapshot")
  customerPricingSnapshot Json     @map("customer_pricing_snapshot")
  providerCostSnapshot    Json     @map("provider_cost_snapshot")
  anchorHash              String   @unique @map("anchor_hash")
  canonicalPayload        Json     @map("canonical_payload")
  createdAt               DateTime @default(now()) @map("created_at")

  gatewayBillingEvent    GatewayBillingEvent    @relation(fields: [gatewayBillingEventId], references: [id], onDelete: Restrict, map: "gateway_usage_settlement_anchors_event_fkey")
  apiKey                 ApiKey                 @relation(fields: [apiKeyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_settlement_anchors_api_key_fkey")
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_settlement_anchors_user_fkey")
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_settlement_anchors_tenant_fkey")
  billingAccount         BillingAccount         @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_settlement_anchors_account_fkey")
  product                Product                @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_settlement_anchors_product_fkey")
  codingPlanEntitlement  CodingPlanEntitlement? @relation(fields: [codingPlanEntitlementId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_settlement_anchors_coding_entitlement_fkey")
  plan                   Plan?                  @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_settlement_anchors_plan_fkey")
  creditBalanceState     CreditBalanceState?    @relation(fields: [subscriptionId], references: [subscriptionId], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_settlement_anchors_credit_balance_fkey")

  @@index([billingAccountId, occurredAt], map: "gateway_usage_settlement_anchors_account_occurred_idx")
  @@index([billingAccountId, firstReceiptSequence], map: "gateway_usage_settlement_anchors_account_receipt_sequence_idx")
  @@index([apiKeyId, occurredAt], map: "gateway_usage_settlement_anchors_key_occurred_idx")
  @@map("gateway_usage_settlement_anchors")
}

// Append-only source evidence. Replays with the same canonical hash are no-ops;
