  expiryAuditId          String   @unique @map("expiry_audit_id")
  nominalAmountUsd       Decimal  @map("nominal_amount_usd") @db.Decimal(20, 12)
  nominalPaidUsd         Decimal  @map("nominal_paid_usd") @db.Decimal(20, 12)
  nominalBonusUsd        Decimal  @map("nominal_bonus_usd") @db.Decimal(20, 12)
  walletBalanceBeforeUsd Decimal  @map("wallet_balance_before_usd") @db.Decimal(20, 12)
  walletBalanceAfterUsd  Decimal  @map("wallet_balance_after_usd") @db.Decimal(20, 12)
  transactionSnapshot    Json     @map("transaction_snapshot")
