/// Durable provider-side refund intent. This row is written before the first
/// irreversible provider call, so a timeout or process crash can be reconciled
/// with the same provider request number without guessing whether money moved.
model ProviderRefundIntent {
  id                                String                     @id @default(uuid())
  orderId                           String                     @unique @map("order_id")
  channel                           PayChannel
  tradeNo                           String                     @map("trade_no")
  requestNo                         String                     @unique @map("request_no")
  providerRefundId                  String?                    @map("provider_refund_id")
  amountCents                       Int                        @map("amount_cents")
  currency                          String
  reason                            String
  paymentProviderInstanceId         String?                    @map("payment_provider_instance_id")
  skipEntitlementCompensation       Boolean                    @default(false) @map("skip_entitlement_compensation")
  skipRechargeBalanceCompensation   Boolean                    @default(false) @map("skip_recharge_balance_compensation")
  preflightCompletedAt              DateTime                   @map("preflight_completed_at")
  status                            ProviderRefundIntentStatus @default(PREPARED)
  providerStatus                    String?                    @map("provider_status")
  providerAttemptedAt               DateTime?                  @map("provider_attempted_at")
  providerConfirmedAt               DateTime?                  @map("provider_confirmed_at")
  attempts                          Int                        @default(0)
  maxAttempts                       Int                        @default(12) @map("max_attempts")
  nextRunAt                         DateTime                   @default(now()) @map("next_run_at")
  lockedAt                          DateTime?                  @map("locked_at")
  lockedBy                          String?                    @map("locked_by")
  lastError                         String?                    @map("last_error")
  completedAt                       DateTime?                  @map("completed_at")
  createdAt                         DateTime                   @default(now()) @map("created_at")
  updatedAt                         DateTime                   @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([status, lockedAt])
  @@index([channel, providerStatus])
  @@map("provider_refund_intents")
}

