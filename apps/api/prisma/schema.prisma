  userId            String              @map("user_id")
  tenantId          String              @map("tenant_id")
  kind              InvoiceProfileKind
  invoiceType       InvoiceType         @map("invoice_type")
  title             String
  taxNo             String?             @map("tax_no")
  bankName          String?             @map("bank_name")
  bankAccount       String?             @map("bank_account")
  registeredAddress String?             @map("registered_address")
  registeredPhone   String?             @map("registered_phone")
  recipientName     String?             @map("recipient_name")
  recipientEmail    String?             @map("recipient_email")
  recipientPhone    String?             @map("recipient_phone")
  recipientAddress  String?             @map("recipient_address")
  isDefault         Boolean             @default(false) @map("is_default")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?           @map("deleted_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  applications InvoiceApplication[]

  @@index([userId, deletedAt])
  @@index([tenantId, deletedAt])
  @@map("invoice_profiles")
}

model InvoiceApplication {
  id              String                   @id @default(uuid())
  applicationNo   String                   @unique @map("application_no")
  userId          String                   @map("user_id")
  tenantId        String                   @map("tenant_id")
  profileId       String?                  @map("profile_id")
  profileSnapshot Json                     @map("profile_snapshot")
  currency        String
  subtotalCents   Int                      @map("subtotal_cents")
  taxAmountCents  Int                      @default(0) @map("tax_amount_cents")
  totalCents      Int                      @map("total_cents")
  status          InvoiceApplicationStatus @default(PENDING_REVIEW)
  issuingEntity   String?                  @map("issuing_entity")
  invoiceNumber   String?                  @unique @map("invoice_number")
  issueDate       DateTime?                @map("issue_date")
  dueDate         DateTime?                @map("due_date")
  issuedAt        DateTime?                @map("issued_at")
  pdfUrl          String?                  @map("pdf_url")
  ofdUrl          String?                  @map("ofd_url")
  psaAttachmentUrl String?                 @map("psa_attachment_url")
  rejectReason    String?                  @map("reject_reason")
  voidReason      String?                  @map("void_reason")
  failedReason    String?                  @map("failed_reason")
  reviewedBy      String?                  @map("reviewed_by")
  reviewedAt      DateTime?                @map("reviewed_at")
  psaStatus       String                   @default("NOT_SUBMITTED") @map("psa_status")
  psaFormNo       String?                  @map("psa_form_no")
  psaSubmittedAt  DateTime?                @map("psa_submitted_at")
  psaLastAttemptAt DateTime?               @map("psa_last_attempt_at")
  psaAttemptCount Int                      @default(0) @map("psa_attempt_count")
  psaLastError    String?                  @map("psa_last_error")
  idempotencyKey  String?                  @map("idempotency_key")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  user    User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profile InvoiceProfile?          @relation(fields: [profileId], references: [id], onDelete: SetNull)
  items   InvoiceApplicationItem[]
  events  InvoiceEventLog[]

  @@index([userId, status])
  @@index([tenantId, status])
  @@index([status, createdAt])
