  @@index([producerBuildSha, effectiveAt, revision], map: "gateway_producer_build_authorization_events_sha_effective_idx")
  @@map("gateway_producer_build_authorization_events")
}

model GatewayUsageEvidence {
  provisionalExposures GatewayUsageProvisionalExposure[]
  id                             String   @id @default(uuid())
  gatewayBillingEventId          String   @map("gateway_billing_event_id")
  requestId                      String   @map("request_id")
  eventId                        String?  @map("event_id")
  source                         String
  tokenSource                    String?  @map("token_source")
  upstreamRequestId              String?  @map("upstream_request_id")
  producerBuildSha               String?  @map("producer_build_sha")
  providerUsageHash              String?  @map("provider_usage_hash")
  providerAccountRef             String?  @map("provider_account_ref")
  streamEndReason                String?  @map("stream_end_reason")
  providerCredentialRef          String?  @map("provider_credential_ref")
  upstreamResponseId             String?  @map("upstream_response_id")
  // Filled only by the database from the append-only build-authorization
  // chain that was effective at observedAt. Writers cannot nominate their own
  // authority row, and a later revocation does not rewrite historical proof.
  producerBuildAuthorizationEventId String? @map("producer_build_authorization_event_id")
  producerBuildAuthorizationRevision Int?   @map("producer_build_authorization_revision")
  producerBuildAuthorityHash          String? @map("producer_build_authority_hash")
  usageEvidenceSource            String?  @map("usage_evidence_source")
  usageEvidenceStatus            String?  @map("usage_evidence_status")
  usageEvidenceProtocol          String?  @map("usage_evidence_protocol")
  terminalFrameSeen              Boolean? @map("terminal_frame_seen")
  providerReconciliationRequired Boolean? @map("provider_reconciliation_required")
  evidenceHash                   String   @map("evidence_hash")
  evidenceRevision               Int      @map("evidence_revision")
  rawEvidence                    Json     @map("raw_evidence")
  observedAt                     DateTime @map("observed_at")
  createdAt                      DateTime @default(now()) @map("created_at")

  gatewayBillingEvent GatewayBillingEvent        @relation(fields: [gatewayBillingEventId], references: [id], onDelete: Restrict, map: "gateway_usage_evidences_gateway_billing_event_id_fkey")
  producerBuildAuthorizationEvent GatewayProducerBuildAuthorizationEvent? @relation(fields: [producerBuildAuthorizationEventId, producerBuildAuthorizationRevision, producerBuildAuthorityHash], references: [id, revision, authorityHash], onDelete: Restrict, onUpdate: Restrict, map: "gateway_usage_evidences_build_authorization_event_fkey")
  platformLossEntries GatewayUsagePlatformLoss[]
  currencyLabelRepairEligibleEvents BillingAccountCurrencyLabelRepairEligibleEvent[]

  // 供 gateway_usage_provisional_exposures 的三列复合 FK 引用：
  // 它使「exposure 的 source evidence 必须与父事件同属一笔、且必须是 rev1」
  // 成为**数据库约束**，而不只是应用层不变量。
  @@unique([id, gatewayBillingEventId, evidenceRevision], map: "uq_evidence_id_event_revision")
  @@unique([gatewayBillingEventId, evidenceHash], map: "gateway_usage_evidences_event_hash_key")
  @@unique([gatewayBillingEventId, evidenceRevision], map: "gateway_usage_evidences_event_revision_key")
  @@index([requestId, createdAt], map: "gateway_usage_evidences_request_created_idx")
  @@index([upstreamRequestId, createdAt], map: "gateway_usage_evidences_upstream_created_idx")
  @@index([upstreamResponseId, createdAt], map: "gateway_usage_evidences_upstream_response_created_idx")
  @@map("gateway_usage_evidences")
}

// Append-only workflow audit. Financial actions are additionally represented by
// a permanent settlement receipt below.
model GatewayUsageReconciliationAction {
  id                    String   @id @default(uuid())
  gatewayBillingEventId String   @map("gateway_billing_event_id")
  requestId             String   @map("request_id")
  action                String
  expectedRevision      Int      @map("expected_revision")
  resultingRevision     Int      @map("resulting_revision")
  reason                String
  actorId               String?  @map("actor_id")
  idempotencyKey        String   @unique @map("idempotency_key")
  metadata              Json?
  createdAt             DateTime @default(now()) @map("created_at")

  gatewayBillingEvent GatewayBillingEvent       @relation(fields: [gatewayBillingEventId], references: [id], onDelete: Restrict, map: "gateway_usage_reconciliation_actions_event_fkey")
  platformLossEntry   GatewayUsagePlatformLoss?

  @@index([requestId, createdAt], map: "gateway_usage_reconciliation_actions_request_created_idx")
  @@index([gatewayBillingEventId, createdAt], map: "gateway_usage_reconciliation_actions_event_created_idx")
  @@index([action, createdAt], map: "gateway_usage_reconciliation_actions_action_created_idx")
  @@map("gateway_usage_reconciliation_actions")
}

// Permanent proof of each funding outcome. The idempotency key and settlement
// revision make repeated, concurrent or out-of-order commands financially inert.
model GatewayUsageSettlementReceipt {
  id                    String   @id @default(uuid())
  gatewayBillingEventId String   @map("gateway_billing_event_id")
  requestId             String   @map("request_id")
  settlementRevision    Int      @map("settlement_revision")
  fundingOutcome        String   @map("funding_outcome")
  evidenceHash          String?  @map("evidence_hash")
  anchorHash            String?  @map("anchor_hash")
  pricingHash           String?  @map("pricing_hash")
  settlementFingerprint String?  @map("settlement_fingerprint")
  billingUnit           String?  @map("billing_unit")
  // Copied from the immutable first-receipt anchor; NULL means legacy/unknown.
  billingCurrency       String?  @map("billing_currency")
  creditAmount          Int?     @map("credit_amount")
  amountUsd             Decimal  @default(0) @map("amount_usd") @db.Decimal(20, 12)
  tokenUsageId          String?  @map("token_usage_id")
  reason                String?
  policyVersion         String?  @map("policy_version")
  actorId               String?  @map("actor_id")
  idempotencyKey        String   @unique @map("idempotency_key")
  payload               Json?
  createdAt             DateTime @default(now()) @map("created_at")

  gatewayBillingEvent       GatewayBillingEvent        @relation(fields: [gatewayBillingEventId], references: [id], onDelete: Restrict, map: "gateway_usage_settlement_receipts_gateway_billing_event_id_fkey")
  originalForPlatformLosses GatewayUsagePlatformLoss[] @relation("GatewayPlatformLossOriginalReceipt")
  absorptionForPlatformLoss GatewayUsagePlatformLoss?  @relation("GatewayPlatformLossAbsorptionReceipt")

  @@unique([gatewayBillingEventId, settlementRevision], map: "gateway_usage_receipts_event_revision_key")
  @@index([requestId, createdAt], map: "gateway_usage_settlement_receipts_request_created_idx")
  @@index([fundingOutcome, createdAt], map: "gateway_usage_settlement_receipts_outcome_created_idx")
  @@map("gateway_usage_settlement_receipts")
}

// Append-only management accounting for an already-settled request whose
// authoritative dimensions later prove a customer undercharge. The customer
// deduction is fixed at zero; the original receipt and TokenUsage remain
// immutable, while the correction evidence and frozen-price valuation are
// permanently bound to the finance approval.
model GatewayUsagePlatformLoss {
  id                            String   @id @default(uuid())
  gatewayBillingEventId         String   @map("gateway_billing_event_id")
  requestId                     String   @map("request_id")
  reconciliationActionId        String   @unique(map: "gateway_usage_platform_losses_action_key") @map("reconciliation_action_id")
  correctionEvidenceId          String   @map("correction_evidence_id")
  correctionEvidenceHash        String   @map("correction_evidence_hash")
  originalSettlementReceiptId   String   @map("original_settlement_receipt_id")
  absorptionSettlementReceiptId String   @unique(map: "gateway_usage_platform_losses_absorption_receipt_key") @map("absorption_settlement_receipt_id")
  billingUnit                   String   @map("billing_unit")
  customerChargeBeforeUsd       Decimal  @map("customer_charge_before_usd") @db.Decimal(20, 12)
  customerChargeCorrectedUsd    Decimal  @map("customer_charge_corrected_usd") @db.Decimal(20, 12)
  absorbedCustomerChargeUsd     Decimal  @map("absorbed_customer_charge_usd") @db.Decimal(20, 12)
  customerDeductionUsd          Decimal  @default(0) @map("customer_deduction_usd") @db.Decimal(20, 12)
  providerCostBeforeUsd         Decimal  @map("provider_cost_before_usd") @db.Decimal(20, 12)
  providerCostCorrectedUsd      Decimal  @map("provider_cost_corrected_usd") @db.Decimal(20, 12)
  providerCostDeltaUsd          Decimal  @map("provider_cost_delta_usd") @db.Decimal(20, 12)
  platformLossUsd               Decimal  @map("platform_loss_usd") @db.Decimal(20, 12)
  valuationPolicyVersion        String   @map("valuation_policy_version")
  reason                        String
  actorId                       String   @map("actor_id")
  idempotencyKey                String   @unique @map("idempotency_key")
  createdAt                     DateTime @default(now()) @map("created_at")

  gatewayBillingEvent         GatewayBillingEvent              @relation(fields: [gatewayBillingEventId], references: [id], onDelete: Restrict, map: "gateway_usage_platform_losses_event_fkey")
  reconciliationAction        GatewayUsageReconciliationAction @relation(fields: [reconciliationActionId], references: [id], onDelete: Restrict, map: "gateway_usage_platform_losses_action_fkey")
  correctionEvidence          GatewayUsageEvidence             @relation(fields: [correctionEvidenceId], references: [id], onDelete: Restrict, map: "gateway_usage_platform_losses_evidence_fkey")
  originalSettlementReceipt   GatewayUsageSettlementReceipt    @relation("GatewayPlatformLossOriginalReceipt", fields: [originalSettlementReceiptId], references: [id], onDelete: Restrict, map: "gateway_usage_platform_losses_original_receipt_fkey")
  absorptionSettlementReceipt GatewayUsageSettlementReceipt    @relation("GatewayPlatformLossAbsorptionReceipt", fields: [absorptionSettlementReceiptId], references: [id], onDelete: Restrict, map: "gateway_usage_platform_losses_absorption_receipt_fkey")
  recognitionClaims           UsageLossRecognitionClaim[]

  @@index([requestId, createdAt], map: "gateway_usage_platform_losses_request_created_idx")
  @@index([gatewayBillingEventId, createdAt], map: "gateway_usage_platform_losses_event_created_idx")
  @@index([correctionEvidenceId], map: "gateway_usage_platform_losses_evidence_idx")
  @@map("gateway_usage_platform_losses")
}

// A maker/checker controlled, append-only finance closure for historical
// provider discrepancies that predate occurrence-time settlement anchors.
// It is management accounting only: customer_deduction_usd is fixed at zero
// and no customer wallet, TokenUsage, invoice or prior settlement receipt is
// mutated by posting the batch.
model HistoricalPlatformLossBatch {
  id                         String    @id @default(uuid())
  provider                   String
  providerAccountRef         String    @map("provider_account_ref")
  region                     String
  periodStart                DateTime  @map("period_start")
  periodEnd                  DateTime  @map("period_end")
  currency                   String
  sourceFileRef              String    @map("source_file_ref")
  sourceFileSha256           String    @map("source_file_sha256")
  calculationMethod          String    @map("calculation_method")
  roundingPolicy             String    @map("rounding_policy")
  exchangeRate               Decimal?  @map("exchange_rate") @db.Decimal(30, 12)
  exchangeRateSource         String?   @map("exchange_rate_source")
  exchangeRateSourceCurrency String?   @map("exchange_rate_source_currency")
  exchangeRateAsOf           DateTime? @map("exchange_rate_as_of")
  platformAmountBefore       Decimal   @map("platform_amount_before") @db.Decimal(20, 12)
  platformAmountCorrected    Decimal   @map("platform_amount_corrected") @db.Decimal(20, 12)
  customerAbsorbedDelta      Decimal   @map("customer_absorbed_delta") @db.Decimal(20, 12)
  customerDeduction          Decimal   @default(0) @map("customer_deduction") @db.Decimal(20, 12)
  providerCostBefore         Decimal   @map("provider_cost_before") @db.Decimal(20, 12)
  providerCostCorrected      Decimal   @map("provider_cost_corrected") @db.Decimal(20, 12)
  providerCostDelta          Decimal   @map("provider_cost_delta") @db.Decimal(20, 12)
  itemCount                  Int       @map("item_count")
  fingerprint                String    @unique
  revision                   Int       @default(0)
  status                     String    @default("PREPARED")
  reason                     String
  makerActorId               String    @map("maker_actor_id")
  checkerActorId             String?   @map("checker_actor_id")
  postedByActorId            String?   @map("posted_by_actor_id")
  createIdempotencyKey       String    @unique @map("create_idempotency_key")
  postIdempotencyKey         String?   @unique @map("post_idempotency_key")
  approvedAt                 DateTime? @map("approved_at")
  postedAt                   DateTime? @map("posted_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  lines   HistoricalPlatformLossLine[]
  actions HistoricalPlatformLossAction[]

  @@index([status, createdAt], map: "historical_platform_loss_batches_status_created_idx")
  @@index([provider, providerAccountRef, periodStart, periodEnd], map: "historical_platform_loss_batches_provider_period_idx")
  @@map("historical_platform_loss_batches")
}

// Every source row remains intact and independently hash-verifiable. A line
// either names a historical Gateway request with no anchor, or represents a
// provider statement aggregate that cannot truthfully be allocated to a
// request.
model HistoricalPlatformLossLine {
  id                      String   @id @default(uuid())
  batchId                 String   @map("batch_id")
  lineNumber              Int      @map("line_number")
  lineType                String   @map("line_type")
  gatewayBillingEventId   String?  @map("gateway_billing_event_id")
  requestId               String?  @map("request_id")
  upstreamRequestId       String?  @map("upstream_request_id")
  providerAggregateRef    String?  @map("provider_aggregate_ref")
  serviceDate             DateTime @map("service_date") @db.Date
  modelName               String   @map("model_name")
  meter                   String
  platformUsage           Decimal  @map("platform_usage") @db.Decimal(30, 0)
  providerUsage           Decimal  @map("provider_usage") @db.Decimal(30, 0)
  usageDelta              Decimal  @map("usage_delta") @db.Decimal(30, 0)
  valuationBasis          Json     @map("valuation_basis")
  sourceRowRef            String   @map("source_row_ref")
  sourceEvidence          Json     @map("source_evidence")
  sourceRowHash           String   @map("source_row_hash")
  recognitionKeys         Json     @map("recognition_keys")
  platformAmountBefore    Decimal  @map("platform_amount_before") @db.Decimal(20, 12)
  platformAmountCorrected Decimal  @map("platform_amount_corrected") @db.Decimal(20, 12)
  customerAbsorbedDelta   Decimal  @map("customer_absorbed_delta") @db.Decimal(20, 12)
  customerDeduction       Decimal  @default(0) @map("customer_deduction") @db.Decimal(20, 12)
  providerCostBefore      Decimal  @map("provider_cost_before") @db.Decimal(20, 12)
  providerCostCorrected   Decimal  @map("provider_cost_corrected") @db.Decimal(20, 12)
  providerCostDelta       Decimal  @map("provider_cost_delta") @db.Decimal(20, 12)
  lineHash                String   @map("line_hash")
  createdAt               DateTime @default(now()) @map("created_at")

  batch               HistoricalPlatformLossBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, map: "historical_platform_loss_lines_batch_fkey")
  gatewayBillingEvent GatewayBillingEvent?        @relation(fields: [gatewayBillingEventId], references: [id], onDelete: Restrict, map: "historical_platform_loss_lines_event_fkey")
  recognitionClaims   UsageLossRecognitionClaim[]

  @@unique([batchId, lineNumber], map: "historical_platform_loss_lines_batch_line_key")
  @@unique([batchId, lineHash], map: "historical_platform_loss_lines_batch_hash_key")
  @@index([requestId], map: "historical_platform_loss_lines_request_idx")
  @@index([upstreamRequestId], map: "historical_platform_loss_lines_upstream_idx")
  @@map("historical_platform_loss_lines")
}

model HistoricalPlatformLossAction {
  id                String   @id @default(uuid())
  batchId           String   @map("batch_id")
  action            String
  expectedRevision  Int      @map("expected_revision")
  resultingRevision Int      @map("resulting_revision")
  actorId           String   @map("actor_id")
  reason            String
  idempotencyKey    String   @unique @map("idempotency_key")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  batch HistoricalPlatformLossBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, map: "historical_platform_loss_actions_batch_fkey")

  @@index([batchId, createdAt], map: "historical_platform_loss_actions_batch_created_idx")
  @@map("historical_platform_loss_actions")
}

// Cross-granularity exclusion registry. Many request-level corrections may
// share one coverage tuple, while an aggregate posting is mutually exclusive
// with every request-level correction in that tuple.
model UsageLossCoverageRegistry {
  id                 String   @id @default(uuid())
  coverageKey        String   @unique @map("coverage_key")
  provider           String
  providerAccountRef String   @map("provider_account_ref")
  region             String
  serviceDate        DateTime @map("service_date") @db.Date
  modelName          String   @map("model_name")
  meter              String
  granularityMode    String   @map("granularity_mode")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([provider, providerAccountRef, region, serviceDate, modelName, meter], map: "usage_loss_coverage_registry_scope_idx")
  @@map("usage_loss_coverage_registry")
}

// One globally unique claim per identifiable request/upstream/aggregate source
// row. Cross-granularity exclusion belongs to UsageLossCoverageRegistry so
// several distinct request claims may safely share one REQUEST coverage.
model UsageLossRecognitionClaim {
  id                         String   @id @default(uuid())
  recognitionKey             String   @unique @map("recognition_key")
  recognitionType            String   @map("recognition_type")
  claimSource                String   @map("claim_source")
  gatewayBillingEventId      String?  @map("gateway_billing_event_id")
  gatewayUsagePlatformLossId String?  @map("gateway_usage_platform_loss_id")
  historicalBatchLineId      String?  @map("historical_batch_line_id")
  createdAt                  DateTime @default(now()) @map("created_at")

  gatewayBillingEvent      GatewayBillingEvent?        @relation(fields: [gatewayBillingEventId], references: [id], onDelete: Restrict, map: "usage_loss_recognition_claims_event_fkey")
  gatewayUsagePlatformLoss GatewayUsagePlatformLoss?   @relation(fields: [gatewayUsagePlatformLossId], references: [id], onDelete: Restrict, map: "usage_loss_recognition_claims_platform_loss_fkey")
  historicalBatchLine      HistoricalPlatformLossLine? @relation(fields: [historicalBatchLineId], references: [id], onDelete: Restrict, map: "usage_loss_recognition_claims_historical_line_fkey")

  @@index([claimSource, createdAt], map: "usage_loss_recognition_claims_source_created_idx")
  @@index([gatewayBillingEventId], map: "usage_loss_recognition_claims_event_idx")
  @@index([historicalBatchLineId], map: "usage_loss_recognition_claims_line_idx")
  @@map("usage_loss_recognition_claims")
}

// Durable source for Gateway `manual_freeze`. Restrictions are evaluated at
// publish time; releasing one row never bypasses another active restriction.
model BillingAccessRestriction {
  id                    String    @id @default(uuid())
  gatewayBillingEventId String?   @map("gateway_billing_event_id")
  apiKeyId              String?   @map("api_key_id")
  billingAccountId      String?   @map("billing_account_id")
  status                String    @default("ACTIVE")
  reason                String
  idempotencyKey        String    @unique @map("idempotency_key")
  createdBy             String?   @map("created_by")
  releasedBy            String?   @map("released_by")
  releaseReason         String?   @map("release_reason")
  releasedAt            DateTime? @map("released_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  gatewayBillingEvent GatewayBillingEvent?                 @relation(fields: [gatewayBillingEventId], references: [id], onDelete: Restrict, map: "billing_access_restrictions_gateway_billing_event_id_fkey")
  projectionIntents   BillingRestrictionProjectionIntent[]

  @@index([apiKeyId, status], map: "billing_access_restrictions_api_key_status_idx")
  @@index([billingAccountId, status], map: "billing_access_restrictions_account_status_idx")
  @@index([gatewayBillingEventId, status], map: "billing_access_restrictions_event_status_idx")
  @@map("billing_access_restrictions")
}

// Durable outbox for projecting Billing access restrictions to Gateway. A DB
// trigger creates one intent in the same transaction as every restriction
// INSERT and status transition, closing the commit-before-Publisher crash gap.
model BillingRestrictionProjectionIntent {
  id                         String    @id @default(uuid())
  billingAccessRestrictionId String    @map("billing_access_restriction_id")
  gatewayBillingEventId      String?   @map("gateway_billing_event_id")
  apiKeyId                   String?   @map("api_key_id")
  billingAccountId           String?   @map("billing_account_id")
  restrictionStatus          String    @map("restriction_status")
  status                     String    @default("PENDING")
  attempts                   Int       @default(0)
  nextRunAt                  DateTime  @default(now()) @map("next_run_at")
  leaseId                    String?   @map("lease_id")
  lockedAt                   DateTime? @map("locked_at")
  lastError                  String?   @map("last_error")
  projected                  Boolean?
  completedAt                DateTime? @map("completed_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  billingAccessRestriction BillingAccessRestriction @relation(fields: [billingAccessRestrictionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "billing_restriction_projection_intents_restriction_fkey")

  @@unique([billingAccessRestrictionId, restrictionStatus], map: "billing_restriction_projection_restriction_status_key")
  @@index([status, nextRunAt], map: "billing_restriction_projection_intents_due_idx")
  @@index([status, createdAt], map: "billing_restriction_projection_intents_retention_idx")
  @@index([billingAccountId, status], map: "billing_restriction_projection_intents_account_status_idx")
  @@index([apiKeyId, status], map: "billing_restriction_projection_intents_key_status_idx")
  @@map("billing_restriction_projection_intents")
}

model PublisherSyncJob {
