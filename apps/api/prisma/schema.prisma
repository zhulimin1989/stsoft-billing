  createdAt             DateTime @default(now()) @map("created_at")

  run                 BillingAccountCurrencyLabelRepairRun  @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "billing_currency_repair_events_run_fkey")
  item                BillingAccountCurrencyLabelRepairItem @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "billing_currency_repair_events_item_fkey")
  gatewayBillingEvent GatewayBillingEvent                    @relation(fields: [gatewayBillingEventId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "billing_currency_repair_events_event_fkey")
