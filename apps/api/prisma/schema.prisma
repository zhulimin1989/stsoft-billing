// ============================
// 折扣活动系统
// Campaign = 运营配置的限时一口价（scope: all/new_users/old_users，可按币种/月付年付配价）
// DiscountCode = 用户手动输入的促销码（percent_off / amount_off）
// 算法：最终价 = min(原价, 命中活动价, 原价-码折扣)
// ============================

model Campaign {
  id                  String   @id @default(uuid())
  productId           String?  @map("product_id")
  planId              String?  @map("plan_id")
  bundleSkuId         String?  @map("bundle_sku_id")
  name                String
  description         String   @default("")
  scope               String // 'all' | 'new_users' | 'old_users'
  firstTimeOnly       Boolean  @default(false) @map("first_time_only")
  billingPeriod       String   @map("billing_period") // 'monthly' | 'quarterly' | 'yearly' | 'both' | 'all'
  startAt             DateTime @map("start_at")
  endAt               DateTime @map("end_at")
  maxUsesPerUser      Int      @default(1) @map("max_uses_per_user")
  maxUsesTotal        Int      @default(0) @map("max_uses_total") // 0=无限
  stripeCouponIdsJson String   @default("{}") @map("stripe_coupon_ids") // JSON: {"usd:monthly":"cpn_xxx","usd:quarterly":"..."}
  priority            Int      @default(0)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  plan        Plan?                @relation(fields: [planId], references: [id])
  bundleSku   BundleSku?           @relation(fields: [bundleSkuId], references: [id])
  product     Product?             @relation(fields: [productId], references: [id])
  prices      CampaignPrice[]
  redemptions CampaignRedemption[]
  orders      Order[]

  @@index([planId, isActive, startAt, endAt])
  @@index([bundleSkuId, isActive, startAt, endAt])
  @@map("campaigns")
}

model CampaignPrice {
  id             String   @id @default(uuid())
  campaignId     String   @map("campaign_id")
  currency       String // 'usd' | 'sgd' | 'cny' ...
  monthlyPrice   Int      @map("monthly_price") // cents，活动月付价
  quarterlyPrice Int      @default(0) @map("quarterly_price") // cents，活动季付的月均价
  yearlyPrice    Int      @map("yearly_price") // cents，活动年付的月均价
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, currency])
  @@map("campaign_prices")
}

model CampaignRedemption {
  id               String   @id @default(uuid())
  campaignId       String   @map("campaign_id")
  userId           String   @map("user_id")
  orderId          String   @map("order_id")
  amountSavedCents Int      @map("amount_saved_cents")
  redeemedAt       DateTime @default(now()) @map("redeemed_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, userId])
  @@index([orderId])
  @@map("campaign_redemptions")
}

/// 促销码（计费折扣，Stripe Coupon 支持）。
model DiscountCode {
  id             String    @id @default(uuid())
  code           String    @unique // 大写存储
  name           String
  description    String    @default("")
  discountType   String    @map("discount_type") // 'percent_off' | 'amount_off'
  discountValue  Int       @map("discount_value") // percent: 5~99 整数；amount: cents
  currency       String? // amount_off 必填
  duration       String    @default("once") // 'once' | 'repeating' | 'forever'
  durationMonths Int?      @map("duration_months") // repeating 必填
  planIdsJson    String    @default("[]") @map("plan_ids") // JSON array，空=所有
  firstTimeOnly  Boolean   @default(false) @map("first_time_only")
  scope          String    @default("all") // 'all' | 'new_users' | 'old_users'
  maxUses        Int       @default(0) @map("max_uses") // 0=无限全局
  maxUsesPerUser Int       @default(1) @map("max_uses_per_user")
  currentUses    Int       @default(0) @map("current_uses")
  startAt        DateTime? @map("start_at")
  endAt          DateTime? @map("end_at")
  stripeCouponId String?   @map("stripe_coupon_id")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  redemptions DiscountCodeRedemption[]
  orders      Order[]

  @@index([code, isActive])
  @@map("discount_codes")
}

model DiscountCodeRedemption {
  id               String   @id @default(uuid())
  discountCodeId   String   @map("discount_code_id")
  userId           String   @map("user_id")
  orderId          String   @map("order_id")
  amountSavedCents Int      @map("amount_saved_cents")
  redeemedAt       DateTime @default(now()) @map("redeemed_at")

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id])

  @@index([discountCodeId, userId])
  @@index([orderId])
  @@map("discount_code_redemptions")
}

/// Stripe 资金对账事实表。
/// orders.trade_no 保留原支付业务语义（Checkout Session 或 Subscription ID）；
/// 本表承载财务对账需要的 cs/pi/ch/txn/po 多级 Stripe 资金链路。
model StripePaymentLedger {
  id                        String    @id @default(uuid())
  orderId                   String?   @map("order_id")
  paymentProviderInstanceId String?   @map("payment_provider_instance_id")
