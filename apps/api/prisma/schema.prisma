  prorationSourceEntitlementId String?  @map("proration_source_entitlement_id") // 自营换档抵扣定价所依据的源 entitlement（履约时锚定同一性，防并发/切走再切回重复抵扣）
  prorationRemainingCredits Int?        @map("proration_remaining_credits")
  prorationMonthlyCredits   Int?        @map("proration_monthly_credits")
  checkoutInitState         PaymentCheckoutInitState @default(NOT_STARTED) @map("checkout_init_state")
  checkoutLeaseId           String?     @map("checkout_lease_id")
  checkoutLeaseExpiresAt    DateTime?   @map("checkout_lease_expires_at")
  checkoutContextEncrypted  String?     @map("checkout_context_encrypted")
  // Immutable provider-side checkout identifier captured before a callback can
  // mutate tradeNo (for example Stripe Checkout Session -> Subscription).
  checkoutProviderReference String?     @map("checkout_provider_reference")
  checkoutPayUrlEncrypted   String?     @map("checkout_pay_url_encrypted")
  checkoutPayUrlExpiresAt   DateTime?   @map("checkout_pay_url_expires_at")
  createdAt                 DateTime    @default(now()) @map("created_at")

  user                    User                     @relation(fields: [userId], references: [id])
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  billingAccount          BillingAccount?          @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  bundleSku               BundleSku?               @relation(fields: [bundleSkuId], references: [id], onDelete: SetNull)
  product                 Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  plan                    Plan?                    @relation(fields: [planId], references: [id])
  boosterPack             BoosterPack?             @relation(fields: [boosterPackId], references: [id])
  auditLogs               OrderAuditLog[]
  items                   OrderItem[]
  balanceGrants           BalanceGrant[]
  stripePaymentLedgers    StripePaymentLedger[]
  stripeSubscriptionCancellationTask StripeSubscriptionCancellationTask?
  providerRefundIntent ProviderRefundIntent?
  refundCompensationTasks RefundCompensationTask[]
  campaign                Campaign?                @relation(fields: [campaignId], references: [id])
  discountCode            DiscountCode?            @relation(fields: [discountCodeId], references: [id])
  invoiceItems            InvoiceApplicationItem[]

  @@unique([userId, tenantId, idempotencyKey], map: "orders_user_id_tenant_id_idempotency_key_key")
  @@index([userId, createdAt, id], map: "orders_user_created_id_idx")
  @@index([billingAccountId, createdAt, id], map: "orders_account_created_id_idx")
  @@index([tenantId, createdAt, id], map: "orders_tenant_created_id_idx")
  @@index([userId])
  @@index([tenantId])
  @@index([billingAccountId])
  @@index([tenantId, status])
  @@index([bundleSkuId])
  @@index([productId])
  @@index([planId, orderType, status], map: "orders_plan_id_order_type_status_idx")
  @@index([rechargeTierId])
  @@index([status])
  @@index([channel])
  @@index([orderType])
  @@index([paymentProviderInstanceId])
  @@index([status, fulfillmentClaimedAt])
  @@index([checkoutInitState, checkoutLeaseExpiresAt])
  @@index([fulfillmentAttemptId])
  @@index([createdAt, id], map: "orders_created_at_id_idx")
  @@index([paidAt, id], map: "orders_paid_at_id_idx")
  @@index([completedAt, id], map: "orders_completed_at_id_idx")
  @@index([refundedAt, id], map: "orders_refunded_at_id_idx")
  @@map("orders")
}

