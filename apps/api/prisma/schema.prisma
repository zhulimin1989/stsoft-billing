// ============================
// Phase v2 P1 / PR2: PlanQuotaTemplate (配额规则模板)
// ============================
//
// 模板库：CodingPlan 套餐配额规则的可复用模板。`rules` 是 JSON 数组，每条
// rule 形如 { windowType, durationLabel, durationSec, metric, limitValue,
// modelGroupId? }。验证逻辑放在 service 层。
//
// 软删策略：name 在数据库层面 @unique。软删时把 name 重命名为
// `{name} (已删除 {timestamp})`，让原 name 可被复用，避免唯一约束冲突。
//
model PlanQuotaTemplate {
  id          String    @id @default(uuid())
  name        String    @unique
  description String    @default("")
  rules       String // JSON array of QuotaRule
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  quotaRules PlanQuotaRule[]

  @@index([isActive, deletedAt])
  @@map("plan_quota_templates")
}

model PlanQuotaRule {
  id         String   @id @default(uuid())
  planId     String   @map("plan_id")
  templateId String   @map("template_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  plan     Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  template PlanQuotaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([planId, templateId])
  @@index([planId, isActive])
  @@index([templateId, isActive])
  @@map("plan_quota_rules")
}

// ============================
// Phase v2 P1 / PR3: RechargeTier (充值面额)
// ============================
//
// 按量计费产品的预付充值面额配置。每个 tier 关联一个 Product，定义充值金额
// (amountCents) 与赠送策略 (bonusType + bonusValue):
//   - FIXED:   bonusValue 单位是分 (例如 1000 = ¥10 赠送)
//   - PERCENT: bonusValue 是 0-100 的整数百分比 (例如 20 = +20%)
//
// 软删策略：本表没有 @unique 字段，所以软删就是 `deletedAt = now()` + 查询时
// 过滤 deletedAt IS NULL，无需 tombstone rename。
//
// 唯一性：同一 (productId, amountCents) 允许多条 tier (用于 A/B / 限时活动等)，
// 不在 DB 层强制；service 层在创建/更新时给出"重叠告警"，但仍允许保存。
model RechargeTier {
  id          String            @id @default(uuid())
  productId   String            @map("product_id")
  amountCents Int               @map("amount_cents")
  bonusType   RechargeBonusType @map("bonus_type")
  bonusValue  Int               @map("bonus_value") // FIXED: 分; PERCENT: 0-100 整数
  badge       String?
  sortOrder   Int               @default(0) @map("sort_order")
  isActive    Boolean           @default(true) @map("is_active")
  startAt     DateTime?         @map("start_at")
  endAt       DateTime?         @map("end_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, isActive])
  @@index([startAt, endAt])
  @@index([deletedAt])
  @@map("recharge_tiers")
}

enum RechargeBonusType {
  FIXED
  PERCENT
}

// ============================
// Phase v2 P1 / PR5: CreditGrantRule (定时奖励规则) + GrantRedemption
// ============================
//
// 运营场景：
//   - "每日免费 N 积分(当天过期)" → triggerType=DAILY_CRON, expirePolicy=SAME_DAY_END
//   - "首次登录送 100 积分(永久)" → triggerType=FIRST_LOGIN, expirePolicy=PERMANENT
//   - "针对 VIP 分群每周一发 500 积分(7 天后过期)" →
//       triggerType=WEEKLY_CRON, segmentId=<vip>, expirePolicy=N_DAYS, expireDays=7
//
// 触发模型：
//   - DAILY_CRON / WEEKLY_CRON 由 BullMQ Repeatable 调度器在 0:00 / Mon 0:00
//     扫描所有 active rule 并执行（v2 P1 PR5 实现）。
//   - FIRST_LOGIN / DAILY_CHECKIN / TASK_COMPLETE 计划走事件总线，PR5 不实现，
//     字段保留供后续 PR 使用（service 层会拒绝 cronExpr 不一致的组合，但 executor
//     当前只会被 DAILY_CRON / WEEKLY_CRON 调度器调用）。
//
// 过期模型：
//   - GRANT 流水写入 credit_transactions(type=GRANT, expiresAt=...)。
//   - CreditExpireService 每天 0:30 扫描 expiresAt < now AND isExpired=false，
//     按"剩余=amount-从该 grant 已消耗"写一条 EXPIRE 反向流水(amount<0)，
//     并把 GRANT 行 isExpired 置 true，同时 GrantRedemption.isExpired=true。
//   - "从该 grant 已消耗"目前由 SUM 计算（PR5 暂不改 CreditService 扣减路径，
//     在没有 FIFO 集成的情况下，sweep 视未消耗，全额冲销）。详见 PR5 description
//     的 DEFERRED 段。
//
// 软删：deletedAt + 查询过滤；name 不强制 unique（同一活动不同周期可同名）。
model CreditGrantRule {
  id              String            @id @default(uuid())
  name            String
  triggerType     GrantTriggerType  @map("trigger_type")
  cronExpr        String?           @map("cron_expr")
  segmentId       String?           @map("segment_id")
  rewardType      GrantRewardType   @map("reward_type")
  rewardAmount    Int               @map("reward_amount")
  productId       String?           @map("product_id")
  expirePolicy    GrantExpirePolicy @map("expire_policy")
  expireDays      Int?              @map("expire_days")
  perUserLimit    Int               @default(1) @map("per_user_limit")
  globalDailyCap  Int?              @map("global_daily_cap")
  isActive        Boolean           @default(true) @map("is_active")
  startAt         DateTime?         @map("start_at")
  endAt           DateTime?         @map("end_at")
  notifyType      GrantNotifyType?  @map("notify_type")
  notifyTemplate  String?           @map("notify_template")
  lastTriggeredAt DateTime?         @map("last_triggered_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  segment     UserSegment?      @relation(fields: [segmentId], references: [id])
  redemptions GrantRedemption[]

  @@index([isActive, triggerType])
  @@index([deletedAt])
  @@map("credit_grant_rules")
}

enum GrantTriggerType {
  DAILY_CRON
  FIRST_LOGIN
  DAILY_CHECKIN
  TASK_COMPLETE
  WEEKLY_CRON
}

enum GrantRewardType {
  CREDIT
  BALANCE
  BOOSTER_PACK
}

enum GrantExpirePolicy {
  PERMANENT
  SAME_DAY_END
  N_DAYS
  NEXT_RESET
}

enum GrantNotifyType {
  INAPP
  EMAIL
  SMS
  NONE
}

model GrantRedemption {
  id         String    @id @default(uuid())
  ruleId     String    @map("rule_id")
  userId     String    @map("user_id")
  amount     Int
  // PR0-1: 已消费的额度(扣款时按 expiresAt asc 累积),amount === usedAmount 时 isUsedUp=true
  usedAmount Int       @default(0) @map("used_amount")
  expiresAt  DateTime? @map("expires_at")
  isExpired  Boolean   @default(false) @map("is_expired")
  isUsedUp   Boolean   @default(false) @map("is_used_up")
  txId       String?   @map("tx_id") // 关联的 CreditTransaction.id (GRANT 行)
  createdAt  DateTime  @default(now()) @map("created_at")

  rule CreditGrantRule @relation(fields: [ruleId], references: [id])
  user User            @relation(fields: [userId], references: [id])

  @@index([ruleId, createdAt])
  @@index([userId, expiresAt])
  @@index([userId, isExpired, isUsedUp])
  @@map("grant_redemptions")
}

// ============================
// Phase v2 P1 / PR6: Risk 三件套
// ============================

model RiskRule {
  id              String       @id @default(uuid())
  name            String
  ruleType        RiskRuleType @map("rule_type")
  config          String // JSON, 不同 ruleType 结构不同
  action          RiskAction
  isActive        Boolean      @default(true) @map("is_active")
  triggerCount    Int          @default(0) @map("trigger_count")
  lastTriggeredAt DateTime?    @map("last_triggered_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  flags       RiskFlag[]
  listEntries RiskList[]

  @@index([ruleType, isActive])
  @@index([deletedAt])
  @@map("risk_rules")
}

enum RiskRuleType {
  BLACKLIST
  USAGE_THRESHOLD
  IP_LIMIT
  REFUND_RATE
  FRAUD_PROVIDER
}

enum RiskAction {
  BLOCK
  ALERT
  DISABLE_KEY
  FREEZE_USER
}

model RiskList {
  id        String       @id @default(uuid())
  ruleId    String?      @map("rule_id")
  listType  RiskListType @map("list_type")
  value     String
  reason    String       @default("")
  addedBy   String       @map("added_by")
  expiresAt DateTime?    @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")

  rule RiskRule? @relation(fields: [ruleId], references: [id])

  @@unique([listType, value])
  @@index([listType])
  @@index([expiresAt])
  @@map("risk_lists")
}

enum RiskListType {
  EMAIL
  DOMAIN
  IP
  CARD_HASH
  USER_ID
}

model RiskFlag {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  ruleId      String?        @map("rule_id")
  ruleType    RiskRuleType   @map("rule_type")
  severity    RiskSeverity
  context     String         @default("{}") // JSON 触发详情
  status      RiskFlagStatus @default(PENDING)
  triggeredAt DateTime       @default(now()) @map("triggered_at")
  resolvedAt  DateTime?      @map("resolved_at")
  resolvedBy  String?        @map("resolved_by")
  resolveNote String?        @map("resolve_note")

  user User      @relation(fields: [userId], references: [id])
  rule RiskRule? @relation(fields: [ruleId], references: [id])

  @@index([userId, status])
  @@index([status, triggeredAt])
  @@index([ruleType])
  @@map("risk_flags")
}

enum RiskSeverity {
  HIGH
  MEDIUM
  LOW
}

enum RiskFlagStatus {
  PENDING
  CONFIRMED
  RELEASED
  PERMANENT_BAN
}

// ============================
// PR7: Ticket + TicketMessage 客服工单
// ============================

model Ticket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique @map("ticket_number") // TKT-YYYYMMDD-NNNNN
  userId       String         @map("user_id")
  subject      String
  category     TicketCategory
  priority     TicketPriority @default(NORMAL)
  status       TicketStatus   @default(OPEN)
  assigneeId   String?        @map("assignee_id") // opaque admin id from codesphere-admin
  createdAt    DateTime       @default(now()) @map("created_at")
  resolvedAt   DateTime?      @map("resolved_at")
  closedAt     DateTime?      @map("closed_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id])
  messages TicketMessage[]

  @@index([userId])
  @@index([status, priority])
  @@index([assigneeId, status])
  @@index([createdAt])
  @@map("tickets")
}

enum TicketCategory {
  BILLING
  TECHNICAL
  REFUND
  FEATURE
  OTHER
}

enum TicketPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model TicketMessage {
  id          String           @id @default(uuid())
  ticketId    String           @map("ticket_id")
  authorType  TicketAuthorType @map("author_type")
  authorId    String           @map("author_id") // user id or opaque admin id
  content     String // markdown
  attachments String           @default("[]") // JSON array of URLs
  isInternal  Boolean          @default(false) @map("is_internal")
  createdAt   DateTime         @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

enum TicketAuthorType {
  USER
  ADMIN
  SYSTEM
}

// ============================
// P2-A1: AlertEvent (事件流, 与既有 v0.3 alerts 告警规则表分离)
// ============================
//
// 表名 alert_events / model AlertEvent / enums AlertEventCategory|Severity|Status
// 路由仍用 /admin/v2/alerts (前端 stub 已固定)。
// 详见 docs/superpowers/specs/2026-04-30-admin-v2-backend-p2-alerts-design.md

model AlertEvent {
  id       String             @id @default(uuid())
  category AlertEventCategory
  severity AlertEventSeverity
  status   AlertEventStatus   @default(PENDING)

  // 事件元数据(必填)
  title   String
  message String

  // 关联实体(可选,按 category 不同来源)
  sourceType String? @map("source_type")
  sourceId   String? @map("source_id")
  userId     String? @map("user_id")

  // 上下文 JSON(供详情页结构化展示 + 二次定位)
  context String @default("{}")

  // 处理状态
  readAt     DateTime? @map("read_at")
  handledAt  DateTime? @map("handled_at")
  handledBy  String?   @map("handled_by")
  handleNote String?   @map("handle_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category, status, createdAt(sort: Desc)])
  @@index([severity, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("alert_events")
}

enum AlertEventCategory {
  PAYMENT
  CHANNEL
  USAGE
  SECURITY
  SYSTEM
}

enum AlertEventSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AlertEventStatus {
  PENDING
  READ
  HANDLED
}

// ============================
// P2-C: CreditPolicy (信用额度策略)
// ============================
//
// 仅 PAY_AS_YOU_GO 产品适用。GLOBAL 一条 + 任意条 SEGMENT 覆盖。
// service 层守住"只配 PAYG"约束;DB 层不强制。
//
// recoveryCondition / recoveryDays 落字段但 P2-C 不实现自动恢复(留 P3)。
// triggerAction 本期仅 SUSPEND 真实生效,ALERT/EMAIL 留 P3。
//
// 详见 docs/superpowers/specs/2026-04-30-admin-v2-backend-p2-credit-policy-design.md
model CreditPolicy {
  id                      String                        @id @default(uuid())
  productId               String                        @map("product_id")
  scope                   CreditPolicyScope
  segmentId               String?                       @map("segment_id")
  allowOverdraft          Boolean                       @default(false) @map("allow_overdraft")
  defaultCreditLimitCents Int                           @default(0) @map("default_credit_limit_cents")
  triggerAction           CreditPolicyTriggerAction     @default(SUSPEND) @map("trigger_action")
  recoveryCondition       CreditPolicyRecoveryCondition @default(ON_RECHARGE) @map("recovery_condition")
  recoveryDays            Int?                          @map("recovery_days")
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  segment UserSegment? @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([productId, scope, segmentId], name: "uniq_product_scope_segment")
  @@index([productId])
  @@map("credit_policies")
}

enum CreditPolicyScope {
  GLOBAL
  SEGMENT
}

enum CreditPolicyTriggerAction {
  SUSPEND
  ALERT
  EMAIL
}

enum CreditPolicyRecoveryCondition {
  ON_RECHARGE
  AFTER_DAYS
  MANUAL
}

// ============================
// P2-D: Referrals (邀请裂变)
// ============================
//
// 三表:
//   - ReferralProgram: 运营配置(奖励额度/触发条件/防作弊上限)
//   - ReferralCode:    每用户每 program 一个 8 位 BASE32 邀请码
//   - ReferralRedemption: 注册归因 + 触发记录
//
// 奖励发放复用 GrantRule(每个 program 创建时同步创建 2 条 hidden GrantRule)。
// 详见 docs/superpowers/specs/2026-04-30-admin-v2-backend-p2-referrals-design.md

model ReferralProgram {
  id              String                  @id @default(uuid())
  name            String
  inviterReward   Int                     @map("inviter_reward")
  inviteeReward   Int                     @map("invitee_reward")
  rewardCondition ReferralRewardCondition @map("reward_condition")
  productId       String?                 @map("product_id")
  trackingOnly    Boolean                 @default(false) @map("tracking_only")
  isActive        Boolean                 @default(true) @map("is_active")
  startAt         DateTime?               @map("start_at")
  endAt           DateTime?               @map("end_at")

  // 防作弊
  sameIpLimit        Int? @map("same_ip_limit")
  sameDeviceLimit    Int? @map("same_device_limit")
  perUserInviteLimit Int? @map("per_user_invite_limit")

  // 关联(每 program 同步创建 GrantRule 用于实际发奖)
  inviterGrantRuleId String? @map("inviter_grant_rule_id")
  inviteeGrantRuleId String? @map("invitee_grant_rule_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  redemptions ReferralRedemption[]
  codes       ReferralCode[]
  clicks      ReferralClick[]

  @@index([isActive, deletedAt])
  @@map("referral_programs")
}

enum ReferralRewardCondition {
  REGISTER
  FIRST_RECHARGE
  FIRST_SUBSCRIBE
}

model ReferralCode {
  id            String   @id @default(uuid())
  programId     String   @map("program_id")
  inviterUserId String   @map("inviter_user_id")
  code          String   @unique
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  program ReferralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  inviter User            @relation(fields: [inviterUserId], references: [id], onDelete: Cascade)

  @@unique([programId, inviterUserId])
  @@index([inviterUserId])
  @@map("referral_codes")
}

model ReferralRedemption {
  id              String    @id @default(uuid())
  programId       String    @map("program_id")
  codeId          String    @map("code_id")
  inviterUserId   String    @map("inviter_user_id")
  inviteeUserId   String    @map("invitee_user_id")
  triggeredAt     DateTime? @map("triggered_at")
  rewardGranted   Boolean   @default(false) @map("reward_granted")
  // P2-D review fix: 拆分 inviter / invitee 各自的发奖状态,
  // 避免 invitee 失败但 inviter 已成功导致 invitee 永远拿不到奖。
  inviterGranted  Boolean   @default(false) @map("inviter_granted")
  inviteeGranted  Boolean   @default(false) @map("invitee_granted")
  inviterIp       String?   @map("inviter_ip")
  inviteeIp       String?   @map("invitee_ip")
  inviteeDeviceId String?   @map("invitee_device_id")
  utmSource       String?   @map("utm_source")
  utmMedium       String?   @map("utm_medium")
  utmCampaign     String?   @map("utm_campaign")
  utmContent      String?   @map("utm_content")
  landingUrl      String?   @map("landing_url")
  capturedAt      DateTime? @map("captured_at")
  // 访客画像:country/city 由 inviteeIp 经 geoip-lite 就地解析;referrer 由上游采集(空=direct)
  country         String?   @map("country")
  city            String?   @map("city")
  referrer        String?   @map("referrer")
  rejectReason    String?   @map("reject_reason")
  createdAt       DateTime  @default(now()) @map("created_at")

  program ReferralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  inviter User            @relation("InviterRedemptions", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitee User            @relation("InviteeRedemptions", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@unique([programId, inviteeUserId])
  @@index([programId, triggeredAt])
  @@index([inviterUserId])
  @@map("referral_redemptions")
}

// 邀请链接点击(落地即上报,注册与否无关)。按 (programId, visitorKey) 去重:
// 每访客每程序一行,重复点击 clickCount++ 并更新 lastClickedAt。
// UV(去重点击人数)= 行数;PV(总点击)= Σ clickCount。
model ReferralClick {
  id             String   @id @default(uuid())
  programId      String   @map("program_id")
  codeId         String?  @map("code_id")
  inviterUserId  String?  @map("inviter_user_id")
  // 访客标识:前端 deviceId 优先,无则 "ip:<ip>";用于去重
  visitorKey     String   @map("visitor_key")
  ip             String?
  country        String?
  city           String?
  referrer       String?
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  utmContent     String?  @map("utm_content")
  clickCount     Int      @default(1) @map("click_count")
  firstClickedAt DateTime @default(now()) @map("first_clicked_at")
  lastClickedAt  DateTime @default(now()) @map("last_clicked_at")

  program ReferralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, visitorKey])
  @@index([programId, firstClickedAt])
  @@index([inviterUserId])
  @@map("referral_clicks")
}

// ============================
// 发票申请系统
// 仅记录"按消耗本金开票"的申请、抬头与号段。
// 事实源：Order + BalanceGrant + BalanceConsumptionAllocation；
// 发票号格式 102ISSHK + YYYY + MM + 3 位顺序号（按 entity+year+month 单调）。
// ============================

model InvoiceProfile {
