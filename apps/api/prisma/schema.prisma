// 旧账本账户可能关联已开票/已终结的 invoice。repair 不改动这些业务事实，
// 只保存数据库生成的完整、排序稳定快照及 SHA-256；promotion 在终态再次计算，
// 任一 order/application/item/event 漂移都会失败关闭。
model BalanceLedgerInvoiceStabilityRepair {
  id                   String   @id @default(uuid())
  operationKey         String   @unique @map("operation_key")
  proofVersion         Int      @default(1) @map("proof_version")
  repairKind           String   @map("repair_kind")
  runId                String   @map("run_id")
  repairAccountId      String   @unique @map("repair_account_id")
  billingAccountId     String   @map("billing_account_id")
  orderCount           BigInt   @map("order_count")
  applicationCount     BigInt   @map("application_count")
  itemCount            BigInt   @map("item_count")
  eventCount           BigInt   @map("event_count")
  evidenceSha256       String   @map("evidence_sha256")
  evidenceSnapshot     Json     @map("evidence_snapshot")
  financeApprovalRef   String   @map("finance_approval_ref")
  technicalApprovalRef String   @map("technical_approval_ref")
  createdAt            DateTime @default(now()) @map("created_at")

  run            BalanceLedgerRepairRun     @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bl_invoice_stability_repairs_run_fkey")
  repairAccount  BalanceLedgerRepairAccount @relation(fields: [repairAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bl_invoice_stability_repairs_repair_fkey")
  billingAccount BillingAccount             @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bl_invoice_stability_repairs_account_fkey")

  @@unique([runId, billingAccountId], map: "bl_invoice_stability_repairs_run_account_key")
  @@index([billingAccountId, createdAt], map: "bl_invoice_stability_repairs_account_created_idx")
  @@map("balance_ledger_invoice_stability_repairs")
}

// 旧企业管理员资金入口留下的直接 COMMITTED 回执，是把历史正向流水恢复为
// canonical funding 的唯一授权。CREATE_GRANT 保存拟创建批次的完整终态快照；
// LINK_GRANT 保存既有批次的修复前快照及回放后的 canonical remaining 三元组。
// balanceGrantId 刻意不建 FK，使 CREATE proof 能先于受保护的 grant INSERT
// 落库；deferred terminal validator 保证 proof 与最终批次在同一事务内闭合。
model BalanceLedgerAdminFundingRepair {
  id                               String   @id @default(uuid())
  operationKey                     String   @unique @map("operation_key")
  proofVersion                     Int      @default(1) @map("proof_version")
  proofHash                        String   @map("proof_hash")
  repairKind                       String   @map("repair_kind")
  action                           String
  runId                            String   @map("run_id")
  repairAccountId                  String   @map("repair_account_id")
  billingAccountId                 String   @map("billing_account_id")
  balanceTransactionId             String   @unique(map: "balance_ledger_admin_funding_repairs_transaction_key") @map("balance_transaction_id")
  balanceGrantId                   String   @unique(map: "balance_ledger_admin_funding_repairs_grant_key") @map("balance_grant_id")
  idempotencyKey                   String   @map("idempotency_key")
  idempotencyScope                 String   @map("idempotency_scope")
  idempotencySnapshot              Json     @map("idempotency_snapshot")
  transactionSnapshot              Json     @map("transaction_snapshot")
  grantSnapshot                    Json     @map("grant_snapshot")
  canonicalRemainingAmountUsd      Decimal  @map("canonical_remaining_amount_usd") @db.Decimal(20, 12)
  canonicalRemainingPaidAmountUsd  Decimal  @map("canonical_remaining_paid_amount_usd") @db.Decimal(20, 12)
  canonicalRemainingBonusAmountUsd Decimal  @map("canonical_remaining_bonus_amount_usd") @db.Decimal(20, 12)
  createdAt                        DateTime @default(now()) @map("created_at")

  run                BalanceLedgerRepairRun     @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_admin_funding_repairs_run_fkey")
  repairAccount      BalanceLedgerRepairAccount @relation(fields: [repairAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_admin_funding_repairs_repair_fkey")
  billingAccount     BillingAccount             @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_admin_funding_repairs_account_fkey")
  balanceTransaction BalanceTransaction         @relation(fields: [balanceTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "balance_ledger_admin_funding_repairs_transaction_fkey")

  @@unique([runId, billingAccountId, balanceTransactionId], map: "balance_ledger_admin_funding_repairs_run_tx_key")
  @@unique([idempotencyKey, idempotencyScope], map: "balance_ledger_admin_funding_repairs_receipt_key")
  @@index([billingAccountId, createdAt], map: "balance_ledger_admin_funding_repairs_account_created_idx")
  @@map("balance_ledger_admin_funding_repairs")
}

// One drained, maker/checker-controlled operation may correct a proven legacy
// currency label. It never converts a monetary value. PostgreSQL owns the
// exact manifest and append-only audit contract installed by the migration.
model BillingAccountCurrencyLabelRepairRun {
  id                       String   @id @default(uuid())
  manifestVersion          String   @unique(map: "billing_account_currency_label_repair_runs_manifest_key") @map("manifest_version")
  manifestHash             String   @map("manifest_hash")
  databaseName             String   @map("database_name")
  databaseIdentity         String   @map("database_identity") @db.Uuid
  databaseSystemIdentifier Decimal  @map("database_system_identifier") @db.Decimal(20, 0)
  databaseOid              BigInt   @map("database_oid")
  sourceCurrency           String   @map("source_currency")
  targetCurrency           String   @map("target_currency")
  platformConfigSnapshot   Json     @map("platform_config_snapshot")
  platformConfigHash       String   @map("platform_config_hash")
  changeTicket             String   @map("change_ticket")
  operator                 String
  approverOne              String   @map("approver_one")
  approverTwo              String   @map("approver_two")
  evidenceSha256           String   @map("evidence_sha256")
  confirmation             String
  writersDrainedUntil      DateTime @map("writers_drained_until")
  accountCount             Int      @map("account_count")
  status                   String
  appliedAt                DateTime @map("applied_at")
  createdAt                DateTime @default(now()) @map("created_at")

  items BillingAccountCurrencyLabelRepairItem[]
  eligibleEvents BillingAccountCurrencyLabelRepairEligibleEvent[]

  @@map("billing_account_currency_label_repair_runs")
}

model BillingAccountCurrencyLabelRepairItem {
  id                        String   @id @default(uuid())
  runId                     String   @map("run_id")
  billingAccountId          String   @unique(map: "billing_account_currency_label_repair_items_account_key") @map("billing_account_id")
  ordinal                   Int
  beforeCurrency            String   @map("before_currency")
  afterCurrency             String   @map("after_currency")
  beforeAccountSnapshot     Json     @map("before_account_snapshot")
  beforeAccountSnapshotHash String   @map("before_account_snapshot_hash")
  afterAccountSnapshot      Json     @map("after_account_snapshot")
  afterAccountSnapshotHash  String   @map("after_account_snapshot_hash")
  financialSnapshot         Json     @map("financial_snapshot")
  financialSnapshotHash     String   @map("financial_snapshot_hash")
  createdAt                 DateTime @default(now()) @map("created_at")

  run            BillingAccountCurrencyLabelRepairRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "billing_account_currency_label_repair_items_run_fkey")
  billingAccount BillingAccount                       @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "billing_account_currency_label_repair_items_account_fkey")
  eligibleEvents BillingAccountCurrencyLabelRepairEligibleEvent[]

  @@unique([runId, ordinal], map: "billing_account_currency_label_repair_items_run_ordinal_key")
  @@unique([runId, billingAccountId], map: "billing_account_currency_label_repair_items_run_account_key")
  @@map("billing_account_currency_label_repair_items")
}

// Exact legacy Gateway events authorized for the post-repair zero-value
// terminal workflow. Account-level proof alone must never authorize another
// event on the same API key, tenant or billing account.
model BillingAccountCurrencyLabelRepairEligibleEvent {
  id                    String   @id(map: "billing_currency_repair_events_pkey") @default(uuid())
  runId                 String   @map("run_id")
  itemId                String   @map("item_id")
  gatewayBillingEventId String   @unique(map: "billing_currency_repair_events_event_key") @map("gateway_billing_event_id")
  requestId             String   @unique(map: "billing_currency_repair_events_request_key") @map("request_id")
