  checkoutSessionId         String?   @map("checkout_session_id")
  subscriptionId            String?   @map("subscription_id")
  invoiceId                 String?   @map("invoice_id")
  paymentIntentId           String?   @map("payment_intent_id")
  chargeId                  String?   @map("charge_id")
  refundId                  String?   @unique @map("refund_id")
  balanceTransactionId      String?   @unique @map("balance_transaction_id")
  payoutId                  String?   @map("payout_id")
  stripeEventId             String?   @map("stripe_event_id")
  amountCents               Int?      @map("amount_cents")
  feeCents                  Int?      @map("fee_cents")
