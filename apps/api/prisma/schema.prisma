generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================
// Phase 2: 用户镜像
// ============================

model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  phone           String?   @unique
  nickname        String    @default("")
  avatar          String?
  isActive        Boolean   @default(true) @map("is_active")
  sourceUpdatedAt DateTime? @map("source_updated_at")
  mirroredAt      DateTime? @map("mirrored_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  currentTenantId String?   @map("current_tenant_id")

  orders                        Order[]
  apiKeys                       ApiKey[]
  billingAccountsOwned          BillingAccount[]               @relation("BillingAccountOwner")
  billingAccountMemberships     BillingAccountMember[]         @relation("BillingAccountMemberUser")
  balanceTransactions           BalanceTransaction[]
  balanceGrants                 BalanceGrant[]
  balanceConsumptionAllocations BalanceConsumptionAllocation[]
  creditTransactions            CreditTransaction[]
  creditBalanceStates           CreditBalanceState[]
  conversations                 Conversation[]
  ownedMembers                  TeamMember[]                   @relation("TeamOwner")
  teamMemberships               TeamMember[]                   @relation("TeamMember")
  ownedTenants                  Tenant[]                       @relation("TenantOwner")
  currentTenant                 Tenant?                        @relation("CurrentTenant", fields: [currentTenantId], references: [id], onDelete: SetNull)
  tenantMembershipsV2           TenantMember[]                 @relation("TenantMembershipUser")
  tenantInvitesSent             TenantInvite[]                 @relation("TenantInviteInviter")
  subscriptions                 UserSubscription[]
  subscriptionContracts         SubscriptionContract[]
  subscriptionPeriods           SubscriptionPeriod[]
  subscriptionEntitlements      SubscriptionEntitlement[]
  segmentMemberships            UserSegmentMember[]
  grantRedemptions              GrantRedemption[]
  riskFlags                     RiskFlag[]
  tickets                       Ticket[]
  alertEvents                   AlertEvent[]
  referralCodes                 ReferralCode[]
  inviterRedemptions            ReferralRedemption[]           @relation("InviterRedemptions")
  inviteeRedemptions            ReferralRedemption[]           @relation("InviteeRedemptions")
  usagePricingPolicies          UsagePricingPolicy[]
  invoiceProfiles               InvoiceProfile[]
  invoiceApplications           InvoiceApplication[]
  productExternalBinding        ProductExternalUserBinding?
  gatewayUsageSettlementAnchors GatewayUsageSettlementAnchor[]

  @@index([currentTenantId])
  @@map("users")
}

// Growth measurement facts are derived from authoritative billing/user events.
// They remain queryable even when analytics consent is absent or GA4 is not configured.
model GrowthEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  eventName            String   @map("event_name")
  dedupeKey            String   @unique @map("dedupe_key")
  userId               String?  @map("user_id")
  source               String
  sourceEventId        String?  @map("source_event_id")
  occurredAt           DateTime @map("occurred_at")
  analyticsConsent     Boolean  @default(false) @map("analytics_consent")
  analyticsClientId    String?  @map("analytics_client_id")
  attribution          Json?
  payload              Json
  deliveryStatus       String   @default("PENDING") @map("delivery_status")
  deliveryAttempts     Int      @default(0) @map("delivery_attempts")
  lastDeliveryAttemptAt DateTime? @map("last_delivery_attempt_at")
  deliveredAt          DateTime? @map("delivered_at")
  lastError             String?  @map("last_error")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([eventName, occurredAt])
  @@index([userId, eventName])
  @@index([deliveryStatus, createdAt])
  @@map("growth_events")
}

// ============================
// Billing account
// 账务主体。当前产品只创建 personal 账务账户；企业账户以后复用同一抽象。
// ============================

model BillingAccount {
  id          String    @id @default(uuid())
  type        String    @default("personal") // personal / enterprise
  name        String
  ownerUserId String?   @map("owner_user_id")
  status      String    @default("active") // active / suspended / deleted
  // Required explicitly by every account-provisioning boundary. A database
  // default would silently turn a missing deployment decision into USD.
  currency    String
  // 企业主体快照(M0 additive, 见 20260703000100_enterprise_account_foundation)。
  // 权威主体归属仍在 user 服务,billing 仅存快照 + verificationId 回链。
  enterpriseName String?   @map("enterprise_name")
  uscc           String?   @map("uscc")
  verificationId String?   @map("verification_id")
  verifiedAt     DateTime? @map("verified_at")
  // 企业开通回收的**派生**屏障缓存（议题二批一）。权威屏障是 EnterpriseProvisioningTombstone；
  // 本列供已持有账户行的热写点（attach / owner-members / snapshot）做 O(1) 检查。
  // 单调：只由 void-provisioning 以 COALESCE(..., now()) 置一次，批一无任何清除路径。
  provisioningQuarantinedAt DateTime? @map("provisioning_quarantined_at")
  // 批次账本只有经过 V2 回放校验后才允许自动过期。存量账户默认 DIRTY，
  // 新账户由创建路径显式置为 RECONCILED_V2；任何无法归类的余额写入会降级为 DIRTY。
  balanceGrantLedgerStatus               String    @default("LEGACY_DIRTY") @map("balance_grant_ledger_status")
  balanceGrantLedgerVersion              Int       @default(0) @map("balance_grant_ledger_version")
  balanceGrantLedgerHash                 String?   @map("balance_grant_ledger_hash")
  balanceGrantLedgerReconciledAt         DateTime? @map("balance_grant_ledger_reconciled_at")
  balanceGrantLedgerDirtyReason          String?   @map("balance_grant_ledger_dirty_reason")
  balanceGrantLedgerThroughTransactionId String?   @map("balance_grant_ledger_through_transaction_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  owner                         User?                          @relation("BillingAccountOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  wallet                        AccountWallet?
  creditConfig                  BillingAccountCreditConfig?
  creditEvents                  BillingAccountCreditEvent[]
  members                       BillingAccountMember[]
  tenants                       Tenant[]
  orders                        Order[]
  balanceTransactions           BalanceTransaction[]
  balanceGrants                 BalanceGrant[]
  balanceConsumptionAllocations BalanceConsumptionAllocation[]
  enterpriseCreditSettlements   EnterpriseCreditSettlement[]
  gatewayUsageFundingReservations            GatewayUsageFundingReservation[]
  balanceGrantExpiries          BalanceGrantExpiry[]
  balanceGrantRefunds           BalanceGrantRefund[]
  balanceLedgerRepairAccounts   BalanceLedgerRepairAccount[]
  balanceLedgerAllocationRepairs BalanceLedgerAllocationRepair[]
  balanceLedgerTransactionRepairs BalanceLedgerTransactionRepair[]
  balanceLedgerGrantComponentRepairs BalanceLedgerGrantComponentRepair[]
  balanceLedgerGrantRetirementRepairs BalanceLedgerGrantRetirementRepair[]
  balanceLedgerPersonalDebtAllocationRepairs BalanceLedgerPersonalDebtAllocationRepair[]
  balanceLedgerVoucherFundingRepairs BalanceLedgerVoucherFundingRepair[]
  balanceLedgerLegacyExpiryRepairs BalanceLedgerLegacyExpiryRepair[]
  balanceLedgerInvoiceStabilityRepairs BalanceLedgerInvoiceStabilityRepair[]
  outgoingLedgerTransferRepairs BalanceLedgerAccountTransferRepair[] @relation("BalanceLedgerTransferSourceAccount")
  incomingLedgerTransferRepairs BalanceLedgerAccountTransferRepair[] @relation("BalanceLedgerTransferTargetAccount")
  ledgerGrantCreationRepairs    BalanceLedgerGrantCreationRepair[]
  ledgerAdminFundingRepairs     BalanceLedgerAdminFundingRepair[]
  currencyLabelRepairItems      BillingAccountCurrencyLabelRepairItem[]
  enterpriseModelDiscounts      EnterpriseModelDiscount[]
  subscriptionContracts         SubscriptionContract[]
  subscriptionPeriods           SubscriptionPeriod[]
  subscriptionEntitlements      SubscriptionEntitlement[]
  gatewayUsageSettlementAnchors              GatewayUsageSettlementAnchor[]
  enterpriseBillMonthSummaries               EnterpriseBillMonthSummary[]
  enterpriseFundingSnapshot                  EnterpriseFundingSnapshot?

  @@index([ownerUserId])
  @@index([type, status])
  @@index([balanceGrantLedgerStatus])
  @@index([verificationId])
  @@index([uscc])
  @@map("billing_accounts")
}

model AccountWallet {
  billingAccountId String   @id @map("billing_account_id")
  balanceUsd       Decimal  @default(0) @map("balance_usd") @db.Decimal(20, 12)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@map("account_wallets")
}

// 企业信用额度配置。货币语义：所有 ×_usd 金额列实际存「平台货币」金额
// （国内=CNY、国际=USD，见 docs/enterprise-credit.zh-CN.md §2），不做汇率换算。
// 状态语义（§3）：ACTIVE=正常授信；SUSPENDED=冻结可恢复（账期逾期自动进入）；
// DISABLED=关闭授信。SUSPENDED/DISABLED 有效额度均为 0，区别在运营流程。
model BillingAccountCreditConfig {
  billingAccountId String    @id @map("billing_account_id")
  limitUsd         Decimal   @default(0) @map("limit_usd") @db.Decimal(20, 12)
  status           String    @default("DISABLED") // ACTIVE / DISABLED / SUSPENDED
  // Monotonic application revision. Revision 0 is legacy/unproven history;
  // every post-migration mutation advances it while holding the account lock.
  policyRevision            Int       @default(0) @map("policy_revision")
  policyEffectiveBoundaryAt DateTime? @map("policy_effective_boundary_at")
  policyBoundaryComplete    Boolean   @default(false) @map("policy_boundary_complete")
  termsDays        Int?      @map("terms_days")
  effectiveAt      DateTime? @map("effective_at")
  expiresAt        DateTime? @map("expires_at")
  updatedBy        String?   @map("updated_by")
  note             String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([expiresAt])
  @@map("billing_account_credit_configs")
}

model BillingAccountCreditEvent {
  id               String   @id @default(uuid())
  billingAccountId String   @map("billing_account_id")
  oldLimitUsd      Decimal? @map("old_limit_usd") @db.Decimal(20, 12)
  newLimitUsd      Decimal  @map("new_limit_usd") @db.Decimal(20, 12)
  oldStatus        String?  @map("old_status")
  newStatus        String   @map("new_status")
  oldTermsDays     Int?     @map("old_terms_days")
  newTermsDays     Int?     @map("new_terms_days")
  oldEffectiveAt             DateTime? @map("old_effective_at")
  newEffectiveAt             DateTime? @map("new_effective_at")
  oldExpiresAt     DateTime? @map("old_expires_at")
  newExpiresAt     DateTime? @map("new_expires_at")
  temporalSnapshotComplete   Boolean   @default(false) @map("temporal_snapshot_complete")
  // The mutation transaction records policyDecisionAt after taking the
  // wallet/account locks. A second transaction, which can only begin after
  // that mutation commits, records policyEffectiveBoundaryAt. This gives
  // delayed settlement a conservative, provable visibility boundary instead
  // of relying on created_at/updated_at transaction timestamps.
  policyRevision             Int?      @map("policy_revision")
  policyDecisionAt           DateTime? @map("policy_decision_at")
  policyEffectiveBoundaryAt  DateTime? @map("policy_effective_boundary_at")
  policyBoundaryComplete     Boolean   @default(false) @map("policy_boundary_complete")
  requestFingerprint         String?   @map("request_fingerprint")
  // Set only after every account Key balance refresh has either been accepted
  // by Publisher or durably queued by PublisherSyncService. This applies to
  // every policy revision (admin, overdue, bootstrap), not only suspensions.
  policyFanoutEnqueuedAt     DateTime? @map("policy_fanout_enqueued_at")
  // Future effective/expiry boundaries need their own durable projection
  // markers. The immediate policy fanout above cannot make a cached Gateway
  // balance change by itself when wall-clock time later crosses the window.
  activationFanoutEnqueuedAt DateTime? @map("activation_fanout_enqueued_at")
  expirationFanoutEnqueuedAt DateTime? @map("expiration_fanout_enqueued_at")
  actorId          String?  @map("actor_id")
  reason           String?
  note             String?
  idempotencyKey   String?  @unique @map("idempotency_key")
  createdAt        DateTime @default(now()) @map("created_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  gatewayFundingReservations GatewayUsageFundingReservation[]

  @@unique([billingAccountId, policyRevision], map: "billing_account_credit_events_account_revision_key")
  @@index([billingAccountId, createdAt])
  @@index([billingAccountId, policyEffectiveBoundaryAt, policyRevision], map: "billing_account_credit_events_effective_boundary_idx")
  @@index([billingAccountId, policyDecisionAt, policyRevision], map: "billing_account_credit_events_decision_boundary_idx")
  @@index([policyBoundaryComplete, policyFanoutEnqueuedAt, billingAccountId, policyRevision], map: "billing_account_credit_events_pending_fanout_idx")
  @@index([createdAt])
  @@map("billing_account_credit_events")
}

model BillingAccountMember {
  id               String   @id @default(uuid())
  billingAccountId String   @map("billing_account_id")
  userId           String   @map("user_id")
  role             String   @default("owner") // owner / member
  status           String   @default("active") // active / inactive
  joinedAt         DateTime @default(now()) @map("joined_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  user           User           @relation("BillingAccountMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, userId])
  @@index([userId])
  @@index([billingAccountId, role])
  @@map("billing_account_members")
}

// ============================
// Identity / Tenant
// 后端统一使用 tenant，前端展示为 team/workspace。
// ============================

model Tenant {
  id                      String    @id @default(uuid())
  name                    String
  slug                    String?   @unique
  type                    String    @default("personal") // personal / team / enterprise
  status                  String    @default("active") // active / suspended / deleted
  ownerUserId             String    @map("owner_user_id")
  billingAccountId        String?   @map("billing_account_id")
  balanceAllowanceUsd     Decimal?  @map("balance_allowance_usd") @db.Decimal(20, 12)
  balanceAllowanceUsedUsd Decimal   @default(0) @map("balance_allowance_used_usd") @db.Decimal(20, 12)
  sourceUpdatedAt         DateTime? @map("source_updated_at")
  mirroredAt              DateTime? @map("mirrored_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  owner                         User                           @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  billingAccount                BillingAccount?                @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  currentForUsers               User[]                         @relation("CurrentTenant")
  members                       TenantMember[]
  invites                       TenantInvite[]
  productEntitlements           TenantProductEntitlement[]
  apiKeys                       ApiKey[]
  tokenUsages                   TokenUsage[]
  subscriptions                 UserSubscription[]
  subscriptionContracts         SubscriptionContract[]
  subscriptionPeriods           SubscriptionPeriod[]
  subscriptionEntitlements      SubscriptionEntitlement[]
  orders                        Order[]
  balanceTransactions           BalanceTransaction[]
  balanceGrants                 BalanceGrant[]
  balanceConsumptionAllocations BalanceConsumptionAllocation[]
  creditTransactions            CreditTransaction[]
  invoiceApplications           InvoiceApplication[]
  invoiceProfiles               InvoiceProfile[]
  productExternalBindings       ProductExternalTenantBinding[]
  gatewayUsageSettlementAnchors GatewayUsageSettlementAnchor[]

  @@index([ownerUserId])
  @@index([billingAccountId])
  @@index([status])
  @@map("tenants")
}

model TenantMember {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      String   @default("member") // owner / member
  status    String   @default("active") // active / inactive
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("TenantMembershipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
  @@map("tenant_members")
}

model TenantInvite {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  email           String
  role            String    @default("member")
  status          String    @default("accepted") // pending / accepted / revoked / expired
  invitedByUserId String?   @map("invited_by_user_id")
  tokenHash       String?   @unique @map("token_hash")
  expiresAt       DateTime? @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter User?  @relation("TenantInviteInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([email])
  @@map("tenant_invites")
}

model TenantProductEntitlement {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  productId String    @map("product_id")
  planId    String?   @map("plan_id")
  status    String    @default("active") // trialing / active / suspended / expired
  source    String    @default("system")
  startedAt DateTime  @default(now()) @map("started_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  plan    Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([tenantId, productId])
  @@index([productId, status])
  @@index([tenantId, status])
  @@map("tenant_product_entitlements")
}

// Partner OpenAPI identities live in an external product namespace. External
// ids must never be used as billing's global User/Tenant primary keys.
model ProductExternalUserBinding {
  id               String   @id @default(uuid())
  productId        String   @map("product_id")
  externalUserId   String   @map("external_user_id")
  // User-level grants are global, so one internal User can belong to only one
  // Partner product identity namespace.
  userId           String   @unique(map: "product_external_user_bindings_user_id_key") @map("user_id")
  snapshotWritable Boolean  @default(true) @map("snapshot_writable")
  email             String?
  phone             String?
  nickname          String?
  sourceUpdatedAt   DateTime? @map("source_updated_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([productId, externalUserId])
  @@map("product_external_user_bindings")
}

model ProductExternalTenantBinding {
  id                           String    @id @default(uuid())
  productId                    String    @map("product_id")
  bindingKey                   String    @map("binding_key")
  externalTenantId             String?   @map("external_tenant_id")
  tenantId                     String    @map("tenant_id")
  snapshotWritable             Boolean   @default(true) @map("snapshot_writable")
  provisioningLeaseId          String?   @map("provisioning_lease_id")
  provisioningLeaseExpiresAt   DateTime? @map("provisioning_lease_expires_at")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([productId, bindingKey])
  @@unique([productId, externalTenantId], map: "product_ext_tenant_product_external_id_key")
  @@unique([productId, tenantId])
  @@index([tenantId])
  @@index([provisioningLeaseExpiresAt], map: "product_ext_tenant_provision_lease_expiry_idx")
  @@map("product_external_tenant_bindings")
}

model SaasProvisionReceipt {
  id                 String    @id @default(uuid())
  productId          String    @map("product_id")
  idempotencyKey     String    @map("idempotency_key")
  requestFingerprint String    @map("request_fingerprint")
  status             String    @default("PENDING")
  result             Json?
  leaseId            String?   @map("lease_id")
  leaseExpiresAt     DateTime? @map("lease_expires_at")
  lastError          String?   @map("last_error")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptionPeriod SubscriptionPeriod?
  codingPlanEntitlement CodingPlanEntitlement?

  @@unique([productId, idempotencyKey])
  @@index([status, leaseExpiresAt])
  @@map("saas_provision_receipts")
}

// ============================
// 产品与计费
// ============================

model Product {
  id                        String                     @id @default(uuid())
  name                      String // "AI 对话", "AI 编程"
  slug                      String                     @unique // "ai-chat", "ai-coding"
  description               String                     @default("")
  icon                      String? // icon URL or emoji
  webhookUrl                String?                    @map("webhook_url") // SaaS 后端同步回调地址
  defaultPlanId             String?                    @map("default_plan_id") // SaaS provision 自动开通默认套餐
  integrationTokenHash      String?                    @unique @map("integration_token_hash") // 产品级接入令牌 hash
  integrationTokenPrefix    String?                    @map("integration_token_prefix")
  integrationTokenRotatedAt DateTime?                  @map("integration_token_rotated_at")
  webhookSecretEncrypted    String?                    @map("webhook_secret_encrypted")
  webhookSecretPrefix       String?                    @map("webhook_secret_prefix")
  webhookSecretRotatedAt    DateTime?                  @map("webhook_secret_rotated_at")
  allowedPaymentCallbackOrigins Json?                  @map("allowed_payment_callback_origins")
  // 计费模式: SUBSCRIPTION(订阅+月度积分) / PAY_AS_YOU_GO(按量+预付余额) / CODING_PLAN(订阅+5h/7d 窗口配额)
  billingMode               ProductBillingMode         @default(SUBSCRIPTION) @map("billing_mode")
  // CODING_PLAN 子类型：自营套餐 / 供应商转售。非 CODING_PLAN 产品为空。
  codingPlanFulfillmentMode CodingPlanFulfillmentMode? @map("coding_plan_fulfillment_mode")
  isActive                  Boolean                    @default(true) @map("is_active")
  sortOrder                 Int                        @default(0) @map("sort_order")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  deletedAt                 DateTime?                  @map("deleted_at")

  plans                         Plan[]
  boosterPacks                  BoosterPack[]
  subscriptions                 UserSubscription[]
  subscriptionContracts         SubscriptionContract[]
  subscriptionPeriods           SubscriptionPeriod[]
  subscriptionEntitlements      SubscriptionEntitlement[]
  campaigns                     Campaign[]
  bundleItems                   BundleSkuItem[]
  orderItems                    OrderItem[]
  rechargeTiers                 RechargeTier[]
  creditPolicies                CreditPolicy[]
  orders                        Order[]
  balanceGrants                 BalanceGrant[]
  balanceConsumptionAllocations BalanceConsumptionAllocation[]
  balanceTransactions           BalanceTransaction[]
  creditTransactions            CreditTransaction[]
  apiKeys                       ApiKey[]
  tokenUsages                   TokenUsage[]
  paygModelPricingPolicies      PaygModelPricingPolicy[]
  productModelAvailabilities    ProductModelAvailability[]
  usagePricingPolicies          UsagePricingPolicy[]
  enterpriseModelDiscounts      EnterpriseModelDiscount[]
  providerModelCostPolicies     ProviderModelCostPolicy[]
  tenantEntitlements            TenantProductEntitlement[]
  runtimePolicy                 ProductRuntimePolicy?
  productChannels               ProductChannel[]
  channelGroups                 ProductChannelGroup[]
  routeAssignments              RouteAssignment[]
  externalUserBindings          ProductExternalUserBinding[]
  externalTenantBindings        ProductExternalTenantBinding[]
  saasProvisionReceipts         SaasProvisionReceipt[]
  gatewayUsageSettlementAnchors GatewayUsageSettlementAnchor[]

