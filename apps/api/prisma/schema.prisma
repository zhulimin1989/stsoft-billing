model ModelPricing {
  id                   String   @id @default(uuid())
  modelName            String   @unique @map("model_name")
  inputPricePerMToken  Decimal  @default(1) @map("input_price_per_m_token") @db.Decimal(18, 8) // USD per 1M input tokens
  outputPricePerMToken Decimal  @default(1) @map("output_price_per_m_token") @db.Decimal(18, 8) // USD per 1M output tokens
  isActive             Boolean  @default(true) @map("is_active")
  // 结算取价窗口，半开区间 [startsAt, endsAt)。与 isActive **分工不同，不可互相替代**：
  //   - isActive 是数据面开关：publisher 的 runtimeActiveModelNames / productModelAvailability
  //     投影按它剔除网关目录，客户新请求随即拿到网关的 400 model_not_found。
  //   - 时间窗只服务结算重放：结算按事件 occurredAt 取价，不看 isActive。
  // 下架动作必须**两者同写**（isActive=false + endsAt=now()）——只写 endsAt 会留着网关目录不删，
  // 只写 isActive 则让仍在 Kafka 里积压的历史事件报不出价，被推进 settlement_anchor_missing
  // 人工隔离并连带封掉客户 Key（2026-09-07 国内 prod 事故，9,622 笔）。
  startsAt             DateTime  @default(now()) @map("starts_at")
  endsAt               DateTime? @map("ends_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // ─── v2 catalog fields (PR4) — all nullable, no breakage of existing rows ───
  provider          String?   @map("provider") // openai/anthropic/qwen/deepseek/google/mistral/zhipu/other
  modelId           String?   @map("model_id") // User-facing catalog name; falls back to modelName when null.
  description       String? // markdown
  inputModalities   String?   @map("input_modalities") // JSON array: ["text","image",...]
  outputModalities  String?   @map("output_modalities")
  contextLength     Int?      @map("context_length")
  maxOutputTokens   Int?      @map("max_output_tokens")
  providerLogo      String?   @map("provider_logo") // URL
  isPublished       Boolean   @default(false) @map("is_published")
  displayOrder      Int       @default(0) @map("display_order")
  releaseAt         DateTime? @map("release_at")
  tags              String? // JSON array of strings
  supportedFeatures String?   @map("supported_features") // JSON array
  cachedInputPrice  Decimal?  @map("cached_input_price_cents") @db.Decimal(18, 8)
  batchDiscount     Float?    @map("batch_discount") // 0..1

  // ─── v2.1: 通用模型目录字段 ───
  // chat/embedding/rerank/image/audio/video/multimodal/task；用于区分非 LLM 模型。
  modelType       String?  @map("model_type")
  // token_1m/image/video_second/video_task/audio_second/character/request/custom 等。
  pricingUnit     String?  @map("pricing_unit")
  // 非 token 计价单价，单位由 pricingUnit 决定，美元计。
  unitPriceUsd    Decimal? @map("unit_price_usd") @db.Decimal(18, 8)
  // 厂商特有规格，如分辨率、时长档、异步任务端点等。
  pricingMetadata Json?    @map("pricing_metadata")

  // ─── v3 fields(2026-05-02): 各厂商定价维度与模型元数据 ───
  // 单位说明:所有 *Price 字段均为"美元 / 1M token"
  //   例:GPT-5.4 input $2.50/M = 2.5
  //   例:Anthropic Haiku cache read $0.10/M = 0.1
  //
  // Cache 写入价(Anthropic 区分 5min vs 1h,OpenAI 不收写价)
  cacheWrite5minPrice Decimal? @map("cache_write_5min_price_cents") @db.Decimal(18, 8)
  cacheWrite1hPrice   Decimal? @map("cache_write_1h_price_cents") @db.Decimal(18, 8)
  minCacheTokens      Int?     @map("min_cache_tokens") // Anthropic Sonnet 2048 / Opus 4096

  // 长上下文阈值切档(Gemini 2.5/3 Pro 200K)
  longContextThreshold   Int?     @map("long_context_threshold") // 如 200000
  longContextInputPrice  Decimal? @map("long_context_input_price_cents") @db.Decimal(18, 8)
  longContextOutputPrice Decimal? @map("long_context_output_price_cents") @db.Decimal(18, 8)

  // 多模态(Gemini)
  audioInputPrice  Decimal? @map("audio_input_price_cents") @db.Decimal(18, 8) // 通常 2-7x base
  imageInputPrice  Decimal? @map("image_input_price_cents") @db.Decimal(18, 8) // 按 token
  imageOutputPrice Decimal? @map("image_output_price_cents") @db.Decimal(18, 8)

  // 推理 token(OpenAI o1 / o3 reasoning)
  reasoningOutputPrice Decimal? @map("reasoning_output_price_cents") @db.Decimal(18, 8)

  // 折扣 / 加价倍数
  fastModeMultiplier        Float? @map("fast_mode_multiplier") // Anthropic Opus fast 6.0
  regionResidencyMultiplier Float? @map("region_residency_multiplier") // OpenAI/Anthropic 1.1
  offPeakDiscountPct        Float? @map("off_peak_discount_pct") // DeepSeek 0..1

  // 维护元数据(运营校准/历史导入)
  pricingSource   String?   @map("pricing_source") // e.g. 'manual' | 'official' | legacy import source
  pricingSyncedAt DateTime? @map("pricing_synced_at")
  pricingFrozen   Boolean   @default(false) @map("pricing_frozen") // 校准后冻结,后续批量覆盖跳过

  // batch 是否分别影响 input / output(部分厂商不对称)
  batchInputDiscount  Float? @map("batch_input_discount") // 0..1
  batchOutputDiscount Float? @map("batch_output_discount")

  // ─── v4(2026-05-03): 调用层默认值 ───
  // 这些字段控制下游真正调用上游时的默认参数，不是定价。运营在模型库设全平台默认，
  // channel.modelConfigs 可逐 channel override。下游 sync 出口会做合并。
  // maxOutputTokens 已存在(v2)，复用。
  //
  // 注意：reasoning_effort 不放这里 — 它是用户/请求级参数（每次调用 OpenAI o-系列
  // 时由 agent 传），不属于平台/channel 默认配置。
  defaultThinkingMode   String? @map("default_thinking_mode") // disabled | enabled | auto
  defaultThinkingBudget Int?    @map("default_thinking_budget") // 0..32768 tokens

  priceTiers ModelPricingTier[]
  productModelAvailabilities ProductModelAvailability[]
  enterpriseModelDiscounts EnterpriseModelDiscount[]

  @@index([provider, isPublished])
  @@index([displayOrder])
  @@map("model_pricing")
}

model ModelPricingTier {
  id                      String   @id @default(uuid())
  modelPricingId          String   @map("model_pricing_id")
  tierKey                 String   @map("tier_key")
  displayName             String?  @map("display_name")
  minInputTokens          Int      @default(0) @map("min_input_tokens")
  maxInputTokensExclusive Int?     @map("max_input_tokens_exclusive")
  inputPricePerMToken     Decimal  @map("input_price_per_m_token") @db.Decimal(18, 8)
  outputPricePerMToken    Decimal  @map("output_price_per_m_token") @db.Decimal(18, 8)
  cachedInputPrice        Decimal? @map("cached_input_price") @db.Decimal(18, 8)
  cacheWritePrice         Decimal? @map("cache_write_price") @db.Decimal(18, 8)
  currency                String   @default("USD")
  rawCondition            String?  @map("raw_condition")
  source                  String?
  priority                Int      @default(0)
  isActive                Boolean  @default(true) @map("is_active")
  // OFF_PEAK 时段档的高峰窗口（[{days,start,end}]，Asia/Shanghai，左闭右开）。
  // 仅 tierKey='OFF_PEAK' 使用且写侧必填；列可空以兼容脏数据 fail-safe（读侧 parseBandScheduleSafely）。
  bandSchedule            Json?    @map("band_schedule")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  modelPricing ModelPricing @relation(fields: [modelPricingId], references: [id], onDelete: Cascade)

  @@unique([modelPricingId, tierKey])
  @@index([modelPricingId, isActive])
  @@index([modelPricingId, minInputTokens])
  @@map("model_pricing_tiers")
}

