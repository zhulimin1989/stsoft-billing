  toStatus      InvoiceApplicationStatus  @map("to_status")
  actorType     InvoiceActorType          @map("actor_type")
  actorId       String?                   @map("actor_id")
  reason        String?
  metadata      Json?
  occurredAt    DateTime                  @default(now()) @map("occurred_at")

  application InvoiceApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
  @@map("invoice_event_log")
}

enum InvoiceApplicationStatus {
  PENDING_REVIEW
  APPROVED_ISSUING
  ISSUED
  REJECTED
  CANCELLED
  FAILED
  VOIDED
  RED_OFFSET
}

enum InvoiceProfileKind {
  PERSONAL
  ENTERPRISE
}

enum InvoiceType {
  VAT_NORMAL
  VAT_SPECIAL
  COMMERCIAL_HK
}

enum InvoiceLineDescription {
  RAYTONE_API
  TOKEN_PLAN
}

enum InvoiceActorType {
  USER
  ADMIN
  SYSTEM
}

// ============================
// 企业开通回收（议题二批一）：权威屏障 + 提交后 fanout 作业
// 设计依据：me/payg-multiplier-verify-timeout-v2.md v68 §2.2b（唯一真源）
// ============================

/// verification 级墓碑＝**权威屏障**。void-provisioning 无论账户数是否为 0 都必落一行
/// （账户尚不存在时，账户行级列无处可置 ⇒ 屏障必须挂在比账户更长命的键上）。
/// 单调：批一无任何清除路径（清除属批二 reactivate，与 epoch fence 一起做）。
model EnterpriseProvisioningTombstone {
  verificationId String   @id @map("verification_id")
  reason         String
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("enterprise_provisioning_tombstones")
}

/// 回收提交后的缓存同步 / key 余额投影重算作业（至少一次投递）。
/// 不复用 publisher_sync_jobs：那张表是「入队时定好 method/path/body 的 HTTP 派发」，
/// 而这里需要「执行时按当前状态重算投影」（Required 原语 rebuild at dispatch time）。
model EnterpriseRecoveryFanoutJob {
  id             String    @id @default(uuid())
  verificationId String    @map("verification_id")
  /// KEY_BY_ID / TENANT_CACHE / ACCOUNT（DB CHECK 保证每种 kind 恰有一个资源列非空）
  kind           String
  accountId      String?   @map("account_id")
  tenantId       String?   @map("tenant_id")
  apiKeyId       String?   @map("api_key_id")
  /// PENDING 可领取 / DONE 成功保留（不删除行）/ ALERTED 达上限不可领取，人工复位
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(8) @map("max_attempts")
  nextRunAt      DateTime  @default(now()) @map("next_run_at")
  lockedAt       DateTime? @map("locked_at")
  /// claim 时由应用层生成并与 locked_at 同一条条件更新写入；终态写回必须带它做所有权 CAS
  leaseToken     String?   @map("lease_token")
  lastError      String?   @map("last_error")
  /// verification_id + kind + coalesce(api_key_id, tenant_id, account_id)
  /// 必须含 verification_id 与 kind，否则 DONE 行永久占键、下一次回收无法重新入队
  idempotencyKey String    @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, nextRunAt])
  @@index([verificationId])
  @@map("enterprise_recovery_fanout_jobs")
}

/// 平台暂估敞口（provisional exposure）—— 非流式请求上游已产 token 但未完整投递时，
/// 平台吃掉的成本的**历史毛观测**。
///
/// ⚠️ 它**不是**正式平台损失（不进 gateway_usage_platform_losses），
/// 也**永不代表当前余额或当前未决金额** —— 每行是「某一时刻观测到的一笔敞口」，
/// 永久 append-only、无状态流转、无冲正列。
/// 「现在还欠多少」这类问题不能用本表回答。
model GatewayUsageProvisionalExposure {
  id                     String   @id @default(uuid())
  gatewayBillingEventId  String   @unique(map: "uq_exposure_billing_event") @map("gateway_billing_event_id")
  sourceEvidenceId       String   @map("source_evidence_id")
  /// 本期恒为 1：由 CHECK 与三列复合 FK 共同保证 exposure 只能指向首收证据。
  sourceEvidenceRevision Int      @map("source_evidence_revision")
  exposureKind           String   @map("exposure_kind")
  sourceReason           String   @map("source_reason")
  httpStatus             Int      @map("http_status")
  outputTokens           BigInt   @map("output_tokens")
  /// 本期恒 NULL（UNKNOWN）：实测该族 input 全为 0，判为 UNKNOWN 被编码成 0，
  /// 绝不写 0 冒充「确实为 0」。
  inputTokens            BigInt?  @map("input_tokens")
  /// 照实复制事件值（trim 后空串归 NULL）；不硬编码 estimated。
  tokenSource            String?  @map("token_source")
  amountUsd              Decimal? @map("amount_usd") @db.Decimal(20, 12)
  amountStatus           String   @map("amount_status")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  billingEvent GatewayBillingEvent  @relation(fields: [gatewayBillingEventId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_exposure_billing_event")
  evidence     GatewayUsageEvidence @relation(fields: [sourceEvidenceId, gatewayBillingEventId, sourceEvidenceRevision], references: [id, gatewayBillingEventId, evidenceRevision], onDelete: Restrict, onUpdate: Restrict, map: "fk_exposure_evidence_same_event_rev1")

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "ix_exposure_created_id")
  @@map("gateway_usage_provisional_exposures")
}

model EnterpriseBillDeadline {
  id                String    @id @default(uuid())
  billingAccountId  String     @map("billing_account_id")
  yearMonth         String     @map("year_month")
  termsDays         Int        @map("terms_days")
  defaultDueAt      DateTime   @map("default_due_at")
  frozenAt          DateTime   @map("frozen_at")
  /// 闭月金额定格（ADR-0013）；为空表示仅冻结了账期、尚未写金额快照。
  frozenConsumeCents  BigInt?    @map("frozen_consume_cents")
  frozenVoucherCents  BigInt?    @map("frozen_voucher_cents")
  frozenChargeCents   BigInt?    @map("frozen_charge_cents")
  frozenTokenTotal    BigInt?    @map("frozen_token_total")
  frozenRequestCount  BigInt?    @map("frozen_request_count")
  amountsFrozenAt     DateTime?  @map("amounts_frozen_at")
  pendingAtDeadline Boolean?   @map("pending_at_deadline")
  pendingObservedAt DateTime?  @map("pending_observed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@unique([billingAccountId, yearMonth])
  @@index([billingAccountId])
  @@index([defaultDueAt])
  @@map("enterprise_bill_deadlines")
}

model EnterpriseBillEvent {
  id               String    @id @default(uuid())
  billingAccountId String     @map("billing_account_id")
  yearMonth        String     @map("year_month")
  type             String
  amountCents      BigInt     @default(0) @map("amount_cents")
  dueAt            DateTime?  @map("due_at")
  note             String?
  actorId          String?    @map("actor_id")
  status           String     @default("CONFIRMED")
  createdAt        DateTime   @default(now()) @map("created_at")

  @@index([billingAccountId, yearMonth, createdAt])
  @@map("enterprise_bill_events")
}

/// 企业账单月汇总（账户 × 北京月）。列表到期日与 tab 闭月金额读这张表，不扫流水。
model EnterpriseBillMonthSummary {
  id                 String    @id @default(uuid())
  billingAccountId   String    @map("billing_account_id")
  yearMonth          String    @map("year_month")
  paidCents          BigInt    @map("paid_cents")
  pendingCents       BigInt    @map("pending_cents")
  adjustedCents      BigInt    @map("adjusted_cents")
  issuedVoucherCents BigInt    @map("issued_voucher_cents")
  consumeCents       BigInt    @map("consume_cents")
  voucherCents       BigInt    @map("voucher_cents")
  chargeCents        BigInt    @map("charge_cents")
  accountPayCents    BigInt    @default(0) @map("account_pay_cents")
  creditPayCents     BigInt    @default(0) @map("credit_pay_cents")
  tokenTotal         BigInt    @default(0) @map("token_total")
  requestCount       BigInt    @default(0) @map("request_count")
  effectiveDueAt     DateTime? @map("effective_due_at")
  dueProjected       Boolean   @default(false) @map("due_projected")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, yearMonth])
  @@index([billingAccountId, pendingCents, effectiveDueAt], map: "enterprise_bill_month_summaries_account_pending_due_idx")
  @@index([yearMonth], map: "enterprise_bill_month_summaries_year_month_idx")
  @@map("enterprise_bill_month_summaries")
}

/// 企业授信占用快照。列表/详情只读这行，不在 GET 上 SUM allocations。
model EnterpriseFundingSnapshot {
  billingAccountId         String   @id @map("billing_account_id")
  approvedReceivableUsd    Decimal  @map("approved_receivable_usd") @db.Decimal(20, 12)
  unapprovedDebtUsd        Decimal  @map("unapproved_debt_usd") @db.Decimal(20, 12)
  classificationComplete   Boolean  @map("classification_complete")
  updatedAt                DateTime @updatedAt @map("updated_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@map("enterprise_funding_snapshots")
}

