// ============================
// Phase 4: API Key 与网关
// ============================

model ApiKey {
  id                      String    @id @default(uuid())
  userId                  String    @map("user_id")
  tenantId                String    @map("tenant_id")
  productId               String?   @map("product_id")
  codingPlanEntitlementId String?   @map("coding_plan_entitlement_id")
  name                    String
  prefix                  String
  keyHash                 String    @unique @map("key_hash")
  isActive                Boolean   @default(true) @map("is_active")
  allowedModels           String?   @map("allowed_models") // JSON array, null = all plan models
  budgetUsd               Decimal?  @map("budget_usd") @db.Decimal(20, 12)
  expiresAt               DateTime? @map("expires_at")
  ipWhitelist             String?   @map("ip_whitelist")
  rateLimitRpm            Int?      @map("rate_limit_rpm")
  rateLimitTpm            Int?      @map("rate_limit_tpm")
  concurrencyLimit        Int?      @map("concurrency_limit")
  sseConcurrency          Int?      @map("sse_concurrency")
  maxTokensPerCall        Int?      @map("max_tokens_per_call")
  maxMessages             Int?      @map("max_messages")
  allowTools              Boolean   @default(true) @map("allow_tools")
  allowVision             Boolean   @default(true) @map("allow_vision")
  mirrorStatus            String    @default("PROVISIONING") @map("mirror_status")
  mirrorError             String?   @map("mirror_error")
  managedBy               String?   @map("managed_by")
  provisionSecretEncrypted String?  @map("provision_secret_encrypted")
  provisionSecretExpiresAt DateTime? @map("provision_secret_expires_at")
  rotationPredecessorId   String?   @unique @map("rotation_predecessor_id")
  sourceUpdatedAt         DateTime? @map("source_updated_at")
  mirroredAt              DateTime? @map("mirrored_at")
  activatedAt             DateTime? @map("activated_at")
  lastUsedAt              DateTime? @map("last_used_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  deletedAt               DateTime? @map("deleted_at")

  user                User         @relation(fields: [userId], references: [id])
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product             Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  rotationPredecessor ApiKey?      @relation("ApiKeyRotation", fields: [rotationPredecessorId], references: [id], onDelete: SetNull)
  rotationSuccessor   ApiKey?      @relation("ApiKeyRotation")
  tokenUsage          TokenUsage[]
  gatewayUsageSettlementAnchors GatewayUsageSettlementAnchor[]

  @@index([userId])
  @@index([userId, productId])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([productId])
  @@index([codingPlanEntitlementId])
  @@index([mirrorStatus])
  @@index([managedBy, userId, tenantId, productId])
  @@map("api_keys")
}

