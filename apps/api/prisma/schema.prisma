/// 每个 (planId, currency) 组合一条记录，承载该币种下的月付和年付价格。
/// Plan.monthlyPrice / quarterlyPrice / yearlyPrice 保留为默认 USD fallback，供老逻辑兼容。
model PlanPrice {
  id             String   @id @default(uuid())
  planId         String   @map("plan_id")
  currency       String // ISO 4217 小写: 'usd' | 'sgd' | 'cny' ...
  monthlyPrice   Int      @map("monthly_price") // 最小货币单位（分 / cents），月付价格
  quarterlyPrice Int      @default(0) @map("quarterly_price") // 最小货币单位，季付的月均价
  yearlyPrice    Int      @map("yearly_price") // 最小货币单位（分 / cents），年付的月均价（与 Plan.yearlyPrice 语义一致）
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currency])
  @@index([currency])
  @@map("plan_prices")
}

