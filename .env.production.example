# Production contract for billing-api.
# billing-api owns ruidong_billing and must not run against DATABASE_URL.

NODE_ENV=production
APP_ENV=production
RUIDONG_SERVICE=billing
PORT=3010
BILLING_PORT=3010
BILLING_DATABASE_URL=postgresql://user:password@postgres:5432/ruidong_billing?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Finance overview successful responses are shared across pods for at most 30 seconds.
FINANCE_REPORT_OVERVIEW_CACHE_TTL_SECONDS=30
# Keep Billing computation below Admin's 30-second finance request timeout.
FINANCE_REPORT_OVERVIEW_COMPUTATION_TIMEOUT_MS=25000

JWT_SECRET=replace_with_64_random_chars
COOKIE_SECRET=replace_with_64_random_chars
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Partner OpenAPI public-plane deployment profile. Set the proxy hop count to
# the exact number of trusted edge hops; do not use an open-ended trust policy.
OPENAPI_PORT=3030
# 0 = OpenAPI 直连，不信任客户端 X-Forwarded-*；正整数 = 恰好信任该代理跳数。
OPENAPI_TRUST_PROXY_HOPS=1
OPENAPI_BODY_LIMIT_BYTES=1048576
OPENAPI_REQUEST_TIMEOUT_MS=30000
OPENAPI_KEEP_ALIVE_TIMEOUT_MS=72000
OPENAPI_RATE_LIMIT_MAX=120
OPENAPI_RATE_LIMIT_WINDOW=1 minute
OPENAPI_PRODUCT_RATE_LIMIT_MAX=600
OPENAPI_PRODUCT_RATE_LIMIT_WINDOW_MS=60000
# Keep docs off in production unless they are intentionally exposed.
OPENAPI_DOCS_ENABLED=false
PARTNER_API_PUBLIC_BASE_URL=https://partner-api.example.com

ADMIN_TO_BILLING_TOKEN=replace_with_64_random_chars
ADMIN_TO_BILLING_CONTEXT_SECRET=replace_with_64_random_chars
USER_TO_BILLING_TOKEN=replace_with_64_random_chars
BILLING_TO_USER_TOKEN=replace_with_64_random_chars
BILLING_INTERNAL_API_VERSION=2026-05-16
USER_SERVICE_URL=http://user-api:3000/api/internal/user/admin

SYNC_TOKEN=replace_with_64_random_chars
SYNC_WEBHOOK_SECRET=replace_with_64_random_chars
CODESPHERE_SAAS_BASE_URL=https://saas.example.com
# Keep false while deploying the additive identity migration and V2 binary.
# Set true only after the preflight in docs/saas-provisioning-flow.zh-CN.md.
# Once enabled and new bindings exist, do not roll back to the V1 binary.
PARTNER_IDENTITY_V2_WRITE_ENABLED=false

ENCRYPTION_KEY=replace_with_64_hex_chars
KMS_HMAC_SECRET=
GATEWAY_KMS_HMAC_SECRET=
API_KEY_HASH_SECRET=replace_with_64_hex_chars

BILLING_CREDIT_RECONCILE_ENABLED=true
BILLING_CREDIT_RECONCILE_FIX=false
BILLING_CREDIT_BALANCE_OUTBOX_ENABLED=true
BILLING_CREDIT_BALANCE_OUTBOX_INTERVAL_MS=1000
BILLING_CREDIT_BALANCE_OUTBOX_BATCH_SIZE=100
BILLING_ALLOW_DEFAULT_PAYG_FALLBACK=false
# Must remain false. Enterprise accounts may use only an active account credit line;
# accounts without active credit are prepaid and do not inherit member overdraft policy.
# Verified usage already delivered upstream may still be booked as DEBT_OPEN; this flag
# never erases delivered usage and never grants admission credit.
BILLING_GATEWAY_USAGE_ALLOW_NEGATIVE_BALANCE=false
# REQUIRED: replace with a positive integer derived from measured
# Gateway↔Billing NTP and transport SLO. Production startup rejects this
# non-numeric placeholder, empty, zero and invalid values.
BILLING_GATEWAY_CLOCK_MAX_SKEW_MS=replace_with_measured_positive_integer_ms
ENTERPRISE_CREDIT_OVERDUE_ENABLED=true
# Policy boundary/fanout recovery SLO is <=60s; do not raise in production.
ENTERPRISE_CREDIT_OVERDUE_INTERVAL_MS=60000
# Grace hours between the frozen contract due date and the automatic service
# suspension. Ship as 0 (behaviour identical to before this variable existed),
# then raise per environment once the overdue alert path is verified end to end
# — a grace that nobody is being warned during is just a delayed outage.
# Raising this defers suspension for EVERY account with an existing frozen due
# date at once, and already-SUSPENDED accounts are not auto-restored by it.
ENTERPRISE_CREDIT_OVERDUE_GRACE_HOURS=0
# Collection grace after an operator manually restores credit to ACTIVE.
# Business set 7 days (168h) on 2026-09-02; ship 0 first and configure per
# environment so a rollout never silently changes overdue enforcement.
# Every admin touch of the credit config restarts this window and there is no
# restart limit, so enforcement can be deferred indefinitely — audited only.
ENTERPRISE_CREDIT_OVERDUE_RESTORE_DEFERRAL_HOURS=0
# MAX_REQUESTS must remain a deployment-specific positive circuit breaker for
# active reservations plus validated first-receipt provisional guards.
# MAX_EXPOSURE is optional; zero disables only that amount threshold.
# BALANCE holds still reduce available funds.
BILLING_USAGE_PENDING_MAX_REQUESTS=100
BILLING_USAGE_PENDING_MAX_EXPOSURE_USD=1000
# Platform accounting currency for this deployment. Use cny for domestic deployments.
BILLING_PLATFORM_CURRENCY=usd
BILLING_GATEWAY_SETTLEMENT_PROTOCOL=v1
# REQUIRED: use shadow for the 100% Billing observation phase. Switch the
# entire Billing fleet to enforce only after the rollout preflight succeeds.
BILLING_USAGE_EVIDENCE_CONTRACT_MODE=shadow
# REQUIRED before enforce: comma-separated full 40-hex commit SHAs or
# sha256:<64-hex> digests copied exactly from signed producer_build_sha fields.
BILLING_USAGE_VERIFIED_PRODUCER_BUILDS=
BILLING_USAGE_KAFKA_ENABLED=true
BILLING_USAGE_KAFKA_BROKERS=b-1.msk.internal:9096,b-2.msk.internal:9096
BILLING_USAGE_KAFKA_TOPICS=gateway.usage_events
BILLING_USAGE_KAFKA_GROUP_ID=billing-ledger-v1
BILLING_USAGE_KAFKA_CLIENT_ID=ruidong-billing
BILLING_USAGE_KAFKA_CONCURRENCY=3
BILLING_USAGE_KAFKA_SECURITY_PROTOCOL=SASL_SSL
BILLING_USAGE_KAFKA_SSL=true
BILLING_USAGE_KAFKA_USERNAME=replace_with_msk_scram_username
BILLING_USAGE_KAFKA_PASSWORD=replace_with_msk_scram_password
BILLING_USAGE_KAFKA_SASL_MECHANISM=scram-sha-512
# Kafka transport authentication rollout is independent from the provider
# evidence mode above. Use shadow only while measuring a signed migration;
# every non-off mode still requires at least one real keyed secret.
BILLING_USAGE_KAFKA_HMAC_MODE=required
BILLING_USAGE_KAFKA_HMAC_KEY_ID=usage-prod-a
BILLING_USAGE_KAFKA_HMAC_SECRET=replace_with_64_random_chars
# Optional JSON object of additional kid -> secret entries for rotation or
# multiple Gateway regions. The combined startup keyring is limited to 16.
BILLING_USAGE_KAFKA_HMAC_KEYRING_JSON=
BILLING_USAGE_KAFKA_DLQ_TOPIC=gateway.usage_events.dlq

# Required for Billing restrictions and funding projections. Do not deploy the
# usage consumer until a real Publisher endpoint/token and retry worker are live.
PUBLISHER_ENABLED=true
PUBLISHER_BASE_URL=https://publisher.internal.example.com
PUBLISHER_TOKEN=replace_with_64_random_chars
PUBLISHER_SYNC_WORKER_ENABLED=true
# Positive integer. Expired PROCESSING jobs are reclaimed and stale owners are fenced.
PUBLISHER_SYNC_JOB_LEASE_SECONDS=300
BILLING_RESTRICTION_PROJECTION_WORKER_ENABLED=true
BILLING_RESTRICTION_PROJECTION_WORKER_INTERVAL_MS=15000
BILLING_RESTRICTION_PROJECTION_WORKER_STARTUP_DELAY_MS=2000
BILLING_RESTRICTION_PROJECTION_WORKER_LEASE_MS=300000
BILLING_RESTRICTION_PROJECTION_WORKER_BATCH_SIZE=50
PUBLISHER_KEY_BALANCE_BOOTSTRAP_ON_START=false
PUBLISHER_KEY_BALANCE_BOOTSTRAP_DELAY_MS=2000
PUBLISHER_KEY_BALANCE_BOOTSTRAP_LIMIT=5000

WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_NOTIFY_URL=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=
ALIPAY_KEY_TYPE=
ALIPAY_NOTIFY_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_SUBSCRIPTION_CANCELLATION_WORKER_ENABLED=true
STRIPE_SUBSCRIPTION_CANCELLATION_WORKER_INTERVAL_MS=60000
STRIPE_SUBSCRIPTION_CANCELLATION_WORKER_STARTUP_DELAY_MS=10000
STRIPE_SUBSCRIPTION_CANCELLATION_WORKER_BATCH_SIZE=50

METRICS_USER=prometheus
METRICS_PASSWORD=replace_with_metrics_password
SENTRY_DSN=
SENTRY_RELEASE=
GIT_COMMIT_SHA=
PROVIDER_REFUND_WORKER_ENABLED=true
PROVIDER_REFUND_WORKER_INTERVAL_MS=60000
PROVIDER_REFUND_WORKER_STARTUP_DELAY_MS=10000
PROVIDER_REFUND_WORKER_BATCH_SIZE=50

# PSA / IPSA invoice auto-submit is nprod-only. Keep disabled in production.
# Interface credentials stay env-based and shared; business mapping lives in code.
PSA_INVOICE_ENABLED=false
PSA_TOKEN_URL=
PSA_INVOICE_URL=
PSA_CLIENT_ID=
PSA_CLIENT_SECRET=
PSA_SCOPE=InvoiceAPI
PSA_APPLY_EMP_NO=
PSA_ISOFTSTONE_EMAIL=
