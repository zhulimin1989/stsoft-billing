# === Database ===
DATABASE_URL="postgresql://ruidong:ruidong_dev@localhost:5432/ruidong_console?schema=public"
BILLING_DATABASE_URL="postgresql://ruidong_billing:ruidong_billing_dev@localhost:5433/ruidong_billing?schema=public"

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ruidong_dev

# Finance overview successful responses are shared across pods for at most 30 seconds.
FINANCE_REPORT_OVERVIEW_CACHE_TTL_SECONDS=30
# Keep Billing computation below Admin's 30-second finance request timeout.
FINANCE_REPORT_OVERVIEW_COMPUTATION_TIMEOUT_MS=25000

# === JWT ===
JWT_SECRET=replace_with_64_hex_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# === App ===
APP_PORT=3000
BILLING_PORT=3010
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PAYMENT_CALLBACK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# === Partner OpenAPI public plane ===
OPENAPI_PORT=3030
# Exact number of trusted proxy hops between the OpenAPI process and the edge.
# 0 = OpenAPI 直连，不信任客户端 X-Forwarded-*；正整数 = 恰好信任该代理跳数。
OPENAPI_TRUST_PROXY_HOPS=0
OPENAPI_BODY_LIMIT_BYTES=1048576
OPENAPI_REQUEST_TIMEOUT_MS=30000
OPENAPI_KEEP_ALIVE_TIMEOUT_MS=72000
# Per-IP limiter.
OPENAPI_RATE_LIMIT_MAX=120
OPENAPI_RATE_LIMIT_WINDOW=1 minute
# Per-product-token limiter (Redis-backed, fail-closed).
OPENAPI_PRODUCT_RATE_LIMIT_MAX=600
OPENAPI_PRODUCT_RATE_LIMIT_WINDOW_MS=60000
# Development exposes /docs and /openapi.json regardless. Production requires true.
OPENAPI_DOCS_ENABLED=false
PARTNER_API_PUBLIC_BASE_URL=http://localhost:3030

# === Billing service split ===
BILLING_SERVICE_URL=http://localhost:3010/api/internal/billing/admin
BILLING_PORTAL_SERVICE_URL=http://localhost:3010/api
USER_SERVICE_URL=http://localhost:3000/api/internal/user/admin
ADMIN_TO_BILLING_TOKEN=replace_with_64_hex_chars
ADMIN_TO_BILLING_CONTEXT_SECRET=replace_with_64_hex_chars
USER_TO_BILLING_TOKEN=replace_with_64_hex_chars
BILLING_TO_USER_TOKEN=replace_with_64_hex_chars
BILLING_INTERNAL_API_VERSION=2026-05-16
BILLING_INTERNAL_ACCEPTED_API_VERSIONS=
BILLING_CREDIT_RECONCILE_ENABLED=true
BILLING_CREDIT_RECONCILE_FIX=false
BILLING_CREDIT_BALANCE_OUTBOX_ENABLED=true
BILLING_CREDIT_BALANCE_OUTBOX_INTERVAL_MS=1000
BILLING_CREDIT_BALANCE_OUTBOX_BATCH_SIZE=100
STRIPE_SUBSCRIPTION_CANCELLATION_WORKER_ENABLED=true
STRIPE_SUBSCRIPTION_CANCELLATION_WORKER_INTERVAL_MS=60000
STRIPE_SUBSCRIPTION_CANCELLATION_WORKER_STARTUP_DELAY_MS=10000
STRIPE_SUBSCRIPTION_CANCELLATION_WORKER_BATCH_SIZE=50
BILLING_ALLOW_DEFAULT_PAYG_FALLBACK=false
# Must remain false. Enterprise accounts may use only an active account credit line;
# accounts without active credit are prepaid and do not inherit member overdraft policy.
# Verified usage already delivered upstream may still be booked as DEBT_OPEN; this flag
# never erases delivered usage and never grants admission credit.
BILLING_GATEWAY_USAGE_ALLOW_NEGATIVE_BALANCE=false
# Required for trusted Gateway occurrence-time credit. Set a positive integer
# from the measured Gateway↔Billing NTP/transport SLO before enabling settlement.
# Empty, zero, or invalid values make occurrence-time policy unprovable; the
# event remains retryable and no wallet, TokenUsage or debt mutation is made.
BILLING_GATEWAY_CLOCK_MAX_SKEW_MS=
ENTERPRISE_CREDIT_OVERDUE_ENABLED=true
# Also drives policy boundary/fanout crash recovery; keep at 60000 for <=60s SLO.
ENTERPRISE_CREDIT_OVERDUE_INTERVAL_MS=60000
# Delays only the service-suspension action; it never moves the frozen
# credit_due_at, so the contract due date and the suspension date must be
# communicated separately. 0 (the default) reproduces the pre-grace behaviour
# exactly; negative and non-numeric values also fall back to 0 rather than
# widening into an unbounded grace.
ENTERPRISE_CREDIT_OVERDUE_GRACE_HOURS=0
# Collection grace after an operator manually restores credit to ACTIVE.
# Derived from the immutable credit-event audit (current policy revision), so it
# needs no schema column. 0 (the default) means no deferral, i.e. the strictest
# overdue enforcement; negative and non-numeric values also fall back to 0.
# NOTE: every admin touch of the credit config bumps policy_revision and writes a
# new event, which RESTARTS this window. Business accepted unlimited restarts
# (2026-09-02), so overdue enforcement can be deferred indefinitely in N-hour
# increments; the only guardrail is the actor_id on each audit row.
ENTERPRISE_CREDIT_OVERDUE_RESTORE_DEFERRAL_HOURS=0
# Required positive circuit breaker for active reservations plus validated
# first-receipt provisional guards. Missing/zero/invalid values fail closed
# while pending requests exist. The exposure threshold remains optional; zero
# disables only that amount threshold. BALANCE holds still reduce available funds.
BILLING_USAGE_PENDING_MAX_REQUESTS=100
BILLING_USAGE_PENDING_MAX_EXPOSURE_USD=0
FINANCE_EXPORT_JOB_WORKER_ENABLED=true
FINANCE_EXPORT_JOB_WORKER_INTERVAL_MS=5000
FINANCE_EXPORT_JOB_WORKER_STARTUP_DELAY_MS=5000
FINANCE_EXPORT_JOB_WORKER_BATCH_SIZE=1
FINANCE_EXPORT_JOB_MIN_AGE_MS=3000
FINANCE_EXPORT_JOB_HEARTBEAT_INTERVAL_MS=30000
FINANCE_EXPORT_JOB_CLEANUP_BATCH_SIZE=100
# Production: absolute path on a ReadWriteMany volume mounted at the same path
# in every billing-api pod. Development defaults to <repo>/var/finance-exports.
FINANCE_EXPORT_STORAGE_DIR=
# Platform accounting currency for this deployment. Use cny for domestic deployments.
BILLING_PLATFORM_CURRENCY=usd
BILLING_GATEWAY_SETTLEMENT_PROTOCOL=v1
# Additive UsageEvent evidence contract rollout. Production must explicitly use
# shadow or enforce; start with shadow across the entire Billing fleet.
BILLING_USAGE_EVIDENCE_CONTRACT_MODE=shadow
# Comma-separated values copied exactly from signed producer_build_sha fields.
# Enforce requires at least one full 40-hex commit SHA or sha256:<64-hex> digest.
BILLING_USAGE_VERIFIED_PRODUCER_BUILDS=

# Gateway UsageEvent v2 Kafka ingestion. Keep disabled for local development.
# Production has no HTTP usage fallback; set BILLING_USAGE_KAFKA_ENABLED=true
# and configure brokers/credentials before serving billable gateway traffic.
# Production MSK must use bootstrapBrokerStringVpcConnectivitySaslScram,
# SASL_SSL, SCRAM-SHA-512, TLS, and manual offset commit.
# The app also accepts generic KAFKA_* aliases for deployment-provided values.
BILLING_USAGE_KAFKA_ENABLED=false
BILLING_USAGE_KAFKA_BROKERS=
BILLING_USAGE_KAFKA_TOPICS=gateway.usage_events
BILLING_USAGE_KAFKA_GROUP_ID=billing-ledger-v1
BILLING_USAGE_KAFKA_CLIENT_ID=ruidong-billing
BILLING_USAGE_KAFKA_CONCURRENCY=3
BILLING_USAGE_KAFKA_SECURITY_PROTOCOL=SASL_SSL
BILLING_USAGE_KAFKA_SSL=true
BILLING_USAGE_KAFKA_USERNAME=
BILLING_USAGE_KAFKA_PASSWORD=
BILLING_USAGE_KAFKA_SASL_MECHANISM=scram-sha-512
BILLING_USAGE_KAFKA_CONNECTION_TIMEOUT_MS=10000
BILLING_USAGE_KAFKA_REQUEST_TIMEOUT_MS=30000
BILLING_USAGE_KAFKA_RETRIES=8

# Publisher key-balance bootstrap. Enable after Publisher credentials are
# configured to enqueue gw:key_balance for active keys on billing startup.
# PROCESSING jobs older than this positive-integer lease are reclaimable;
# completion writes are fenced by the exact lease timestamp.
PUBLISHER_SYNC_JOB_LEASE_SECONDS=300
PUBLISHER_KEY_BALANCE_BOOTSTRAP_ON_START=false
PUBLISHER_KEY_BALANCE_BOOTSTRAP_DELAY_MS=2000
PUBLISHER_KEY_BALANCE_BOOTSTRAP_LIMIT=5000

# === WeChat Pay (微信支付) ===
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_NOTIFY_URL=

# === Alipay (支付宝) ===
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY=
# Sandbox: https://openapi-sandbox.dl.alipaydev.com/gateway.do
# Production can be left blank to use the SDK default.
ALIPAY_GATEWAY=
# Set to PKCS8 if your private key starts with "-----BEGIN PRIVATE KEY-----".
ALIPAY_KEY_TYPE=
ALIPAY_NOTIFY_URL=

# === Encryption ===
# ENCRYPTION_KEY decrypts legacy DB Channel API Key ciphertext.
ENCRYPTION_KEY=your-32-byte-hex-key-here
# API_KEY_HASH_SECRET must match gateway auth.hmac_secret / HMAC_SECRET.
API_KEY_HASH_SECRET=replace_with_64_hex_chars
# KMS_HMAC_SECRET must match gateway local KMS_HMAC_SECRET for enc:local:<base64(nonce|ct|tag)>.
# If omitted, local gateway encryption falls back to ENCRYPTION_KEY.
KMS_HMAC_SECRET=
# Channel provider key encryption mode:
# - local: store gateway-local ciphertext as enc:local:<base64(nonce|ct|tag)>
# - kms: call AWS KMS Encrypt and store enc:<base64(CiphertextBlob)>
CHANNEL_SECRET_ENCRYPTION_MODE=local
CHANNEL_KMS_KEY_ID=
CHANNEL_KMS_REGION=
CHANNEL_KMS_ENDPOINT=

# shenhome Sub2API 开发种子 Key — 仅开发环境 seed 用
# 生产环境管理员通过 /admin/channels 界面配置（走加密流程）
# 未设置则 seed 出占位 Channel（isActive=false，不路由）
SHENHOME_CLAUDE_KEY=
SHENHOME_GLM_KEY=
SHENHOME_CODEX_KEY=

# === Email (Mailpit for dev) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# === SaaS 同步 ===
# 共享密钥，用于 Webhook 推送和同步 API 认证
# 必须与 SaaS 后端的 ADMIN_SYNC_TOKEN 一致
# 生成方式：openssl rand -hex 32
SYNC_TOKEN=changeme_shared_sync_secret

# SaaS Agent Core 观测面板读取地址；admin API 会用 SYNC_TOKEN 代理请求
CODESPHERE_SAAS_BASE_URL=https://saas-test.codesphere.run
# Partner identity V2 rollout gate. Non-production defaults to enabled when
# unset. In production, keep false through migration/preflight, then switch to
# true once; after activation the deployment is roll-forward-only.
PARTNER_IDENTITY_V2_WRITE_ENABLED=true

# HMAC-SHA256 密钥，用于签名发往 codesphere-saas 的 webhook 请求
# SaaS 端按相同 secret 校验 X-Webhook-Signature：
#   hex(hmac_sha256(secret, "${X-Webhook-Timestamp}.${raw_body}"))
# 可接受的请求时间戳窗口：±300s
# 未设置时回退到 SYNC_TOKEN（但建议单独设置）
# 生成方式：openssl rand -hex 32
SYNC_WEBHOOK_SECRET=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DB_CONNECTION=Username-Password-Authentication

# === Sentry (错误与性能监控) ===
# 当前为可选字段：未设置则 Sentry 禁用（no-op），不阻塞启动。
# 选定观测方案（Sentry SaaS / GlitchTip / 其他）后再填充，
# 并考虑在 assert-production-secrets.ts 将 required 改回 true。
# DSN 格式：https://<public_key>@<host>/<project_id>
SENTRY_DSN=
# 可选：覆盖自动识别的 release（默认用 GIT_COMMIT_SHA）
SENTRY_RELEASE=
# 通常由 CI 注入，关联 Sentry issue 与 commit
GIT_COMMIT_SHA=

# 前端 Sentry（注入到 Vite build，VITE_ 前缀会暴露给浏览器）
VITE_SENTRY_DSN=
VITE_APP_ENV=development
VITE_GIT_COMMIT_SHA=

# Sentry sourcemap 上传（仅 CI 用）
# admin / web 通常分两个 project，SENTRY_PROJECT 在各自 build job 里覆盖
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# === Prometheus /metrics scrape credentials ===
# 未设置时：开发环境允许匿名访问，production 拒绝全部请求
# prod 必须设置，建议在 Prometheus scrape config 用 basic_auth
METRICS_USER=
METRICS_PASSWORD=
PROVIDER_REFUND_WORKER_ENABLED=true
PROVIDER_REFUND_WORKER_INTERVAL_MS=60000
PROVIDER_REFUND_WORKER_STARTUP_DELAY_MS=10000
PROVIDER_REFUND_WORKER_BATCH_SIZE=50

# === PSA / IPSA 发票自动申请 ===
# 本地默认关闭。nprod 测试环境走 ConfigMap；client_secret 只放 Secret。
# 接口配置（URL / OAuth / timeout）国内外共用。
# 业务字段（项目号 / 票种 / 税编 / 币种 / 注册地）在代码策略里：
#   apps/api/src/invoice/psa-invoice.profile.ts
# 不要使用文档示例 IM1512043911 / 305989。
PSA_INVOICE_ENABLED=false
PSA_TOKEN_URL=
PSA_INVOICE_URL=
PSA_CLIENT_ID=
PSA_CLIENT_SECRET=
PSA_SCOPE=InvoiceAPI
PSA_APPLY_EMP_NO=
PSA_ISOFTSTONE_EMAIL=
PSA_APPLY_REASON=预收款
PSA_APPLY_REASON_DETAIL=SaaS服务费用开票
PSA_DEFAULT_GOODS_CONTENT=技术服务费
PSA_HTTP_TIMEOUT_MS=15000
# 可选覆盖（不填则用代码策略中的 IPS 主数据）：
# PSA_DOMESTIC_TOKEN_PLAN_PRJ_NO=
# PSA_DOMESTIC_SELF_PLAN_PRJ_NO=
# PSA_DOMESTIC_API_PRJ_NO=
# PSA_FOREIGN_TOKEN_PLAN_PRJ_NO=
# PSA_FOREIGN_API_PRJ_NO=
